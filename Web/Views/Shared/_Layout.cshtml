@using Microsoft.AspNetCore.Identity
@using Web.Data
@inject SignInManager<ApplicationUser> SignInManager

<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Challenges Factory</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Playfair+Display:ital,wght@0,400;0,700;1,400&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="~/assets/css/fontawesome-all.min.css" />
    <!-- CSS here -->
    <link rel="stylesheet" href="~/assets/css/bootstrap.min.css">
    <link rel="stylesheet" href="~/assets/css/animate.min.css">
    <link rel="stylesheet" href="~/assets/css/magnific-popup.css">
    <link rel="stylesheet" href="~/assets/css/fontawesome-all.min.css">
    <link rel="stylesheet" href="~/assets/css/flaticon_mycollection.css">
    <link rel="stylesheet" href="~/assets/css/swiper-bundle.min.css">
    <link rel="stylesheet" href="~/assets/css/odometer.css">
    <link rel="stylesheet" href="~/assets/css/default.css">
    <link rel="stylesheet" href="~/assets/css/main.css">
    <link rel="stylesheet" href="~/assets/css/brand-challenges-factory.css" asp-append-version="true">

</head>
<body class="site-bg">

    <header class="site-header">
        <div id="header-sticky" class="td-header__area header-mobile-spacing td-transparent z-index-2">
            <div class="container">
                <div class="d-flex align-items-center justify-content-between flex-wrap gap-3 py-2">
                    <div class="logo flex-shrink-0">
                        <a class="cf-logo" asp-controller="Home" asp-action="Index">
                            <span class="cf-logo-name">CHALLENGES<span class="cf-logo-dash">-</span>FACTORY</span>
                            <span class="cf-logo-tagline">Vous apprenez en faisant</span>
                        </a>
                    </div>
                    <nav class="tdmenu__nav tdmenu__wrap tdmenu-2 tdmenu-4 d-none d-xxl-flex flex-shrink-1">
                        <div class="tdmenu__navbar-wrap tdmenu__main-menu">
                            <ul class="navigation">
                                <li class="active"><a asp-controller="Home" asp-action="Index">Accueil</a></li>
                                <li><a asp-controller="Home" asp-action="Formations">Formations</a></li>
                                <li><a asp-controller="Home" asp-action="Methode">La méthode</a></li>
                                <li><a asp-controller="Home" asp-action="APropos">À propos</a></li>
                                <li><a asp-controller="Home" asp-action="Contact">Contact</a></li>
                            </ul>
                        </div>
                    </nav>
                    <div class="td-menu-right-action td-menu-right-action-2 d-flex align-items-center flex-shrink-0">
                        @* En dessous du palier xxl, ces liens ne restent pas sur la ligne du header (source du
                           chevauchement/retour a la ligne signale, y compris juste sous ce palier ou logo+menu+
                           boutons ne tiennent plus sur une seule ligne) : ils rejoignent le menu mobile offcanvas
                           ci-dessous, ouvert par le meme bouton hamburger - une seule ligne d'entete, toujours. *@
                        @if (!SignInManager.IsSignedIn(User))
                        {
                            <div class="header-auth d-none d-xxl-flex align-items-center gap-2">
                                <a asp-area="Identity" asp-page="/Account/Login" class="cf-btn cf-btn-outline">Se connecter</a>
                                <a asp-area="Identity" asp-page="/Account/Register" class="cf-btn cf-btn-primary">S'inscrire</a>
                            </div>
                        }
                        else
                        {
                            <div class="header-auth d-none d-xxl-flex align-items-center gap-2">
                                <a asp-area="" asp-page="/Dashboard/Index" class="cf-btn cf-btn-outline">Dashboard</a>
                                <form asp-area="Identity" asp-page="/Account/Logout" method="post" class="d-inline-flex align-items-center">
                                    <button type="submit" class="btn btn-outline-danger btn-sm">Logout</button>
                                </form>
                            </div>
                        }
                        <div class="td-header-menu-bar lh-1 p-relative ms-3 d-block d-xxl-none">
                            <button class="tdmenu-offcanvas-open-btn mobile-nav-toggler">
                                <span></span>
                                <span></span>
                                <span></span>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </header>

    <div class="tdmobile__menu-wrapper d-xxl-none">
        <div class="tdmobile__menu-backdrop"></div>
        <div class="tdmobile__menu">
            <div class="tdmobile__menu-box">
                <div class="close-btn mobile-nav-toggler"><i class="fa-solid fa-xmark"></i></div>
                <div class="nav-logo">
                    <a class="cf-logo" asp-controller="Home" asp-action="Index">
                        <span class="cf-logo-name">CHALLENGES<span class="cf-logo-dash">-</span>FACTORY</span>
                    </a>
                </div>
                <div class="tdmobile__menu-outer">
                    <nav class="tdmenu__main-menu">
                        <ul class="navigation">
                            <li class="active"><a asp-controller="Home" asp-action="Index">Accueil</a></li>
                            <li><a asp-controller="Home" asp-action="Formations">Formations</a></li>
                            <li><a asp-controller="Home" asp-action="Methode">La méthode</a></li>
                            <li><a asp-controller="Home" asp-action="APropos">À propos</a></li>
                            <li><a asp-controller="Home" asp-action="Contact">Contact</a></li>
                        </ul>
                    </nav>
                </div>
                <div class="tdmenu__action">
                    @if (!SignInManager.IsSignedIn(User))
                    {
                        <ul class="list-wrap flex-column align-items-stretch gap-2 px-4 pb-4">
                            <li><a asp-area="Identity" asp-page="/Account/Login" class="cf-btn cf-btn-outline w-100 justify-content-center">Se connecter</a></li>
                            <li><a asp-area="Identity" asp-page="/Account/Register" class="cf-btn cf-btn-primary w-100 justify-content-center">S'inscrire</a></li>
                        </ul>
                    }
                    else
                    {
                        <ul class="list-wrap flex-column align-items-stretch gap-2 px-4 pb-4">
                            <li><a asp-area="" asp-page="/Dashboard/Index" class="cf-btn cf-btn-outline w-100 justify-content-center">Dashboard</a></li>
                            <li>
                                <form asp-area="Identity" asp-page="/Account/Logout" method="post">
                                    <button type="submit" class="btn btn-outline-danger w-100">Logout</button>
                                </form>
                            </li>
                        </ul>
                    }
                </div>
            </div>
        </div>
    </div>

    <main>
        @RenderBody()
    </main>

    <!-- footer-area-start -->
    <footer>
        <div class="td-footer-area pt-80" style="background-color: var(--cf-black);">

            <div class="td-footer-4-top pb-20">
                <div class="container">
                    <div class="row">
                        <div class="col-lg-6">
                            <div class="td-footer-logo mb-30">
                                <a class="cf-logo" asp-controller="Home" asp-action="Index">
                                    <span class="cf-logo-name cf-logo-invert">CHALLENGES<span class="cf-logo-dash">-</span>FACTORY</span>
                                </a>
                            </div>
                        </div>
                        <div class="col-lg-6">
                            <div class="td-footer-bottom-social text-right mb-30">
                                <span><a href="#" aria-label="LinkedIn"><i class="fa-brands fa-linkedin"></i></a></span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="td-footer-main pt-65 pb-45">
                <div class="container">
                    <div class="row mb-30">
                        <div class="col-lg-4 col-md-5">
                            <div class="td-footer-widget td-footer-4-widget mb-40">
                                <h3 class="td-footer-title mb-20">Challenges Factory</h3>
                                <p class="text mb-10">Nous transformons le savoir passif en compétence active.</p>
                                <a class="email" href="mailto:contact@challenges-factory.fr">contact@challenges-factory.fr</a>
                            </div>
                        </div>
                        <div class="col-lg-4 col-md-3">
                            <div class="td-footer-widget td-footer-4-widget mb-40">
                                <h3 class="td-footer-title mb-20">Entreprise</h3>
                                <div class="td-footer-links">
                                    <ul>
                                        <li><a asp-controller="Home" asp-action="APropos">À propos</a></li>
                                        <li><a asp-controller="Home" asp-action="Methode">La méthode CBL</a></li>
                                        <li><a href="#">Blog &amp; Ressources</a></li>
                                        <li><a asp-controller="Home" asp-action="Contact">Contact</a></li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-4 col-md-4">
                            <div class="td-footer-widget td-footer-4-widget mb-40">
                                <h3 class="td-footer-title mb-20">Contact</h3>
                                <div class="td-footer-links">
                                    <ul>
                                        <li><a href="/cgu">CGU</a></li>
                                        <li><a href="/confidentialite">Politique de confidentialité</a></li>
                                        <li><a href="https://drive.google.com/file/d/1VeMxMylNISKGGZWuJ_FqUh6wxRHJfGum/view?usp=sharing" target="_blank" rel="noopener">Certification Qualiopi</a></li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="td-footer-bottom-copyright td-footer-4-copyright text-center">
                <p class="mb-0">© @DateTime.Now.Year Challenges Factory</p>
            </div>
        </div>
    </footer>
    <!-- footer-area-end -->

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script>
        // Menu offcanvas mobile : un seul bouton (.mobile-nav-toggler) sert a la fois a
        // ouvrir (hamburger dans le header) et a fermer (croix dans le panneau) puisque
        // toggle() gere les deux cas identiquement.
        document.querySelectorAll('.mobile-nav-toggler').forEach(function (btn) {
            btn.addEventListener('click', function () {
                document.body.classList.toggle('mobile-menu-visible');
            });
        });
        var offcanvasBackdrop = document.querySelector('.tdmobile__menu-backdrop');
        if (offcanvasBackdrop) {
            offcanvasBackdrop.addEventListener('click', function () {
                document.body.classList.remove('mobile-menu-visible');
            });
        }
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
