@using Microsoft.AspNetCore.Identity
@using Web.Data
@inject SignInManager<ApplicationUser> SignInManager

<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Challenges Factory</title>

    @{
        // SEO (Phase 5) : chaque vue publique renseigne ViewData["MetaDescription"] dans son
        // bloc @{ } - description de repli generique si une page l'omet. Domaine de production
        // en dur (jamais dans appsettings, cf. consignes mission - aucune config a toucher) :
        // seul https://challenges-factory.com fait foi pour le canonical et les balises Open
        // Graph, quel que soit l'hote sur lequel la requete arrive reellement (dev, staging...).
        var metaDescription = ViewData["MetaDescription"] as string
            ?? "Challenges Factory réalise votre Bilan Carbone® puis transforme votre plan de transition en défis terrain, au rythme de votre objectif, avec vos équipes.";
        var domainePublic = "https://challenges-factory.com";
        var urlCanonique = domainePublic + Context.Request.Path.Value?.TrimEnd('/');
        if (string.IsNullOrEmpty(Context.Request.Path.Value) || Context.Request.Path.Value == "/")
        {
            urlCanonique = domainePublic + "/";
        }
        var titrePage = $"{ViewData["Title"]} - Challenges Factory";
    }
    <meta name="description" content="@metaDescription" />
    <link rel="canonical" href="@urlCanonique" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Challenges Factory" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:title" content="@titrePage" />
    <meta property="og:description" content="@metaDescription" />
    <meta property="og:url" content="@urlCanonique" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="@titrePage" />
    <meta name="twitter:description" content="@metaDescription" />
    @* Visuel de partage genere a partir des tokens de marque deja en production
       (brand-challenges-factory.css : --cf-orange #e8500a, --cf-black #0f0f0f, police
       Bebas Neue deja chargee ci-dessous) - pas une nouvelle charte inventee, juste la
       reprise du wordmark header/footer existant. A remplacer si un vrai visuel de marque
       (photo, illustration) est fourni un jour. *@
    <meta property="og:image" content="@(domainePublic + Url.Content("~/brand/og-image.png"))" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:image" content="@(domainePublic + Url.Content("~/brand/og-image.png"))" />

    <link rel="icon" type="image/png" sizes="32x32" href="~/brand/favicon-32.png" asp-append-version="true" />
    <link rel="icon" type="image/png" sizes="16x16" href="~/brand/favicon-16.png" asp-append-version="true" />
    <link rel="apple-touch-icon" href="~/brand/apple-touch-icon.png" asp-append-version="true" />

    <link rel="stylesheet" href="~/assets/css/fonts.css" asp-append-version="true">

    <link rel="stylesheet" href="~/assets/css/fontawesome-all.min.css" asp-append-version="true" />
    <!-- CSS here -->
    <link rel="stylesheet" href="~/assets/css/bootstrap.min.css" asp-append-version="true">
    <link rel="stylesheet" href="~/assets/css/vendor-bundle.css" asp-append-version="true">
    <link rel="stylesheet" href="~/assets/css/main.css" asp-append-version="true">
    <link rel="stylesheet" href="~/assets/css/brand-challenges-factory.css" asp-append-version="true">

</head>
<body class="site-bg">

    <header class="site-header">
        <div id="header-sticky" class="td-header__area header-mobile-spacing td-transparent z-index-2">
            <div class="container">
                <div class="d-flex align-items-center justify-content-between flex-wrap gap-3 py-2">
                    <div class="logo flex-shrink-0">
                        <a class="cf-logo" asp-controller="Home" asp-action="Index">
                            <img src="~/brand/mark.png" alt="" class="cf-logo-mark" width="94" height="85" asp-append-version="true">
                            <span class="cf-logo-text">
                                <span class="cf-logo-name">CHALLENGES<span class="cf-logo-dash">-</span>FACTORY</span>
                                <span class="cf-logo-tagline">De la mesure à l'action</span>
                            </span>
                        </a>
                    </div>

                    @* Navigation unifiee desktop + mobile : un seul jeu d'elements DOM (plus de <nav>
                       desktop duplique separement, cf. audit EcoIndex - reduit sensiblement le nombre
                       d'elements de la page). Le panneau glissant mobile existant (.tdmobile__menu,
                       ouvert/ferme par le hamburger .mobile-nav-toggler, JS inchange en bas de page)
                       sert aussi de barre horizontale desktop a partir de 1200px grace aux regles
                       @media (min-width: 1200px) dans brand-challenges-factory.css. Le sous-menu "Nos
                       bilans" reste toujours deplie sur mobile (pas de JS dropdown supplementaire) et
                       redevient un menu au survol sur desktop. Le palier xl (1200px) reste calibre pour
                       7 items, avec repli sur 2 lignes (logo puis nav+boutons) entre 1200 et 1399px
                       plutot qu'une seule ligne stricte - cf. commentaire de --cf-header-clearance dans
                       brand-challenges-factory.css. *@
                    <div class="tdmobile__menu">
                        <div class="tdmobile__menu-box">
                            <div class="close-btn mobile-nav-toggler"><i class="fa-solid fa-xmark"></i></div>
                            <div class="nav-logo">
                                <a class="cf-logo" asp-controller="Home" asp-action="Index">
                                    <img src="~/brand/mark.png" alt="" class="cf-logo-mark" width="94" height="85" asp-append-version="true">
                                    <span class="cf-logo-text">
                                        <span class="cf-logo-name">CHALLENGES<span class="cf-logo-dash">-</span>FACTORY</span>
                                    </span>
                                </a>
                            </div>
                            <div class="tdmobile__menu-outer">
                                <ul class="navigation">
                                    <li class="active"><a asp-controller="Home" asp-action="Index">Accueil</a></li>
                                    <li class="menu-item-has-children">
                                        <a href="#">Nos bilans</a>
                                        <ul class="sub-menu">
                                            <li><a asp-controller="Home" asp-action="BilanCarbone">Bilan Carbone</a></li>
                                            <li><a asp-controller="PreDiagnosticCarbone" asp-action="Index">Pré-diagnostic carbone (gratuit)</a></li>
                                            <li><a asp-controller="Home" asp-action="BilanDeCompetences">Se reconvertir</a></li>
                                        </ul>
                                    </li>
                                    <li><a asp-controller="Home" asp-action="Formations">Nos parcours</a></li>
                                    <li><a asp-controller="Home" asp-action="Methode">La méthode</a></li>
                                    <li><a asp-controller="Home" asp-action="APropos">À propos</a></li>
                                    <li><a asp-controller="Home" asp-action="LeLab">Le Lab</a></li>
                                    <li><a asp-controller="Home" asp-action="Contact">Contact</a></li>
                                </ul>
                            </div>
                            <div class="tdmenu__action">
                                @if (!SignInManager.IsSignedIn(User))
                                {
                                    <ul class="tdmenu__action-list">
                                        <li><a class="cf-btn cf-btn-primary cf-btn-wrap" href="https://calendar.google.com/calendar/u/0/appointments/schedules/AcZssZ1u9jEGikHh9zntfc83AKshY3SRBsLas_LlZm9v1x2LypnjeaP73YWl4_EDdPWFdEG2aato2wvo" target="_blank" rel="noopener">📅 Pré-diagnostic<span class="d-xl-none"> carbone</span></a></li>
                                        <li><a asp-area="Identity" asp-page="/Account/Login" class="cf-btn cf-btn-outline cf-header-login-link">Se connecter</a></li>
                                        <li class="d-xl-none"><a asp-area="Identity" asp-page="/Account/Register" class="cf-btn cf-btn-outline">S'inscrire</a></li>
                                    </ul>
                                }
                                else
                                {
                                    <ul class="tdmenu__action-list">
                                        <li><a asp-area="" asp-page="/Dashboard/Index" class="cf-btn cf-btn-outline">Dashboard</a></li>
                                        <li>
                                            <form asp-area="Identity" asp-page="/Account/Logout" method="post">
                                                <button type="submit" class="btn btn-outline-danger btn-sm">Logout</button>
                                            </form>
                                        </li>
                                    </ul>
                                }
                            </div>
                        </div>
                    </div>

                    <div class="td-header-menu-bar lh-1 p-relative ms-3 d-block d-xl-none">
                        <button class="tdmenu-offcanvas-open-btn mobile-nav-toggler">
                            <span></span>
                            <span></span>
                            <span></span>
                        </button>
                    </div>
                </div>
            </div>
            <div class="tdmobile__menu-backdrop"></div>
        </div>
    </header>

    <main>
        @RenderBody()
    </main>

    <!-- footer-area-start -->
    <footer>
        <div class="td-footer-area pt-80" style="background-color: var(--cf-black);">

            @* Lignes de pied de page en flex/grid plutot qu'en row/col Bootstrap : evite une
               div .col-* par bloc (compte dans le DOM de CHAQUE page du site, cf. audit
               EcoIndex), sans changer le rendu (classes .cf-footer-row-* dans
               brand-challenges-factory.css, memes paliers que col-lg-6 et col-lg-4/col-md-5
               /col-md-3/col-md-4). *@
            <div class="td-footer-4-top pb-20">
                <div class="container">
                    <div class="cf-footer-row cf-footer-row-top">
                        @* .td-footer-logo (classe du theme herite) retiree : aucune regle CSS ne la
                           cible (verifie dans main.css), c'etait une div sans aucun effet visuel. *@
                        <a class="cf-logo mb-30" asp-controller="Home" asp-action="Index">
                            <img src="~/brand/mark-dark.png" alt="" class="cf-logo-mark" width="94" height="85" asp-append-version="true">
                            <span class="cf-logo-text">
                                <span class="cf-logo-name cf-logo-invert">CHALLENGES<span class="cf-logo-dash">-</span>FACTORY</span>
                            </span>
                        </a>
                        <div class="td-footer-bottom-social text-right mb-30">
                            <span><a href="#" aria-label="LinkedIn"><i class="fa-brands fa-linkedin"></i></a></span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="td-footer-main pt-65 pb-45">
                <div class="container">
                    <div class="cf-footer-row cf-footer-row-main mb-30">
                        <div class="td-footer-widget td-footer-4-widget mb-40">
                            <h3 class="td-footer-title mb-20">Challenges Factory</h3>
                            <p class="text mb-10">Nous transformons le savoir passif en compétence active.</p>
                            <a class="email" href="mailto:contact@challenges-factory.fr">contact@challenges-factory.fr</a>
                        </div>
                        <div class="td-footer-widget td-footer-4-widget mb-40">
                            <h3 class="td-footer-title mb-20">Entreprise</h3>
                            <ul class="cf-footer-list">
                                <li><a asp-controller="Home" asp-action="APropos">À propos</a></li>
                                <li><a asp-controller="Home" asp-action="Methode">La méthode CBL</a></li>
                                <li><a asp-controller="Home" asp-action="BilanCarboneEureEtLoir">Bilan Carbone en Eure-et-Loir</a></li>
                                <li><a asp-controller="Home" asp-action="LeLab">Le Lab</a></li>
                                <li><a asp-controller="Home" asp-action="Contact">Contact</a></li>
                            </ul>
                        </div>
                        <div class="td-footer-widget td-footer-4-widget mb-40">
                            <h3 class="td-footer-title mb-20">Contact</h3>
                            <ul class="cf-footer-list">
                                <li><a href="/cgu">CGU</a></li>
                                <li><a href="/confidentialite">Politique de confidentialité</a></li>
                                <li><a asp-controller="Home" asp-action="Accessibilite">Accessibilité & référent handicap</a></li>
                                <li><a asp-controller="Home" asp-action="Reclamation">Déposer une réclamation</a></li>
                                <li><a href="https://drive.google.com/file/d/1VeMxMylNISKGGZWuJ_FqUh6wxRHJfGum/view?usp=sharing" target="_blank" rel="noopener">Certification Qualiopi</a></li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
            <div class="td-footer-bottom-copyright td-footer-4-copyright text-center">
                <p class="mb-0">© @DateTime.Now.Year Challenges Factory</p>
                <a class="d-inline-block mt-2" href="https://bff.ecoindex.fr/redirect/?url=https://cf.modulo-training.fr/" target="_blank" rel="noopener" title="Résultat EcoIndex de cette page">
                    <img src="https://bff.ecoindex.fr/badge/?theme=light&url=https://cf.modulo-training.fr/" alt="Badge EcoIndex de cf.modulo-training.fr" width="108" height="32" loading="lazy">
                </a>
            </div>
        </div>
    </footer>
    <!-- footer-area-end -->

    <script src="~/lib/jquery/dist/jquery.min.js" asp-append-version="true"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script>
        // Menu offcanvas mobile : un seul bouton (.mobile-nav-toggler) sert a la fois a
        // ouvrir (hamburger dans le header) et a fermer (croix dans le panneau) puisque
        // toggle() gere les deux cas identiquement.
        document.querySelectorAll('.mobile-nav-toggler').forEach(function (btn) {
            btn.addEventListener('click', function () {
                document.body.classList.toggle('mobile-menu-visible');
            });
        });
        var offcanvasBackdrop = document.querySelector('.tdmobile__menu-backdrop');
        if (offcanvasBackdrop) {
            offcanvasBackdrop.addEventListener('click', function () {
                document.body.classList.remove('mobile-menu-visible');
            });
        }
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
