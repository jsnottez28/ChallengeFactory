@using Microsoft.AspNetCore.Identity
@using Web.Data
@inject SignInManager<ApplicationUser> SignInManager

<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Challenge Factory</title>

    <link rel="stylesheet" href="~/assets/css/fontawesome-all.min.css" />
    <!-- CSS here -->
    <link rel="stylesheet" href="~/assets/css/bootstrap.min.css">
    <link rel="stylesheet" href="~/assets/css/animate.min.css">
    <link rel="stylesheet" href="~/assets/css/magnific-popup.css">
    <link rel="stylesheet" href="~/assets/css/fontawesome-all.min.css">
    <link rel="stylesheet" href="~/assets/css/flaticon_mycollection.css">
    <link rel="stylesheet" href="~/assets/css/swiper-bundle.min.css">
    <link rel="stylesheet" href="~/assets/css/odometer.css">
    <link rel="stylesheet" href="~/assets/css/default.css">
    <link rel="stylesheet" href="~/assets/css/main.css">

</head>
<body class="site-bg">

    <header class="site-header">
        <div id="header-sticky" class="td-header__area header-mobile-spacing td-transparent z-index-2">
            <div class="container">
                <div class="row align-items-center">
                    <div class="col-xl-9 col-6">
                        <div class="tdmenu__wrap d-flex align-items-center justify-content-between">
                            <div class="logo">
                                <a class="logo-1" asp-controller="Home" asp-action="Index">
                                    <img src="~/logos/logo-header.svg" alt="Challenge Factory">
                                </a>
                            </div>
                            <nav class="tdmenu__nav tdmenu-2 tdmenu-4 mr-90 d-none d-xl-flex">
                                <div class="tdmenu__navbar-wrap tdmenu__main-menu">
                                    <ul class="navigation">
                                        <li class="active menu-item-has-children">
                                            <a asp-controller="Home" asp-action="Index">Accueil</a>
                                            <ul class="sub-menu">
                                                <li><a href="#">Qui sommes nous ?</a></li>
                                                <li><a href="#">La plateforme</a></li>
                                                <li><a href="#">Les formateurs</a></li>
                                                <li><a href="#">Catalogue de formations</a></li>
                                                <li><a href="#">Parcours certifiants</a></li>
                                                <li><a href="#">Ateliers pratiques</a></li>
                                            </ul>
                                        </li>
                                        <li class="menu-item-has-children"><a asp-controller="Home" asp-action="Index">Formateurs</a>
                                            <ul class="sub-menu">
                                                <li><a href="#">Nos formateurs</a></li>
                                            </ul>
                                        </li>
                                        <li class="menu-item-has-children"><a asp-controller="Home" asp-action="Index">Pages</a>
                                            <ul class="sub-menu">
                                                <li><a href="#">Faq</a></li>
                                                <li><a href="#">Tarifs et services</a></li>
                                                <li><a href="#">Rejoindre la plateforme</a></li>
                                                <li><a href="#">Contact</a></li>
                                            </ul>
                                        </li>
                                    </ul>
                                </div>
                            </nav>
                        </div>
                    </div>
                    <div class="col-xl-3 col-6">
                        <div class="td-menu-right-action td-menu-right-action-2 d-flex align-items-center justify-content-end">
                           
                            
                            @if (!SignInManager.IsSignedIn(User))
                            {
                                <div class="header-auth d-flex align-items-center ml-25">
                                    <a asp-area="Identity" asp-page="/Account/Login" class="btn btn-outline-primary btn-sm me-2">Se connecter</a>
                                    <a asp-area="Identity" asp-page="/Account/Register" class="btn btn-primary btn-sm">S'inscrire</a>
                                </div>
                            }
                            else
                            {
                                <div class="header-auth d-flex align-items-center ml-25">
                                    <a asp-area="" asp-page="/Dashboard/Index" class="btn btn-outline-primary btn-sm me-2">Dashboard</a>
                                    <form asp-area="Identity" asp-page="/Account/Logout" method="post" class="d-inline-flex align-items-center">
                                        <button type="submit" class="btn btn-outline-danger btn-sm">Logout</button>
                                    </form>
                                </div>
                            }
                            <div class="td-header-menu-bar lh-1 p-relative ml-25 d-block d-xl-none">
                                <button class="tdmenu-offcanvas-open-btn mobile-nav-toggler">
                                    <span></span>
                                    <span></span>
                                    <span></span>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </header>

    <main>
        @RenderBody()
    </main>

    <!-- footer-area-start -->
    <footer>
        <div class="td-footer-area bg-position pt-80" style="background-image: url('/assets/img/footer/bg.jpg');">

            <div class="td-footer-4-top pb-20">
                <div class="container">
                    <div class="row">
                        <div class="col-lg-6">
                            <div class="td-footer-logo mb-30">
                                <a asp-controller="Home" asp-action="Index">
                                    <img src="~/logos/logo-header.svg" alt="Challenge Factory"></a>
                            </div>
                        </div>
                        <div class="col-lg-6">
                            <div class="td-footer-bottom-social text-right mb-30">
                                <span><a href="#"><i class="fa-brands fa-linkedin"></i></a></span>
                                <span><a href="#"><i class="fa-brands fa-instagram"></i></a></span>
                                <span><a href="#"><i class="fa-brands fa-whatsapp"></i></a></span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="td-footer-main pt-65 pb-45">
                <div class="container">
                    <div class="row mb-30">
                        <div class="col-lg-3 col-md-5">
                            <div class="td-footer-widget td-footer-4-widget mb-40">
                                <h3 class="td-footer-title mb-20">Contact</h3>
                                <p class="text mb-10">Challenge Factory <br>Plateforme d'apprentissage en ligne</p>
                                <a class="number mb-10 d-inline-block" href="tel:+123(55)90067990">+33  01 40 62 16 40 </a>
                                <a class="email" href="mailto:contact@challenge-factory.fr">contact@challenge-factory.fr</a>
                            </div>
                        </div>
                        <div class="col-lg-5 col-md-7">
                            <div class="td-footer-widget td-footer-4-widget space ml-90 mb-40">
                                <h3 class="td-footer-title mb-20">Liens rapides </h3>
                                <div class="row">
                                    <div class="col-lg-6 col-md-6 col-sm-6">
                                        <div class="td-footer-links">
                                            <ul>
                                                <li><a href="#">La plateforme</a></li>
                                                <li><a href="#">Nous rejoindre</a></li>
                                                <li><a href="#">Formateurs</a></li>
                                                <li><a href="#">Catalogue</a></li>
                                                <li><a href="#">Partenaires</a></li>
                                            </ul>
                                        </div>
                                    </div>
                                    <div class="col-lg-6 col-md-6 col-sm-6">
                                        <div class="td-footer-links">
                                            <ul>
                                                <li><a href="#">Actualités</a></li>
                                                <li><a href="#">Nos formations</a></li>
                                                <li><a href="#">Contactez nous</a></li>
                                                <li><a href="/cgu">Conditions générales d'utilisation</a></li>
                                                <li><a href="/confidentialite">Politique de protection des données</a></li>
                                            </ul>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        
                    </div>
                </div>
            </div>
            <div class="td-footer-bottom-copyright td-footer-4-copyright text-center">
                <p class="mb-0">© @DateTime.Now.Year Challenge Factory</p>
            </div>
        </div>
    </footer>
    <!-- footer-area-end -->

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
