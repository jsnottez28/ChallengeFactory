@model Application.Common.Interfaces.ImportRapport
@{
    ViewData["Title"] = "Résultat de l'import";
}

<section class="backend-page">
    <div class="container-fluid">
        <nav aria-label="breadcrumb" class="mb-3">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a asp-page="/Dashboard/Index">Accueil</a></li>
                <li class="breadcrumb-item"><a asp-page="/Admin/Index">Administration</a></li>
                <li class="breadcrumb-item"><a asp-controller="Cartes" asp-action="Index">Cartes de Compétences</a></li>
                <li class="breadcrumb-item active" aria-current="page">Résultat de l'import</li>
            </ol>
        </nav>

        <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
            <div>
                <p class="text-muted mb-1">Administration</p>
                <h1 class="h3 mb-0">Résultat de l'import</h1>
            </div>
            <a asp-controller="Cartes" asp-action="Index" class="btn btn-primary">Voir les cartes</a>
        </div>

        <div class="row g-3 mb-4">
            <div class="col-6 col-md-3">
                <div class="card border-0 shadow-sm text-center p-3">
                    <div class="display-6 fw-bold">@Model.BadgesCrees</div>
                    <div class="text-muted small">Badges créés</div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="card border-0 shadow-sm text-center p-3">
                    <div class="display-6 fw-bold">@Model.BadgesMisAJour</div>
                    <div class="text-muted small">Badges mis à jour</div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="card border-0 shadow-sm text-center p-3">
                    <div class="display-6 fw-bold">@Model.CartesCreees</div>
                    <div class="text-muted small">Cartes créées</div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="card border-0 shadow-sm text-center p-3">
                    <div class="display-6 fw-bold">@Model.CartesMisesAJour</div>
                    <div class="text-muted small">Cartes mises à jour</div>
                </div>
            </div>
        </div>

        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white border-bottom p-4">
                <h2 class="h5 mb-0">Erreurs (@Model.Erreurs.Count)</h2>
            </div>
            <div class="card-body p-4">
                @if (Model.Erreurs.Count == 0)
                {
                    <p class="text-success mb-0">Aucune erreur détectée.</p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table align-middle mb-0">
                            <thead>
                                <tr>
                                    <th scope="col">Feuille</th>
                                    <th scope="col">Ligne</th>
                                    <th scope="col">Champ</th>
                                    <th scope="col">Raison</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var erreur in Model.Erreurs)
                                {
                                    <tr>
                                        <td>@erreur.Feuille</td>
                                        <td>@erreur.Ligne</td>
                                        <td class="text-muted">@(erreur.Champ ?? "-")</td>
                                        <td>@erreur.Raison</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</section>
