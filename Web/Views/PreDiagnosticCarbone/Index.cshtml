@using Application.Common.Interfaces
@using Domain.Entities
@model Web.Controllers.PreDiagnosticCarboneController.PreDiagnosticCarboneFormModel
@{
    ViewData["Title"] = "Pré-diagnostic carbone";
    ViewData["MetaDescription"] = "Estimez rapidement les émissions de votre entreprise en approche monétaire (ratios ADEME Base Carbone), gratuitement et en quelques minutes.";
    var facteurs = (ViewData["Facteurs"] as List<FacteurEmissionInfo>) ?? [];
    var parPoste = facteurs.GroupBy(f => f.Poste).ToDictionary(g => g.Key, g => g.ToList());

    string LibellePoste(PosteEmission poste) => poste switch
    {
        PosteEmission.AchatsBiensEtServices => "Vos achats de biens et services",
        PosteEmission.Immobilisations => "Vos immobilisations",
        PosteEmission.Energie => "Votre énergie",
        PosteEmission.Deplacements => "Vos déplacements",
        _ => poste.ToString(),
    };

    string DescriptionPoste(PosteEmission poste) => poste switch
    {
        PosteEmission.AchatsBiensEtServices => "Montant annuel dépensé (€), par grande catégorie. Laissez à 0 ce qui ne s'applique pas.",
        PosteEmission.Immobilisations => "Montant annuel investi/acquis (€), par type de bien.",
        PosteEmission.Energie => "Consommation annuelle en kWh (relevé de facture).",
        PosteEmission.Deplacements => "Kilomètres parcourus par an, tous salariés confondus.",
        _ => "",
    };
}

<section class="cf-hero-home" style="padding:90px 0 50px;">
    <div class="container">
        <span class="cf-badge">Estimation gratuite</span>
        <h1 class="cf-h1 mb-3" style="font-size:clamp(34px,4.5vw,52px);">Votre <span class="cf-accent">pré-diagnostic carbone</span></h1>
        <p class="cf-lead" style="max-width:660px;">
            Une première estimation de vos émissions en quelques minutes, à partir de vos
            données comptables (approche monétaire, ratios ADEME Base Carbone). Recevez le
            résultat détaillé par email.
        </p>
    </div>
</section>

<section class="cf-section pt-0">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-9">

                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger" role="alert">
                        <div asp-validation-summary="All"></div>
                    </div>
                }

                <form asp-controller="PreDiagnosticCarbone" asp-action="Index" method="post">
                    @foreach (var poste in parPoste.Keys)
                    {
                        <div class="cf-card mb-4">
                            <h3 class="cf-h3 mb-1">@LibellePoste(poste)</h3>
                            <p class="text-muted small mb-3">@DescriptionPoste(poste)</p>
                            <div class="row g-3">
                                @foreach (var facteur in parPoste[poste])
                                {
                                    <div class="col-md-6">
                                        <label class="form-label">@facteur.Nom</label>
                                        <div class="input-group">
                                            <input type="number" step="0.01" min="0" class="form-control"
                                                   name="Valeurs[@facteur.Code]"
                                                   value="@(Model.Valeurs.TryGetValue(facteur.Code, out var v) ? v : (decimal?)null)"
                                                   placeholder="0">
                                            <span class="input-group-text">@(facteur.TypeDonnee == TypeDonneeActivite.Monetaire ? "€" : facteur.Unite)</span>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }

                    <div class="cf-card mb-4">
                        <h3 class="cf-h3 mb-1">Vos coordonnées</h3>
                        <p class="text-muted small mb-3">Pour vous envoyer le résultat détaillé.</p>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="Email" class="form-label"></label>
                                <input asp-for="Email" class="form-control" />
                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Societe" class="form-label"></label>
                                <input asp-for="Societe" class="form-control" />
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Prenom" class="form-label"></label>
                                <input asp-for="Prenom" class="form-control" />
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Nom" class="form-label"></label>
                                <input asp-for="Nom" class="form-control" />
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Telephone" class="form-label"></label>
                                <input asp-for="Telephone" class="form-control" />
                            </div>
                            <div class="col-md-6">
                                <label asp-for="SecteurActivite" class="form-label"></label>
                                <input asp-for="SecteurActivite" class="form-control" />
                            </div>
                            <div class="col-md-6">
                                <label asp-for="EffectifEtp" class="form-label"></label>
                                <input asp-for="EffectifEtp" class="form-control" type="number" min="0" />
                            </div>
                            <div class="col-md-6">
                                <label asp-for="ChiffreAffairesKEuros" class="form-label"></label>
                                <input asp-for="ChiffreAffairesKEuros" class="form-control" type="number" step="0.01" min="0" />
                            </div>
                        </div>

                        <div class="form-check mt-4">
                            <input asp-for="ConsentementRgpd" class="form-check-input" />
                            <label asp-for="ConsentementRgpd" class="form-check-label small">
                                J'accepte que Challenges Factory conserve mes coordonnées et me recontacte au sujet de ce pré-diagnostic.
                            </label>
                            <div><span asp-validation-for="ConsentementRgpd" class="text-danger small"></span></div>
                        </div>
                    </div>

                    <button type="submit" class="cf-btn cf-btn-primary">Calculer mon estimation</button>
                </form>

                <p class="text-muted small mt-4">
                    Estimation en approche monétaire (ratios ADEME Base Carbone, données publiques), à titre
                    indicatif. Elle ne remplace pas un Bilan Carbone® complet réalisé par un praticien certifié.
                </p>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
