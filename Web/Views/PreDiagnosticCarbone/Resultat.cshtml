@using Domain.Entities
@model Application.Common.Interfaces.PreBilanResultatInfo
@{
    ViewData["Title"] = "Votre pré-diagnostic carbone";
    var totalTonnes = Model.TotalEmissionsKgCO2e / 1000m;

    string LibellePoste(PosteEmission poste) => poste switch
    {
        PosteEmission.AchatsBiensEtServices => "Achats de biens et services",
        PosteEmission.Immobilisations => "Immobilisations",
        PosteEmission.Energie => "Énergie",
        PosteEmission.Deplacements => "Déplacements",
        _ => poste.ToString(),
    };
}

<section class="cf-hero-home" style="padding:90px 0 50px;">
    <div class="container">
        <span class="cf-badge">Résultat</span>
        <h1 class="cf-h1 mb-3" style="font-size:clamp(34px,4.5vw,52px);">Votre estimation carbone</h1>
        <p class="cf-lead" style="max-width:620px;">
            Le détail vient également de vous être envoyé par email.
        </p>
    </div>
</section>

<section class="cf-section pt-0">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="cf-card mb-4 text-center">
                    <p class="text-muted small mb-1">Estimation annuelle</p>
                    <div style="font-size:48px; font-weight:700; color:var(--cf-orange);">@totalTonnes.ToString("N1") <span style="font-size:22px;">t CO2e / an</span></div>
                </div>

                <div class="cf-card mb-4">
                    <h3 class="cf-h3 mb-3">Répartition par poste</h3>
                    <ul class="list-unstyled mb-0">
                        @foreach (var poste in Model.ParPoste)
                        {
                            <li class="d-flex justify-content-between border-bottom py-2">
                                <span>@LibellePoste(poste.Poste)</span>
                                <strong>@((poste.EmissionsTotalesKgCO2e / 1000m).ToString("N1")) t CO2e</strong>
                            </li>
                        }
                    </ul>
                </div>

                <div class="cf-card mb-4">
                    <h3 class="cf-h3 mb-3">Principaux postes contributeurs</h3>
                    <ul class="list-unstyled mb-0">
                        @foreach (var ligne in Model.Lignes.Take(8))
                        {
                            <li class="d-flex justify-content-between border-bottom py-2">
                                <span>@ligne.Nom</span>
                                <span class="text-muted">@((ligne.EmissionsKgCO2e / 1000m).ToString("N2")) t CO2e</span>
                            </li>
                        }
                    </ul>
                </div>

                <p class="text-muted small">
                    Estimation en approche monétaire (ratios ADEME Base Carbone, données publiques), à titre
                    indicatif. Elle ne remplace pas un Bilan Carbone® complet réalisé par un praticien certifié.
                </p>

                <div class="text-center mt-4">
                    <a class="cf-btn cf-btn-primary" href="https://calendar.google.com/calendar/u/0/appointments/schedules/AcZssZ1u9jEGikHh9zntfc83AKshY3SRBsLas_LlZm9v1x2LypnjeaP73YWl4_EDdPWFdEG2aato2wvo" target="_blank" rel="noopener">📅 Échanger avec un expert</a>
                    <a class="cf-btn" asp-controller="PreDiagnosticCarbone" asp-action="Index">Refaire une estimation</a>
                </div>
            </div>
        </div>
    </div>
</section>
