@model Application.Common.Interfaces.PreBilanResultatInfo
@using Application.Common.Interfaces
@using Domain.Entities
@using Microsoft.AspNetCore.Authorization
@inject IAuthorizationService AuthorizationService
@{
    ViewData["Title"] = "Pré-diagnostic carbone";
    var infoCrm = ViewData["InfoCrm"] as PreBilanCarboneInfo;
    var dossier = ViewData["Dossier"] as DossierCarboneInfo;
    var checklist = ViewData["Checklist"] as List<ElementCollecteInfo>;
    var peutModifier = (await AuthorizationService.AuthorizeAsync(User, "Droit:PREBILAN.MODIFIER")).Succeeded;

    string LibellePoste(PosteEmission poste) => poste switch
    {
        PosteEmission.AchatsBiensEtServices => "Achats de biens et services",
        PosteEmission.Immobilisations => "Immobilisations",
        PosteEmission.Energie => "Énergie",
        PosteEmission.Deplacements => "Déplacements",
        _ => poste.ToString(),
    };
}

<section class="backend-page">
    <div class="container-fluid">
        <nav aria-label="breadcrumb" class="mb-3">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a asp-page="/Dashboard/Index">Accueil</a></li>
                <li class="breadcrumb-item"><a asp-page="/Admin/Index">Administration</a></li>
                <li class="breadcrumb-item"><a asp-controller="PreDiagnosticsCarbone" asp-action="Index">Pré-diagnostics carbone</a></li>
                <li class="breadcrumb-item active" aria-current="page">#@Model.Id</li>
            </ol>
        </nav>

        @if (TempData["StatusMessage"] is string statusMessage && !string.IsNullOrWhiteSpace(statusMessage))
        {
            <div class="alert alert-info alert-dismissible fade show" role="alert">
                @statusMessage
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fermer"></button>
            </div>
        }

        <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
            <div>
                <p class="text-muted mb-1">Administration — CRM</p>
                <h1 class="h3 mb-0">@($"{infoCrm?.Prenom} {infoCrm?.Nom}".Trim())</h1>
                <p class="text-muted mb-0">
                    Déposé le @Model.DeposeLe.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                    @if (Model.AnneeReference is int annee)
                    {
                        <text>· Exercice de référence : <strong>@annee</strong></text>
                    }
                </p>
            </div>
            <div class="text-lg-end">
                <p class="text-muted small mb-0">Total estimé</p>
                <p class="h4 mb-0">@((Model.TotalEmissionsKgCO2e / 1000m).ToString("N1")) t CO2e / an</p>
            </div>
        </div>

        <div class="row g-4 align-items-start">
            <div class="col-12 col-lg-7">
                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-header bg-white border-bottom p-4">
                        <h2 class="h5 mb-0">Résultat par poste</h2>
                    </div>
                    <div class="card-body p-4">
                        <ul class="list-unstyled mb-0">
                            @foreach (var poste in Model.ParPoste)
                            {
                                <li class="d-flex justify-content-between border-bottom py-2">
                                    <span>@LibellePoste(poste.Poste)</span>
                                    <strong>@((poste.EmissionsTotalesKgCO2e / 1000m).ToString("N1")) t CO2e</strong>
                                </li>
                            }
                        </ul>
                    </div>
                </div>

                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-white border-bottom p-4">
                        <h2 class="h5 mb-0">Détail des lignes saisies</h2>
                    </div>
                    <div class="card-body p-4">
                        <div class="table-responsive">
                            <table class="table table-sm align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th scope="col">Catégorie</th>
                                        <th scope="col" class="text-end">Donnée saisie</th>
                                        <th scope="col" class="text-end">Émissions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var ligne in Model.Lignes)
                                    {
                                        <tr>
                                            <td>@ligne.Nom</td>
                                            <td class="text-end">@ligne.ValeurSaisie.ToString("N0")</td>
                                            <td class="text-end">@((ligne.EmissionsKgCO2e / 1000m).ToString("N2")) t CO2e</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-12 col-lg-5">
                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-header bg-white border-bottom p-4">
                        <h2 class="h5 mb-0">Coordonnées &amp; suivi commercial</h2>
                    </div>
                    <div class="card-body p-4">
                        <p class="mb-1"><strong>Email :</strong> <a href="mailto:@infoCrm?.Email">@infoCrm?.Email</a></p>
                        @if (!string.IsNullOrWhiteSpace(infoCrm?.Telephone)) { <p class="mb-1"><strong>Téléphone :</strong> @infoCrm.Telephone</p> }
                        @if (!string.IsNullOrWhiteSpace(infoCrm?.Societe)) { <p class="mb-1"><strong>Société :</strong> @infoCrm.Societe</p> }
                        @if (!string.IsNullOrWhiteSpace(infoCrm?.SecteurActivite)) { <p class="mb-1"><strong>Secteur :</strong> @infoCrm.SecteurActivite</p> }
                        @if (infoCrm?.EffectifEtp is not null) { <p class="mb-1"><strong>Effectif :</strong> @infoCrm.EffectifEtp ETP</p> }
                        @if (infoCrm?.ChiffreAffairesKEuros is not null) { <p class="mb-0"><strong>CA :</strong> @infoCrm.ChiffreAffairesKEuros.Value.ToString("N0") k€</p> }

                        <droit-visible code="PREBILAN.MODIFIER">
                            <hr />
                            <form method="post" asp-controller="PreDiagnosticsCarbone" asp-action="ChangerStatut" asp-route-id="@Model.Id" class="d-flex gap-2">
                                @Html.AntiForgeryToken()
                                <select name="statut" class="form-select">
                                    @foreach (var statut in Enum.GetValues<StatutPreBilanCrm>())
                                    {
                                        <option value="@statut" selected="@(statut == infoCrm?.StatutCrm)">@statut</option>
                                    }
                                </select>
                                <button type="submit" class="btn btn-primary text-nowrap">Mettre à jour</button>
                            </form>
                        </droit-visible>
                        @if (infoCrm?.StatutCrm is not null)
                        {
                            <p class="text-muted small mt-2 mb-0">Statut actuel : <strong>@infoCrm.StatutCrm</strong></p>
                        }
                    </div>
                </div>

                @* Dossier client Bilan Carbone(R) : compte ClientCarbone distinct des comptes de
                   parcours, puis questionnaire de collecte (cf. ICollecteCarboneService). *@
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-white border-bottom p-4">
                        <h2 class="h5 mb-0">Espace client Bilan Carbone®</h2>
                    </div>
                    <div class="card-body p-4">
                        @if (dossier is null)
                        {
                            <p class="text-muted small">Aucun espace client. L'ouverture crée un compte client (distinct des comptes de parcours) avec l'email du prospect, et lui envoie son identifiant + un lien pour définir son mot de passe.</p>
                            <droit-visible code="PREBILAN.MODIFIER">
                                <form method="post" asp-controller="PreDiagnosticsCarbone" asp-action="OuvrirCompteClient" asp-route-id="@Model.Id">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-primary w-100">Ouvrir le compte client</button>
                                </form>
                            </droit-visible>
                        }
                        else
                        {
                            <p class="mb-1"><strong>Compte :</strong> @dossier.ClientEmail</p>
                            <p class="mb-3"><strong>Ouvert le :</strong> @dossier.OuvertLe.ToLocalTime().ToString("dd/MM/yyyy")</p>

                            <div class="d-flex flex-wrap gap-2 mb-3">
                                @if (dossier.CompteActive)
                                {
                                    <span class="badge bg-success">Mot de passe défini</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark">Activation en attente</span>
                                }
                                @switch (dossier.StatutQuestionnaire)
                                {
                                    case null:
                                        <span class="badge bg-secondary">Questionnaire non envoyé</span>
                                        break;
                                    case StatutQuestionnaireCollecte.Envoye:
                                        <span class="badge bg-info text-dark">Questionnaire envoyé le @dossier.QuestionnaireEnvoyeLe?.ToLocalTime().ToString("dd/MM/yyyy")</span>
                                        break;
                                    case StatutQuestionnaireCollecte.EnCours:
                                        <span class="badge bg-warning text-dark">Questionnaire en cours de saisie</span>
                                        break;
                                    case StatutQuestionnaireCollecte.Soumis:
                                        <span class="badge bg-success">Questionnaire complété le @dossier.QuestionnaireSoumisLe?.ToLocalTime().ToString("dd/MM/yyyy")</span>
                                        break;
                                }
                                @if (dossier.TableurDeposeLe is not null)
                                {
                                    @if (dossier.CollecteDeclareeTerminee == true)
                                    {
                                        <span class="badge bg-success">Collecte déclarée terminée</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark">Collecte en cours</span>
                                    }
                                }
                            </div>

                            <droit-visible code="PREBILAN.MODIFIER">
                                <div class="d-grid gap-2 mb-3">
                                    <form method="post" asp-controller="PreDiagnosticsCarbone" asp-action="EnvoyerQuestionnaire" asp-route-id="@Model.Id">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-primary w-100">
                                            @(dossier.StatutQuestionnaire is null ? "Envoyer le questionnaire" : dossier.StatutQuestionnaire == StatutQuestionnaireCollecte.Soumis ? "Rouvrir et renvoyer le questionnaire" : "Renvoyer le questionnaire")
                                        </button>
                                    </form>
                                    <form method="post" asp-controller="PreDiagnosticsCarbone" asp-action="RenvoyerEmailOuverture" asp-route-id="@Model.Id">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-outline-secondary w-100">
                                            Renvoyer l'email d'ouverture d'espace
                                        </button>
                                    </form>
                                </div>
                            </droit-visible>
                        }

                        <hr />
                        <a class="btn btn-outline-success w-100" asp-controller="PreDiagnosticsCarbone" asp-action="TableurCollecte" asp-route-id="@Model.Id">
                            Télécharger le tableur de collecte (.xlsx)
                        </a>
                        <p class="text-muted small mt-2 mb-0">Pré-rempli avec le pré-diagnostic@(dossier?.StatutQuestionnaire == StatutQuestionnaireCollecte.Soumis ? " et les réponses au questionnaire" : "") ; un onglet par poste concerné.</p>

                        @if (dossier?.TableurDeposeLe is not null)
                        {
                            <hr />
                            <p class="mb-1"><strong>Dépôt du client :</strong> @dossier.TableurDeposeLe.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</p>
                            @if (dossier.TableurDeposeAvancementPourcent is int avancement)
                            {
                                <div class="progress mb-2" style="height: 10px;" role="progressbar" aria-valuenow="@avancement" aria-valuemin="0" aria-valuemax="100">
                                    <div class="progress-bar bg-success" style="width: @(avancement)%;"></div>
                                </div>
                                <p class="text-muted small mb-2">Avancement estimé : <strong>@avancement %</strong> des lignes au statut Reçu/Validé.</p>
                            }
                            <a class="btn btn-outline-primary w-100" asp-controller="PreDiagnosticsCarbone" asp-action="TableurDepose" asp-route-id="@Model.Id">
                                Télécharger le fichier déposé par le client
                            </a>
                        }

                        <droit-visible code="PREBILAN.MODIFIER">
                            @if (dossier is not null)
                            {
                                <hr />
                                <p class="small text-muted mb-2">Vous avez vous-même recueilli des données pour ce client (visite sur site, appel...) ? Déposez votre propre tableur rempli, il sera fusionné avec le reste.</p>
                                <form method="post" asp-controller="PreDiagnosticsCarbone" asp-action="DeposerTableurGestionnaire" asp-route-id="@Model.Id" enctype="multipart/form-data" class="d-flex gap-2">
                                    @Html.AntiForgeryToken()
                                    <input type="file" class="form-control form-control-sm" name="fichier" accept=".xlsx" required>
                                    <button type="submit" class="btn btn-outline-secondary btn-sm text-nowrap">Déposer</button>
                                </form>
                            }
                        </droit-visible>
                    </div>
                </div>

                @if (dossier is not null)
                {
                    <div class="card border-0 shadow-sm mt-4">
                        <div class="card-header bg-white border-bottom p-4">
                            <h2 class="h5 mb-1">Collaborateurs</h2>
                            <p class="text-muted small mb-0">Personnes (en plus du contact principal) ayant accès à ce dossier pour y renseigner des données.</p>
                        </div>
                        <div class="card-body p-4">
                            @if (dossier.Collaborateurs.Count > 0)
                            {
                                <ul class="list-unstyled mb-3">
                                    @foreach (var collaborateur in dossier.Collaborateurs)
                                    {
                                        <li class="d-flex justify-content-between align-items-center border-bottom py-2">
                                            <span>@(collaborateur.Prenom ?? collaborateur.Email) <span class="text-muted small">(@collaborateur.Email)</span></span>
                                            <droit-visible code="PREBILAN.MODIFIER">
                                                <form method="post" asp-controller="PreDiagnosticsCarbone" asp-action="RetirerCollaborateur" asp-route-id="@Model.Id" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="utilisateurId" value="@collaborateur.UtilisateurId" />
                                                    <button type="submit" class="btn btn-sm btn-outline-danger">Retirer</button>
                                                </form>
                                            </droit-visible>
                                        </li>
                                    }
                                </ul>
                            }
                            else
                            {
                                <p class="text-muted small mb-3">Aucun collaborateur pour l'instant.</p>
                            }
                            <droit-visible code="PREBILAN.MODIFIER">
                                <form method="post" asp-controller="PreDiagnosticsCarbone" asp-action="InviterCollaborateur" asp-route-id="@Model.Id" class="d-flex gap-2">
                                    @Html.AntiForgeryToken()
                                    <input type="email" name="email" class="form-control form-control-sm" placeholder="email@collegue-du-client.fr" required />
                                    <button type="submit" class="btn btn-outline-primary btn-sm text-nowrap">Inviter</button>
                                </form>
                            </droit-visible>
                        </div>
                    </div>
                }
            </div>
        </div>

        @if (checklist is not null && checklist.Count > 0)
        {
            var nombreCoches = checklist.Count(e => e.EstCoche);
            var groupes = checklist.GroupBy(e => e.Poste).ToList();
            <div class="card border-0 shadow-sm mt-4">
                <div class="card-header bg-white border-bottom p-4">
                    <h2 class="h5 mb-1">Check-list de collecte (@checklist.Count données)</h2>
                    <p class="text-muted small mb-0">
                        <span class="badge bg-success-subtle text-success-emphasis">✅ @nombreCoches cochée@(nombreCoches > 1 ? "s" : "") par le client</span>
                        sur @checklist.Count — déclaratif, indépendant de l'avancement calculé depuis le fichier déposé ci-dessus.
                        @if (dossier?.LignesSupplementaires.Count > 0)
                        {
                            <span class="badge bg-warning text-dark ms-1">+ @dossier.LignesSupplementaires.Count ligne@(dossier.LignesSupplementaires.Count > 1 ? "s" : "") complémentaire@(dossier.LignesSupplementaires.Count > 1 ? "s" : "") ajoutée@(dossier.LignesSupplementaires.Count > 1 ? "s" : "") par le client — à traiter</span>
                        }
                    </p>
                    @if (dossier?.LignesSupplementaires.Count > 0)
                    {
                        <details class="mt-2">
                            <summary class="small text-warning-emphasis" style="cursor: pointer;">Voir les lignes complémentaires ajoutées par le client</summary>
                            <div class="table-responsive mt-2">
                                <table class="table table-sm small mb-0">
                                    <thead>
                                        <tr>
                                            <th scope="col">Onglet</th>
                                            <th scope="col">Sous-poste</th>
                                            <th scope="col">Donnée</th>
                                            <th scope="col">Valeur</th>
                                            <th scope="col">Source</th>
                                            <th scope="col">Statut</th>
                                            <th scope="col">Commentaire</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var ligne in dossier.LignesSupplementaires)
                                        {
                                            <tr>
                                                <td>@ligne.Onglet</td>
                                                <td>@ligne.SousPoste</td>
                                                <td>@ligne.Donnee</td>
                                                <td>@ligne.Valeur @ligne.Unite</td>
                                                <td>@ligne.Source</td>
                                                <td>@ligne.Statut</td>
                                                <td>@ligne.Commentaire</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </details>
                    }
                </div>
                <div class="card-body p-4">
                    @if (peutModifier)
                    {
                        <p class="small text-muted">Vous pouvez compléter ou corriger les données vous-même ci-dessous (ex. données recueillies par téléphone avec le client) - elles se fusionnent avec ce que le client et ses collaborateurs ont déjà saisi.</p>
                        ViewData["FormAction"] = Url.Action("EnregistrerValeursGestionnaire", "PreDiagnosticsCarbone", new { id = Model.Id });
                        <partial name="_ChecklistCollecteFormulaire" model="checklist" view-data="ViewData" />
                    }
                    else
                    {
                        <div class="accordion accordion-flush" id="accordionChecklist">
                            @for (var i = 0; i < groupes.Count; i++)
                            {
                                var groupe = groupes[i];
                                var idPanneau = $"checklistPoste{i}";
                                var compteRecu = groupe.Count(e => e.ValeurFichier?.Statut is "Reçu" or "Validé");
                                <div class="accordion-item">
                                    <h3 class="accordion-header">
                                        <button class="accordion-button @(i == 0 ? "" : "collapsed")" type="button" data-bs-toggle="collapse" data-bs-target="#@idPanneau">
                                            <span class="flex-grow-1">@Web.Services.QuestionnaireCollecteCatalogue.LibellePoste(groupe.Key)</span>
                                            <span class="badge bg-success-subtle text-success-emphasis me-3">@compteRecu / @groupe.Count()</span>
                                        </button>
                                    </h3>
                                    <div id="@idPanneau" class="accordion-collapse collapse @(i == 0 ? "show" : "")">
                                        <div class="accordion-body p-0">
                                            <div class="table-responsive">
                                                <table class="table table-sm align-middle mb-0">
                                                    <thead>
                                                        <tr>
                                                            <th scope="col">Donnée</th>
                                                            <th scope="col">Pièce justificative</th>
                                                            <th scope="col">Référent</th>
                                                            <th scope="col">Pourquoi</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        @foreach (var element in groupe)
                                                        {
                                                            <tr>
                                                                <td>
                                                                    @element.Donnee
                                                                    @if (element.Valeur.HasValue)
                                                                    {
                                                                        <span class="badge bg-success-subtle text-success-emphasis ms-1">Déjà connu : @element.Valeur.Value.ToString("N2") @element.Unite</span>
                                                                    }
                                                                    @if (element.ValeurFichier is { } vf)
                                                                    {
                                                                        <div class="small text-success-emphasis mt-1">
                                                                            📥 Saisi par @(vf.SaisiePar ?? "le client") le @vf.MiseAJourLe.ToLocalTime().ToString("dd/MM/yyyy")
                                                                            @if (vf.Valeur is not null) { <text> — <strong>@vf.Valeur @vf.Unite</strong></text> }
                                                                            @if (vf.Statut is not null) { <span class="badge bg-success-subtle text-success-emphasis ms-1">@vf.Statut</span> }
                                                                            @if (vf.Source is not null) { <text> · Source : @vf.Source</text> }
                                                                            @if (vf.Hypotheses is not null) { <text> · Hypothèses : @vf.Hypotheses</text> }
                                                                            @if (vf.Commentaire is not null) { <text> · Commentaire : @vf.Commentaire</text> }
                                                                        </div>
                                                                    }
                                                                </td>
                                                                <td class="small">@element.PieceJustificative</td>
                                                                <td class="small">@element.Referent</td>
                                                                <td class="small text-muted">@element.Declencheur</td>
                                                            </tr>
                                                        }
                                                    </tbody>
                                                </table>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        }
    </div>
</section>
