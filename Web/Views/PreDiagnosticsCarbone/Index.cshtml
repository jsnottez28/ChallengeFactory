@model List<Application.Common.Interfaces.PreBilanCarboneInfo>
@using Domain.Entities
@{
    ViewData["Title"] = "Pré-diagnostics carbone";

    string LibelleStatut(StatutPreBilanCrm statut) => statut switch
    {
        StatutPreBilanCrm.Nouveau => "Nouveau",
        StatutPreBilanCrm.Contacte => "Contacté",
        StatutPreBilanCrm.Qualifie => "Qualifié",
        StatutPreBilanCrm.Perdu => "Perdu",
        StatutPreBilanCrm.Gagne => "Gagné",
        _ => statut.ToString(),
    };

    string BadgeStatut(StatutPreBilanCrm statut) => statut switch
    {
        StatutPreBilanCrm.Nouveau => "text-bg-warning",
        StatutPreBilanCrm.Contacte => "text-bg-info",
        StatutPreBilanCrm.Qualifie => "text-bg-primary",
        StatutPreBilanCrm.Perdu => "text-bg-secondary",
        StatutPreBilanCrm.Gagne => "text-bg-success",
        _ => "text-bg-secondary",
    };
}

<section class="backend-page">
    <div class="container-fluid">
        <nav aria-label="breadcrumb" class="mb-3">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a asp-page="/Dashboard/Index">Accueil</a></li>
                <li class="breadcrumb-item"><a asp-page="/Admin/Index">Administration</a></li>
                <li class="breadcrumb-item active" aria-current="page">Pré-diagnostics carbone</li>
            </ol>
        </nav>

        <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
            <div>
                <p class="text-muted mb-1">Administration — CRM</p>
                <h1 class="h3 mb-0">Pré-diagnostics carbone</h1>
                <p class="text-muted mb-0">Prospects ayant déposé une estimation carbone en ligne.</p>
            </div>
        </div>

        <div class="card border-0 shadow-sm">
            <div class="card-body p-4">
                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <thead>
                            <tr>
                                <th scope="col">Déposé le</th>
                                <th scope="col">Contact</th>
                                <th scope="col">Société</th>
                                <th scope="col" class="text-end">Estimation</th>
                                <th scope="col">Statut</th>
                                <th scope="col" class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Count == 0)
                            {
                                <tr>
                                    <td colspan="6" class="text-muted text-center py-4">Aucun pré-diagnostic déposé pour le moment.</td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var preBilan in Model)
                                {
                                    <tr>
                                        <td>@preBilan.DeposeLe.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                                        <td>
                                            @($"{preBilan.Prenom} {preBilan.Nom}".Trim())
                                            <span class="d-block text-muted small">@preBilan.Email</span>
                                        </td>
                                        <td>@preBilan.Societe</td>
                                        <td class="text-end">@((preBilan.TotalEmissionsKgCO2e / 1000m).ToString("N1")) t CO2e</td>
                                        <td><span class="badge @BadgeStatut(preBilan.StatutCrm)">@LibelleStatut(preBilan.StatutCrm)</span></td>
                                        <td class="text-end">
                                            <a asp-controller="PreDiagnosticsCarbone" asp-action="Details" asp-route-id="@preBilan.Id" class="btn btn-sm btn-outline-secondary">Voir</a>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</section>
