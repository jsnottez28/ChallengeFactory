@model List<Domain.Entities.OffreFormation>
@{
    ViewData["Title"] = "Catalogue de formations";

    static string LibelleCategorie(Domain.Entities.CategorieOffreFormation c) => c switch
    {
        Domain.Entities.CategorieOffreFormation.Sensibiliser => "1. Sensibiliser",
        Domain.Entities.CategorieOffreFormation.MonterEnCompetenceCarbone => "2. Monter en compétence carbone",
        Domain.Entities.CategorieOffreFormation.PiloteTrajectoireSnbc => "3. Pilote de trajectoire SNBC 3",
        Domain.Entities.CategorieOffreFormation.ManagerEtEmbarquer => "4. Manager et embarquer",
        Domain.Entities.CategorieOffreFormation.ThematiquesParPosteEmission => "5. Thématiques par poste d'émission",
        Domain.Entities.CategorieOffreFormation.IaEtTransition => "6. IA et transition",
        Domain.Entities.CategorieOffreFormation.InspireesDuGraine => "7. Inspirées du GRAINE",
        Domain.Entities.CategorieOffreFormation.ParticuliersEtReconversion => "8. Particuliers et reconversion",
        _ => c.ToString(),
    };

    var parCategorie = Model.GroupBy(o => o.Categorie).OrderBy(g => (int)g.Key).ToList();
}

<section class="backend-page">
    <div class="container-fluid">
        <nav aria-label="breadcrumb" class="mb-3">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a asp-page="/Dashboard/Index">Accueil</a></li>
                <li class="breadcrumb-item"><a asp-page="/Admin/Index">Administration</a></li>
                <li class="breadcrumb-item active" aria-current="page">Catalogue de formations</li>
            </ol>
        </nav>

        @if (TempData["StatusMessage"] is string statusMessage && !string.IsNullOrWhiteSpace(statusMessage))
        {
            <div class="alert alert-info alert-dismissible fade show" role="alert">
                @statusMessage
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fermer"></button>
            </div>
        }

        <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
            <div>
                <p class="text-muted mb-1">Administration</p>
                <h1 class="h3 mb-0">Catalogue de formations</h1>
                <p class="text-muted small mb-0">Vitrine publique : <a href="/catalogue-formations" target="_blank">/catalogue-formations</a>. Une fois qu'un Challenge réel est construit pour une ligne, reliez-le ici pour que la carte publique bascule automatiquement vers l'inscription.</p>
            </div>
            <droit-visible code="OFFREFORMATION.CREER">
                <a asp-controller="OffresFormation" asp-action="Create" class="btn btn-primary">Ajouter une formation</a>
            </droit-visible>
        </div>

        @foreach (var groupe in parCategorie)
        {
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white border-bottom p-3">
                    <h2 class="h6 mb-0">@LibelleCategorie(groupe.Key)</h2>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table align-middle mb-0">
                            <thead>
                                <tr>
                                    <th scope="col">Titre</th>
                                    <th scope="col">Durée</th>
                                    <th scope="col">Cible</th>
                                    <th scope="col">Statut</th>
                                    <th scope="col">Lien actif</th>
                                    <th scope="col">Publiée</th>
                                    <th scope="col" class="text-end">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var offre in groupe.OrderBy(o => o.Ordre).ThenBy(o => o.Titre))
                                {
                                    <tr>
                                        <td class="fw-semibold">@offre.Titre</td>
                                        <td>@offre.Duree</td>
                                        <td><span class="badge text-bg-light">@offre.Cible</span></td>
                                        <td>
                                            @if (offre.Statut == Domain.Entities.StatutOffreFormation.Disponible)
                                            {
                                                <span class="badge text-bg-success">Disponible</span>
                                            }
                                            else
                                            {
                                                <span class="badge text-bg-secondary">Sur demande</span>
                                            }
                                        </td>
                                        <td>
                                            @if (offre.ChallengeId.HasValue)
                                            {
                                                <span class="badge text-bg-info">Challenge #@offre.ChallengeId</span>
                                            }
                                            else if (!string.IsNullOrWhiteSpace(offre.LienPersonnalise))
                                            {
                                                <span class="badge text-bg-info">@offre.LienPersonnalise</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted small">Formulaire de contact</span>
                                            }
                                        </td>
                                        <td>
                                            @if (offre.EstPublie)
                                            {
                                                <span class="badge text-bg-success">Oui</span>
                                            }
                                            else
                                            {
                                                <span class="badge text-bg-secondary">Non</span>
                                            }
                                        </td>
                                        <td class="text-end">
                                            <droit-visible code="OFFREFORMATION.MODIFIER">
                                                <a asp-controller="OffresFormation" asp-action="Edit" asp-route-id="@offre.Id" class="btn btn-sm btn-outline-secondary">Modifier</a>
                                            </droit-visible>
                                            <droit-visible code="OFFREFORMATION.SUPPRIMER">
                                                <form method="post" asp-controller="OffresFormation" asp-action="Delete" asp-route-id="@offre.Id" class="d-inline" onsubmit="return confirm('Supprimer cette formation du catalogue ?');">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-sm btn-outline-danger">Supprimer</button>
                                                </form>
                                            </droit-visible>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }

        @if (Model.Count == 0)
        {
            <p class="text-muted">Aucune formation dans le catalogue pour le moment.</p>
        }
    </div>
</section>
