@model List<Web.Data.ApplicationRole>
@{
    ViewData["Title"] = "Permissions";
}

<section class="backend-page">
    <div class="container-fluid">
        <nav aria-label="breadcrumb" class="mb-3">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a asp-page="/Dashboard/Index">Accueil</a></li>
                <li class="breadcrumb-item"><a asp-page="/Admin/Index">Administration</a></li>
                <li class="breadcrumb-item active" aria-current="page">Permissions</li>
            </ol>
        </nav>

        <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
            <div>
                <p class="text-muted mb-1">Administration</p>
                <h1 class="h3 mb-0">Permissions</h1>
            </div>
        </div>

        <div class="card border-0 shadow-sm">
            <div class="card-body p-4">
                <h2 class="h5 mb-3">Choisir un role</h2>
                <p class="text-muted mb-4">Selectionnez un role pour cocher les droits individuels et les groupes de droits qui lui sont attribues.</p>

                @if (Model.Count == 0)
                {
                    <p class="text-muted text-center py-4 mb-0">
                        Aucun role enregistre.
                        <droit-visible code="ROLE.CREER">
                            <a asp-controller="Roles" asp-action="Create">Creer un role</a>.
                        </droit-visible>
                    </p>
                }
                else
                {
                    <div class="list-group">
                        @foreach (var role in Model)
                        {
                            <a asp-controller="Permissions" asp-action="Role" asp-route-roleId="@role.Id" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                                <span>
                                    <span class="fw-semibold">@role.Name</span>
                                    @if (!string.IsNullOrWhiteSpace(role.Description))
                                    {
                                        <span class="text-muted"> — @role.Description</span>
                                    }
                                </span>
                                <i class="fi fi-rr-angle-small-right"></i>
                            </a>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</section>
