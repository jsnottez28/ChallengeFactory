@model List<Application.Common.Interfaces.CohorteResume>
@{
    ViewData["Title"] = "Cohortes";
}

<section class="backend-page">
    <div class="container-fluid">
        <nav aria-label="breadcrumb" class="mb-3">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a asp-page="/Dashboard/Index">Accueil</a></li>
                <li class="breadcrumb-item"><a asp-page="/Admin/Index">Administration</a></li>
                <li class="breadcrumb-item active" aria-current="page">Cohortes</li>
            </ol>
        </nav>

        @if (TempData["StatusMessage"] is string statusMessage && !string.IsNullOrWhiteSpace(statusMessage))
        {
            <div class="alert alert-info alert-dismissible fade show" role="alert">
                @statusMessage
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fermer"></button>
            </div>
        }

        <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
            <div>
                <p class="text-muted mb-1">Administration</p>
                <h1 class="h3 mb-0">Cohortes</h1>
            </div>
            <droit-visible code="COHORTE.CREER">
                <a asp-controller="Cohortes" asp-action="Create" class="btn btn-primary">Créer une Cohorte</a>
            </droit-visible>
        </div>

        <div class="card border-0 shadow-sm">
            <div class="card-body p-4">
                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <thead>
                            <tr>
                                <th scope="col">Nom</th>
                                <th scope="col">Challenge</th>
                                <th scope="col">Étape</th>
                                <th scope="col">Statut</th>
                                <th scope="col">Membres</th>
                                <th scope="col" class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Count == 0)
                            {
                                <tr>
                                    <td colspan="6" class="text-muted text-center py-4">Aucune Cohorte créée pour le moment.</td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var cohorte in Model)
                                {
                                    <tr>
                                        <td class="fw-semibold">@cohorte.Nom</td>
                                        <td>@cohorte.ChallengeTitre</td>
                                        <td>@cohorte.EtapeCourante / @cohorte.NombreEtapes</td>
                                        <td>
                                            @switch (cohorte.Statut)
                                            {
                                                case Domain.Entities.StatutCohorte.EnPreparation:
                                                    <span class="badge text-bg-warning">En préparation</span>
                                                    break;
                                                case Domain.Entities.StatutCohorte.Active:
                                                    <span class="badge text-bg-success">Active</span>
                                                    break;
                                                default:
                                                    <span class="badge text-bg-secondary">Terminée</span>
                                                    break;
                                            }
                                        </td>
                                        <td>@cohorte.NombreMembres</td>
                                        <td class="text-end">
                                            <a asp-controller="Cohortes" asp-action="Details" asp-route-id="@cohorte.Id" class="btn btn-sm btn-outline-secondary">Voir</a>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</section>
