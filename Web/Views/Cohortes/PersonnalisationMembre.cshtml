@model List<Application.Common.Interfaces.PersonnalisationEtapeInfo>
@using Application.Common.Interfaces
@using Domain.Entities
@{
    var cohorte = (CohorteResume)ViewData["Cohorte"]!;
    var membre = (CohorteMembreInfo)ViewData["Membre"]!;
    ViewData["Title"] = $"Personnalisation — {membre.NomComplet}";
}

<section class="backend-page">
    <div class="container-fluid">
        <nav aria-label="breadcrumb" class="mb-3">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a asp-page="/Dashboard/Index">Accueil</a></li>
                <li class="breadcrumb-item"><a asp-page="/Admin/Index">Administration</a></li>
                <li class="breadcrumb-item"><a asp-controller="Cohortes" asp-action="Index">Cohortes</a></li>
                <li class="breadcrumb-item"><a asp-controller="Cohortes" asp-action="Details" asp-route-id="@cohorte.Id">Détails</a></li>
                <li class="breadcrumb-item active" aria-current="page">Personnalisation</li>
            </ol>
        </nav>

        @if (TempData["StatusMessage"] is string statusMessage && !string.IsNullOrWhiteSpace(statusMessage))
        {
            <div class="alert alert-info alert-dismissible fade show" role="alert">
                @statusMessage
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fermer"></button>
            </div>
        }

        <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
            <div>
                <p class="text-muted mb-1">Administration — Bilan de compétences individuel</p>
                <h1 class="h3 mb-0">Personnalisation — @membre.NomComplet</h1>
                <p class="text-muted mb-0">@cohorte.ChallengeTitre · @cohorte.Nom</p>
            </div>
            <a asp-controller="Cohortes" asp-action="Details" asp-route-id="@cohorte.Id" class="btn btn-outline-secondary">Retour à la Cohorte</a>
        </div>

        @if (cohorte.Format != FormatChallenge.BilanCompetencesIndividuel)
        {
            <div class="alert alert-warning" role="alert">
                Cette fonctionnalité est réservée aux parcours de type « Bilan de compétences individuel ». Elle n'est pas disponible pour cette Cohorte.
            </div>
        }

        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white border-bottom p-4">
                <h2 class="h6 mb-0">Toutes les étapes du parcours</h2>
                <p class="text-muted small mb-0">Vous pouvez préparer ou ajuster une étape à l'avance, même si ce membre ne l'a pas encore atteinte.</p>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <thead>
                            <tr>
                                <th scope="col">Étape</th>
                                <th scope="col">Personnalisation en place</th>
                                <th scope="col" class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var etape in Model)
                            {
                                <tr>
                                    <td>
                                        Étape @etape.NumeroEtape — @etape.TitreEtape
                                        @if (etape.EstEtapeCourante)
                                        {
                                            <span class="badge text-bg-primary ms-2">En cours</span>
                                        }
                                    </td>
                                    <td>
                                        @if (etape.NombreCartesPersonnalisees == 0 && !etape.AInstructionsPersonnalisees)
                                        {
                                            <span class="text-muted small">Aucune</span>
                                        }
                                        else
                                        {
                                            @if (etape.NombreCartesPersonnalisees > 0)
                                            {
                                                <span class="badge text-bg-info me-1">@etape.NombreCartesPersonnalisees carte(s)</span>
                                            }
                                            @if (etape.AInstructionsPersonnalisees)
                                            {
                                                <span class="badge text-bg-info">Instructions</span>
                                            }
                                        }
                                    </td>
                                    <td class="text-end">
                                        <a asp-controller="Cohortes" asp-action="CartesSupplementairesMembre"
                                           asp-route-cohorteId="@cohorte.Id" asp-route-cohorteMembreId="@membre.Id" asp-route-etapeId="@etape.ChallengeEtapeId"
                                           class="btn btn-sm btn-outline-primary">Personnaliser</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</section>
