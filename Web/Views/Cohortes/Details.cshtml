@model Application.Common.Interfaces.CohorteResume
@using Application.Common.Interfaces
@using Domain.Entities
@{
    ViewData["Title"] = Model.Nom;
    var membres = ViewData["Membres"] as List<CohorteMembreInfo> ?? [];
    var historique = ViewData["Historique"] as List<CohorteEtapeValidationInfo> ?? [];
    var derniereEtape = Model.EtapeCourante >= Model.NombreEtapes;
}

<section class="backend-page">
    <div class="container-fluid">
        <nav aria-label="breadcrumb" class="mb-3">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a asp-page="/Dashboard/Index">Accueil</a></li>
                <li class="breadcrumb-item"><a asp-page="/Admin/Index">Administration</a></li>
                <li class="breadcrumb-item"><a asp-controller="Cohortes" asp-action="Index">Cohortes</a></li>
                <li class="breadcrumb-item active" aria-current="page">@Model.Nom</li>
            </ol>
        </nav>

        @if (TempData["StatusMessage"] is string statusMessage && !string.IsNullOrWhiteSpace(statusMessage))
        {
            <div class="alert alert-info alert-dismissible fade show" role="alert">
                @statusMessage
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fermer"></button>
            </div>
        }

        <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
            <div>
                <p class="text-muted mb-1">Administration</p>
                <h1 class="h3 mb-0">@Model.Nom</h1>
                <p class="text-muted mb-0">@Model.ChallengeTitre @(Model.OrganisationNom is not null ? $"· {Model.OrganisationNom}" : "")</p>
            </div>
            <div class="d-flex flex-wrap gap-2">
                @switch (Model.Statut)
                {
                    case StatutCohorte.EnPreparation:
                        <span class="badge text-bg-warning align-self-center">En préparation</span>
                        break;
                    case StatutCohorte.Active:
                        <span class="badge text-bg-success align-self-center">Active — étape @Model.EtapeCourante/@Model.NombreEtapes</span>
                        break;
                    default:
                        <span class="badge text-bg-secondary align-self-center">Terminée</span>
                        break;
                }

                <droit-visible code="COHORTE.VALIDER">
                    @if (Model.Statut == StatutCohorte.EnPreparation)
                    {
                        <form method="post" asp-controller="Cohortes" asp-action="Lancer" asp-route-id="@Model.Id" onsubmit="return confirm('Lancer cette Cohorte ? Les inscriptions seront fermées et l\'étape 1 sera attribuée à tous les membres actuels.');">
                            <button type="submit" class="btn btn-primary">Lancer la Cohorte</button>
                        </form>
                    }
                    else if (Model.Statut == StatutCohorte.Active)
                    {
                        <form method="post" asp-controller="Cohortes" asp-action="ValiderEtape" asp-route-id="@Model.Id" onsubmit="return confirm('Confirmer la validation de cette étape ?');">
                            <button type="submit" class="btn btn-primary">
                                @(derniereEtape ? "Valider la dernière étape et clôturer le Challenge" : "Valider l'étape en cours et passer à la suivante")
                            </button>
                        </form>
                    }
                </droit-visible>
            </div>
        </div>

        <div class="row g-4 align-items-start">
            <div class="col-12 col-lg-7">
                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-header bg-white border-bottom p-4 d-flex flex-wrap align-items-center justify-content-between gap-3">
                        <h2 class="h5 mb-0">Membres (@membres.Count)</h2>
                        <droit-visible code="COHORTE.MODIFIER">
                            <a asp-controller="Cohortes" asp-action="ImporterMembres" asp-route-id="@Model.Id" class="btn btn-sm btn-outline-primary">Importer une liste</a>
                        </droit-visible>
                    </div>
                    <div class="card-body p-4">
                        <droit-visible code="COHORTE.MODIFIER">
                            @if (Model.Statut != StatutCohorte.Terminee)
                            {
                                <form method="post" asp-controller="Cohortes" asp-action="AjouterMembreManuel" asp-route-id="@Model.Id" class="d-flex flex-wrap gap-2 mb-4">
                                    @Html.AntiForgeryToken()
                                    <input type="email" name="email" class="form-control" style="max-width: 320px;" placeholder="Email d'un utilisateur existant" required>
                                    <button type="submit" class="btn btn-outline-primary">Ajouter</button>
                                </form>
                            }
                        </droit-visible>

                        @if (membres.Count == 0)
                        {
                            <p class="text-muted mb-0">Aucun membre pour le moment.</p>
                        }
                        else
                        {
                            <div class="table-responsive">
                                <table class="table align-middle mb-0">
                                    <thead>
                                        <tr>
                                            <th scope="col">Membre</th>
                                            <th scope="col">Ajouté via</th>
                                            <th scope="col">Accès plateforme</th>
                                            <th scope="col" class="text-end">Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var membre in membres)
                                        {
                                            <tr>
                                                <td>
                                                    @membre.NomComplet
                                                    <span class="d-block text-muted small">@membre.Email</span>
                                                </td>
                                                <td>
                                                    @switch (membre.MethodeAjout)
                                                    {
                                                        case MethodeAjoutMembre.Manuel:
                                                            <span class="badge text-bg-light">Manuel</span>
                                                            break;
                                                        case MethodeAjoutMembre.Import:
                                                            <span class="badge text-bg-light">Import</span>
                                                            break;
                                                        default:
                                                            <span class="badge text-bg-light">Auto-inscription</span>
                                                            break;
                                                    }
                                                </td>
                                                <td>
                                                    @switch (membre.StatutAcces)
                                                    {
                                                        case StatutUtilisateur.Actif:
                                                            <span class="badge text-bg-success">Actif</span>
                                                            break;
                                                        case StatutUtilisateur.Modere:
                                                            <span class="badge text-bg-warning">En attente</span>
                                                            break;
                                                        default:
                                                            <span class="badge text-bg-secondary">Suspendu</span>
                                                            break;
                                                    }
                                                </td>
                                                <td class="text-end">
                                                    <droit-visible code="COHORTE.MODIFIER">
                                                        <div class="d-inline-flex gap-2">
                                                            @if (membre.StatutAcces == StatutUtilisateur.Modere)
                                                            {
                                                                <form method="post" asp-controller="Cohortes" asp-action="RenvoyerInvitation" asp-route-utilisateurId="@membre.UtilisateurId" asp-route-cohorteId="@Model.Id">
                                                                    <button type="submit" class="btn btn-sm btn-outline-secondary">Renvoyer l'invitation</button>
                                                                </form>
                                                            }
                                                            <droit-visible code="COHORTE.MODIFIER">
                                                                <a asp-page="/Admin/AbonnementsBtoC" asp-route-utilisateurId="@membre.UtilisateurId" class="btn btn-sm btn-outline-secondary">Gérer l'abonnement</a>
                                                            </droit-visible>
                                                        </div>
                                                    </droit-visible>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <div class="col-12 col-lg-5">
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-white border-bottom p-4">
                        <h2 class="h5 mb-0">Historique des validations</h2>
                    </div>
                    <div class="card-body p-4">
                        @if (historique.Count == 0)
                        {
                            <p class="text-muted mb-0">Aucune étape validée pour le moment.</p>
                        }
                        else
                        {
                            <ul class="list-unstyled mb-0">
                                @foreach (var validation in historique)
                                {
                                    <li class="mb-2">
                                        <strong>Étape @validation.NumeroEtape</strong> validée par @validation.ValideParNomComplet
                                        <span class="d-block text-muted small">@validation.ValideLe.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span>
                                    </li>
                                }
                            </ul>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
