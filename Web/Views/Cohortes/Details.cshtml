@model Application.Common.Interfaces.CohorteResume
@using Application.Common.Interfaces
@using Domain.Entities
@{
    ViewData["Title"] = Model.Nom;
    var membres = ViewData["Membres"] as List<CohorteMembreInfo> ?? [];
    var historique = ViewData["Historique"] as List<CohorteEtapeValidationInfo> ?? [];
    var derniereEtape = Model.EtapeCourante >= Model.NombreEtapes;
    var emargements = ViewData["Emargements"] as List<EmargementMembreInfo> ?? [];
    var emargementsComplets = emargements.Count == 0 || emargements.All(m => m.TousSignes);
}

<section class="backend-page">
    <div class="container-fluid">
        <nav aria-label="breadcrumb" class="mb-3">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a asp-page="/Dashboard/Index">Accueil</a></li>
                <li class="breadcrumb-item"><a asp-page="/Admin/Index">Administration</a></li>
                <li class="breadcrumb-item"><a asp-controller="Cohortes" asp-action="Index">Cohortes</a></li>
                <li class="breadcrumb-item active" aria-current="page">@Model.Nom</li>
            </ol>
        </nav>

        @if (TempData["StatusMessage"] is string statusMessage && !string.IsNullOrWhiteSpace(statusMessage))
        {
            <div class="alert alert-info alert-dismissible fade show" role="alert">
                @statusMessage
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fermer"></button>
            </div>
        }

        <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
            <div>
                <p class="text-muted mb-1">Administration</p>
                <h1 class="h3 mb-0">@Model.Nom</h1>
                <p class="text-muted mb-0">@Model.ChallengeTitre @(Model.OrganisationNom is not null ? $"· {Model.OrganisationNom}" : "")</p>
            </div>
            <div class="d-flex flex-wrap gap-2">
                @switch (Model.Statut)
                {
                    case StatutCohorte.EnPreparation:
                        <span class="badge text-bg-warning align-self-center">En préparation</span>
                        break;
                    case StatutCohorte.Active:
                        <span class="badge text-bg-success align-self-center">Active — étape @Model.EtapeCourante/@Model.NombreEtapes</span>
                        break;
                    default:
                        <span class="badge text-bg-secondary align-self-center">Terminée</span>
                        break;
                }

                @if (Model.Statut == StatutCohorte.Active)
                {
                    <droit-visible code="PREUVE.CONSULTER">
                        <a asp-controller="Preuves" asp-action="Etape" asp-route-cohorteId="@Model.Id" class="btn btn-outline-secondary align-self-center">Preuves de l'étape</a>
                    </droit-visible>
                }

                <droit-visible code="COHORTE.VALIDER">
                    @if (Model.Statut == StatutCohorte.EnPreparation)
                    {
                        <form method="post" asp-controller="Cohortes" asp-action="Lancer" asp-route-id="@Model.Id" onsubmit="return confirm('Lancer cette Cohorte ? Les inscriptions seront fermées et l\'étape 1 sera attribuée à tous les membres actuels.');">
                            <button type="submit" class="btn btn-primary">Lancer la Cohorte</button>
                        </form>
                    }
                    else if (Model.Statut == StatutCohorte.Active)
                    {
                        @if (emargementsComplets)
                        {
                            <form method="post" asp-controller="Cohortes" asp-action="ValiderEtape" asp-route-id="@Model.Id" onsubmit="return confirm('Confirmer la validation de cette étape ? Consultez le résumé sur la page \'Preuves de l\'étape\' avant de continuer si besoin.');">
                                <button type="submit" class="btn btn-primary">
                                    @(derniereEtape ? "Valider la dernière étape et clôturer le Challenge" : "Valider l'étape en cours et passer à la suivante")
                                </button>
                            </form>
                        }
                        else
                        {
                            <span class="text-muted small align-self-center" title="Tous les membres doivent avoir signé leur émargement de l'étape en cours.">
                                Émargements en attente de signature — validation impossible
                            </span>
                        }
                    }
                </droit-visible>
                @if (Model.Statut == StatutCohorte.EnPreparation)
                {
                    <droit-visible code="COHORTE.SUPPRIMER">
                        <form method="post" asp-controller="Cohortes" asp-action="Delete" asp-route-id="@Model.Id" onsubmit="return confirm('Supprimer définitivement cette Cohorte et retirer ses membres ?');">
                            <button type="submit" class="btn btn-outline-danger">Supprimer</button>
                        </form>
                    </droit-visible>
                }
            </div>
        </div>

        <div class="row g-4 align-items-start">
            <div class="col-12 col-lg-7">
                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-header bg-white border-bottom p-4 d-flex flex-wrap align-items-center justify-content-between gap-3">
                        <h2 class="h5 mb-0">Membres (@membres.Count)</h2>
                        <droit-visible code="COHORTE.MODIFIER">
                            <a asp-controller="Cohortes" asp-action="ImporterMembres" asp-route-id="@Model.Id" class="btn btn-sm btn-outline-primary">Importer une liste</a>
                        </droit-visible>
                    </div>
                    <div class="card-body p-4">
                        <droit-visible code="COHORTE.MODIFIER">
                            @if (Model.Statut != StatutCohorte.Terminee)
                            {
                                <form method="post" asp-controller="Cohortes" asp-action="AjouterMembreManuel" asp-route-id="@Model.Id" class="d-flex flex-wrap gap-2 mb-4">
                                    @Html.AntiForgeryToken()
                                    <input type="email" name="email" class="form-control" style="max-width: 320px;" placeholder="Email d'un utilisateur existant" required>
                                    <button type="submit" class="btn btn-outline-primary">Ajouter</button>
                                </form>
                            }
                        </droit-visible>

                        @if (membres.Count == 0)
                        {
                            <p class="text-muted mb-0">Aucun membre pour le moment.</p>
                        }
                        else
                        {
                            <div class="table-responsive">
                                <table class="table align-middle mb-0">
                                    <thead>
                                        <tr>
                                            <th scope="col">Membre</th>
                                            <th scope="col">Ajouté via</th>
                                            <th scope="col">Accès plateforme</th>
                                            <th scope="col" class="text-end">Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var membre in membres)
                                        {
                                            <tr>
                                                <td>
                                                    @membre.NomComplet
                                                    <span class="d-block text-muted small">@membre.Email</span>
                                                </td>
                                                <td>
                                                    @switch (membre.MethodeAjout)
                                                    {
                                                        case MethodeAjoutMembre.Manuel:
                                                            <span class="badge text-bg-light">Manuel</span>
                                                            break;
                                                        case MethodeAjoutMembre.Import:
                                                            <span class="badge text-bg-light">Import</span>
                                                            break;
                                                        default:
                                                            <span class="badge text-bg-light">Auto-inscription</span>
                                                            break;
                                                    }
                                                </td>
                                                <td>
                                                    @switch (membre.StatutAcces)
                                                    {
                                                        case StatutUtilisateur.Actif:
                                                            <span class="badge text-bg-success">Actif</span>
                                                            break;
                                                        case StatutUtilisateur.Modere:
                                                            <span class="badge text-bg-warning">En attente</span>
                                                            break;
                                                        default:
                                                            <span class="badge text-bg-secondary">Suspendu</span>
                                                            break;
                                                    }
                                                </td>
                                                <td class="text-end">
                                                    <div class="d-inline-flex gap-2">
                                                        @if (Model.Statut == StatutCohorte.Terminee)
                                                        {
                                                            <droit-visible code="COHORTE.CONSULTER">
                                                                <a asp-page="/Dashboard/Attestation" asp-route-cohorteId="@Model.Id" asp-route-utilisateurId="@membre.UtilisateurId" target="_blank" class="btn btn-sm btn-outline-secondary">Attestation</a>
                                                            </droit-visible>
                                                        }
                                                        <droit-visible code="COHORTE.MODIFIER">
                                                            @if (membre.StatutAcces == StatutUtilisateur.Modere)
                                                            {
                                                                <form method="post" asp-controller="Cohortes" asp-action="RenvoyerInvitation" asp-route-utilisateurId="@membre.UtilisateurId" asp-route-cohorteId="@Model.Id">
                                                                    <button type="submit" class="btn btn-sm btn-outline-secondary">Renvoyer l'invitation</button>
                                                                </form>
                                                            }
                                                            <a asp-page="/Admin/AbonnementsBtoC" asp-route-utilisateurId="@membre.UtilisateurId" class="btn btn-sm btn-outline-secondary">Gérer l'abonnement</a>
                                                        </droit-visible>
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <div class="col-12 col-lg-5">
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-white border-bottom p-4">
                        <h2 class="h5 mb-0">Historique des validations</h2>
                    </div>
                    <div class="card-body p-4">
                        @if (historique.Count == 0)
                        {
                            <p class="text-muted mb-0">Aucune étape validée pour le moment.</p>
                        }
                        else
                        {
                            <ul class="list-unstyled mb-0">
                                @foreach (var validation in historique)
                                {
                                    <li class="mb-2">
                                        <strong>Étape @validation.NumeroEtape</strong> validée par @validation.ValideParNomComplet
                                        <span class="d-block text-muted small">@validation.ValideLe.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span>
                                    </li>
                                }
                            </ul>
                        }
                    </div>
                </div>

                @{
                    var visio = ViewData["Visio"] as VisioEtapeInfo;
                }
                @if (Model.Statut == StatutCohorte.Active && visio is not null)
                {
                    <div class="card border-0 shadow-sm mt-4">
                        <div class="card-header bg-white border-bottom p-4">
                            <h2 class="h5 mb-0">Visio de l'étape @visio.NumeroEtape</h2>
                        </div>
                        <div class="card-body p-4">
                            <droit-visible code="COHORTE.MODIFIER">
                                <form method="post" asp-controller="Cohortes" asp-action="PlanifierVisio" asp-route-id="@Model.Id" class="row g-2 mb-3">
                                    @Html.AntiForgeryToken()
                                    <div class="col-12 col-sm-5">
                                        <label class="form-label small">Date et heure</label>
                                        <input type="datetime-local" name="dateVisio" class="form-control" value="@(visio.DateVisio?.ToLocalTime().ToString("yyyy-MM-ddTHH:mm"))">
                                    </div>
                                    <div class="col-12 col-sm-7">
                                        <label class="form-label small">Lien de visio (Zoom, Teams, Meet...)</label>
                                        <input type="url" name="lienVisio" class="form-control" value="@visio.LienVisio" placeholder="https://...">
                                    </div>
                                    <div class="col-12">
                                        <button type="submit" class="btn btn-outline-primary btn-sm">Enregistrer</button>
                                    </div>
                                </form>
                                @if (!string.IsNullOrWhiteSpace(visio.LienVisio))
                                {
                                    <form method="post" asp-controller="Cohortes" asp-action="EnvoyerLienVisio" asp-route-id="@Model.Id">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-primary btn-sm">@(visio.DernierEnvoiLe is null ? "Envoyer le lien de connexion" : "Renvoyer le lien de connexion")</button>
                                    </form>
                                    @if (visio.DernierEnvoiLe is not null)
                                    {
                                        <p class="text-muted small mt-2 mb-0">Dernier envoi : @visio.DernierEnvoiLe.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</p>
                                    }
                                }
                            </droit-visible>
                        </div>
                    </div>
                }

                @if (Model.Statut == StatutCohorte.Active)
                {
                    <div class="card border-0 shadow-sm mt-4">
                        <div class="card-header bg-white border-bottom p-4 d-flex flex-wrap align-items-center justify-content-between gap-3">
                            <h2 class="h5 mb-0">
                                Émargements de l'étape @Model.EtapeCourante
                                @if (visio?.DateVisio is not null)
                                {
                                    <span class="text-muted small fw-normal">— séance du @visio.DateVisio.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span>
                                }
                            </h2>
                            <droit-visible code="COHORTE.MODIFIER">
                                @if (visio?.DateVisio is not null)
                                {
                                    <form method="post" asp-controller="Cohortes" asp-action="EnvoyerEmargements" asp-route-id="@Model.Id">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-outline-primary btn-sm">Envoyer les émargements</button>
                                    </form>
                                }
                                else
                                {
                                    <span class="text-muted small">Planifiez d'abord une date de visio ci-dessus.</span>
                                }
                            </droit-visible>
                        </div>
                        <div class="card-body p-4">
                            @if (emargements.Count == 0)
                            {
                                <p class="text-muted mb-0">Aucune carte attribuée pour l'étape en cours, ou émargements pas encore envoyés.</p>
                            }
                            else
                            {
                                <ul class="list-unstyled mb-0">
                                    @foreach (var membre in emargements)
                                    {
                                        var carteAvecSignature = membre.Cartes.FirstOrDefault(c => c.ASignature);
                                        <li class="mb-2">
                                            @membre.NomComplet
                                            @if (membre.TousSignes)
                                            {
                                                <span class="badge text-bg-success ms-1">Signé</span>
                                            }
                                            else
                                            {
                                                <span class="badge text-bg-warning ms-1">@(membre.Cartes.Count(c => c.Signe))/@(membre.Cartes.Count) carte(s) signée(s)</span>
                                            }
                                            @if (carteAvecSignature is not null)
                                            {
                                                <a asp-page="/Dashboard/EmargementSignature" asp-route-emargementId="@carteAvecSignature.EmargementId" target="_blank" class="small ms-2">Voir la signature</a>
                                            }
                                        </li>
                                    }
                                </ul>
                            }
                        </div>
                    </div>
                }

                @{
                    var satisfaction = ViewData["Satisfaction"] as SatisfactionStats ?? new SatisfactionStats();
                }
                <div class="card border-0 shadow-sm mt-4">
                    <div class="card-header bg-white border-bottom p-4">
                        <h2 class="h5 mb-0">Satisfaction (Qualiopi — critère 7)</h2>
                    </div>
                    <div class="card-body p-4">
                        @if (satisfaction.NombreReponses == 0)
                        {
                            <p class="text-muted mb-0">Aucune réponse pour le moment — l'enquête est envoyée à la clôture de la Cohorte.</p>
                        }
                        else
                        {
                            <p class="mb-3">
                                <strong class="fs-4">@satisfaction.ScoreMoyen?.ToString("0.0")</strong><span class="text-muted">/10</span>
                                <span class="text-muted small ms-2">(@satisfaction.NombreReponses réponse@(satisfaction.NombreReponses > 1 ? "s" : ""))</span>
                            </p>
                            @if (satisfaction.DerniersCommentaires.Count > 0)
                            {
                                <ul class="list-unstyled mb-0">
                                    @foreach (var commentaire in satisfaction.DerniersCommentaires)
                                    {
                                        <li class="mb-2 text-muted small border-start ps-2">« @commentaire »</li>
                                    }
                                </ul>
                            }
                        }
                    </div>
                </div>

                @{
                    var miParcours = ViewData["QuestionnaireMiParcours"] as QuestionnaireMiParcoursStats ?? new QuestionnaireMiParcoursStats();
                }
                <div class="card border-0 shadow-sm mt-4">
                    <div class="card-header bg-white border-bottom p-4">
                        <h2 class="h5 mb-0">Point d'étape mi-parcours</h2>
                    </div>
                    <div class="card-body p-4">
                        @if (miParcours.NombreReponses == 0)
                        {
                            <p class="text-muted mb-0">Aucune réponse pour le moment — envoyé automatiquement dès que la Cohorte atteint son étape médiane.</p>
                        }
                        else
                        {
                            <p class="mb-2">
                                <strong class="fs-4">@miParcours.NoteAccompagnementMoyenne?.ToString("0.0")</strong><span class="text-muted">/10</span>
                                <span class="text-muted small ms-2">(@miParcours.NombreReponses réponse@(miParcours.NombreReponses > 1 ? "s" : ""))</span>
                            </p>
                            <p class="mb-3 small text-muted">
                                Projet toujours pertinent : @miParcours.NombreProjetOui oui · @miParcours.NombreProjetPartiellement partiellement · @miParcours.NombreProjetNon non
                            </p>
                            @if (miParcours.DerniersAjustements.Count > 0)
                            {
                                <h3 class="h6 text-uppercase text-muted">Ajustements souhaités</h3>
                                <ul class="list-unstyled mb-3">
                                    @foreach (var ajustement in miParcours.DerniersAjustements)
                                    {
                                        <li class="mb-2 text-muted small border-start ps-2">« @ajustement »</li>
                                    }
                                </ul>
                            }
                            @if (miParcours.DernieresDifficultes.Count > 0)
                            {
                                <h3 class="h6 text-uppercase text-muted">Difficultés rencontrées</h3>
                                <ul class="list-unstyled mb-0">
                                    @foreach (var difficulte in miParcours.DernieresDifficultes)
                                    {
                                        <li class="mb-2 text-muted small border-start ps-2">« @difficulte »</li>
                                    }
                                </ul>
                            }
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
