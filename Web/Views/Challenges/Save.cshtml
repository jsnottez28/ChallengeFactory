@model Web.Controllers.ChallengesController.ChallengeFormModel
@{
    var estModification = Model.Id.HasValue;
    ViewData["Title"] = estModification ? "Modifier un Challenge" : "Créer un Challenge";
}

<section class="backend-page">
    <div class="container-fluid">
        <nav aria-label="breadcrumb" class="mb-3">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a asp-page="/Dashboard/Index">Accueil</a></li>
                <li class="breadcrumb-item"><a asp-page="/Admin/Index">Administration</a></li>
                <li class="breadcrumb-item"><a asp-controller="Challenges" asp-action="Index">Challenges</a></li>
                <li class="breadcrumb-item active" aria-current="page">@ViewData["Title"]</li>
            </ol>
        </nav>

        <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
            <div>
                <p class="text-muted mb-1">Administration</p>
                <h1 class="h3 mb-0">@ViewData["Title"]</h1>
            </div>
            <a asp-controller="Challenges" asp-action="Index" class="btn btn-outline-secondary">Retour aux Challenges</a>
        </div>

        <form method="post" asp-controller="Challenges" asp-action="@(estModification ? "Edit" : "Create")" asp-route-id="@Model.Id">
            @Html.AntiForgeryToken()
            <div class="card border-0 shadow-sm">
                <div class="card-body p-4">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="row g-3">
                        <div class="col-12">
                            <label asp-for="Titre" class="form-label"></label>
                            <input asp-for="Titre" class="form-control" autocomplete="off">
                            <span asp-validation-for="Titre" class="text-danger"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="Slogan" class="form-label"></label>
                            <input asp-for="Slogan" class="form-control" autocomplete="off">
                        </div>
                        <div class="col-12 col-md-6">
                            <label asp-for="NombreEtapes" class="form-label"></label>
                            <input asp-for="NombreEtapes" type="number" min="1" max="52" class="form-control">
                            <span asp-validation-for="NombreEtapes" class="text-danger"></span>
                        </div>
                        <div class="col-12 col-md-6">
                            <label asp-for="Mode" class="form-label"></label>
                            <select asp-for="Mode" class="form-select">
                                <option value="@Domain.Entities.ModePlateforme.BtoC">BtoC</option>
                                <option value="@Domain.Entities.ModePlateforme.BtoB">BtoB</option>
                            </select>
                        </div>
                    </div>
                </div>
                <div class="card-footer bg-white border-top p-4">
                    <div class="d-flex flex-wrap justify-content-end gap-2">
                        <a asp-controller="Challenges" asp-action="Index" class="btn btn-outline-secondary">Annuler</a>
                        <button type="submit" class="btn btn-primary">@(estModification ? "Enregistrer" : "Créer le Challenge")</button>
                    </div>
                </div>
            </div>
        </form>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
