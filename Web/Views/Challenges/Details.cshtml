@model Domain.Entities.Challenge
@{
    ViewData["Title"] = Model.Titre;
}

<section class="backend-page">
    <div class="container-fluid">
        <nav aria-label="breadcrumb" class="mb-3">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a asp-page="/Dashboard/Index">Accueil</a></li>
                <li class="breadcrumb-item"><a asp-page="/Admin/Index">Administration</a></li>
                <li class="breadcrumb-item"><a asp-controller="Challenges" asp-action="Index">Challenges</a></li>
                <li class="breadcrumb-item active" aria-current="page">@Model.Titre</li>
            </ol>
        </nav>

        @if (TempData["StatusMessage"] is string statusMessage && !string.IsNullOrWhiteSpace(statusMessage))
        {
            <div class="alert alert-info alert-dismissible fade show" role="alert">
                @statusMessage
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fermer"></button>
            </div>
        }

        <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
            <div>
                <p class="text-muted mb-1">Administration</p>
                <h1 class="h3 mb-0">
                    @Model.Titre
                    @if (!string.IsNullOrWhiteSpace(Model.Code))
                    {
                        <code class="fs-6 text-muted ms-2">@Model.Code</code>
                    }
                </h1>
                @if (!string.IsNullOrWhiteSpace(Model.Slogan))
                {
                    <p class="text-muted mb-0">@Model.Slogan</p>
                }
            </div>
            <div class="d-flex flex-wrap gap-2">
                <span class="badge text-bg-light align-self-center">@Model.Mode</span>
                @if (Model.Statut == Domain.Entities.StatutChallenge.Publie)
                {
                    <span class="badge text-bg-success align-self-center">Publié</span>
                }
                else
                {
                    <span class="badge text-bg-secondary align-self-center">Brouillon</span>
                }
                <droit-visible code="CHALLENGE.MODIFIER">
                    <a asp-controller="Challenges" asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Modifier</a>
                </droit-visible>
                @if (Model.Statut != Domain.Entities.StatutChallenge.Publie)
                {
                    <droit-visible code="CHALLENGE.VALIDER">
                        <form method="post" asp-controller="Challenges" asp-action="Publier" asp-route-id="@Model.Id" onsubmit="return confirm('Publier ce Challenge ? Il pourra alors servir à créer des Cohortes.');">
                            <button type="submit" class="btn btn-primary">Publier</button>
                        </form>
                    </droit-visible>
                    <droit-visible code="CHALLENGE.SUPPRIMER">
                        <form method="post" asp-controller="Challenges" asp-action="Delete" asp-route-id="@Model.Id" onsubmit="return confirm('Supprimer définitivement ce Challenge et toutes ses étapes ?');">
                            <button type="submit" class="btn btn-outline-danger">Supprimer</button>
                        </form>
                    </droit-visible>
                }
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.Description))
        {
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-body p-4">
                    <h2 class="h6 mb-2">Description</h2>
                    <div class="mb-0">@Html.Raw(Model.Description)</div>
                </div>
            </div>
        }

        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-white border-bottom p-4 d-flex flex-wrap align-items-center justify-content-between gap-3">
                <div>
                    <h2 class="h5 mb-1">Architecture (@Model.Etapes.Count / @Model.NombreEtapes étape(s))</h2>
                    <p class="text-muted mb-0">Chaque étape peut rattacher plusieurs Cartes de Compétences comme Ressources Directrices.</p>
                </div>
                <droit-visible code="CHALLENGE.MODIFIER">
                    @if (Model.Etapes.Count < Model.NombreEtapes)
                    {
                        <a asp-controller="Challenges" asp-action="CreateEtape" asp-route-challengeId="@Model.Id" class="btn btn-outline-primary">Ajouter une étape</a>
                    }
                </droit-visible>
            </div>
            <div class="card-body p-4">
                @if (Model.Etapes.Count == 0)
                {
                    <p class="text-muted mb-0">Aucune étape définie pour le moment.</p>
                }
                else
                {
                    <div class="accordion" id="accordionEtapes">
                        @foreach (var etape in Model.Etapes)
                        {
                            <div class="accordion-item mb-2 border rounded">
                                <h2 class="accordion-header">
                                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#etape-@etape.Id">
                                        Étape @etape.NumeroEtape — @etape.TitreEtape
                                        <span class="badge text-bg-light ms-3">@etape.Cartes.Count carte(s)</span>
                                    </button>
                                </h2>
                                <div id="etape-@etape.Id" class="accordion-collapse collapse" data-bs-parent="#accordionEtapes">
                                    <div class="accordion-body">
                                        @if (!string.IsNullOrWhiteSpace(etape.ObjectifPedagogique))
                                        {
                                            <p><strong>Objectif pédagogique :</strong> @etape.ObjectifPedagogique</p>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(etape.CompetenceCible))
                                        {
                                            <p><strong>Compétence cible :</strong> @etape.CompetenceCible</p>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(etape.DefiIndividuel))
                                        {
                                            <p><strong>Défi individuel :</strong> @etape.DefiIndividuel</p>
                                        }

                                        <p class="mb-1"><strong>Ressources Directrices :</strong></p>
                                        @if (etape.Cartes.Count == 0)
                                        {
                                            <p class="text-muted">Aucune carte rattachée.</p>
                                        }
                                        else
                                        {
                                            <ul>
                                                @foreach (var carte in etape.Cartes)
                                                {
                                                    <li><code>@carte.CarteCompetence.Code</code> — @carte.CarteCompetence.TitreTheorie</li>
                                                }
                                            </ul>
                                        }

                                        <droit-visible code="CHALLENGE.MODIFIER">
                                            <div class="d-flex flex-wrap gap-2 mt-3">
                                                <a asp-controller="Challenges" asp-action="CartesEtape" asp-route-etapeId="@etape.Id" class="btn btn-sm btn-outline-primary">Gérer les cartes</a>
                                                <a asp-controller="Challenges" asp-action="EditEtape" asp-route-etapeId="@etape.Id" class="btn btn-sm btn-outline-secondary">Modifier l'étape</a>
                                                <form method="post" asp-controller="Challenges" asp-action="DeleteEtape" asp-route-etapeId="@etape.Id" asp-route-challengeId="@Model.Id" onsubmit="return confirm('Supprimer cette étape ?');">
                                                    <button type="submit" class="btn btn-sm btn-outline-danger">Supprimer</button>
                                                </form>
                                            </div>
                                        </droit-visible>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</section>
