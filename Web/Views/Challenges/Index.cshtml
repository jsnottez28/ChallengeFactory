@model List<Domain.Entities.Challenge>
@{
    ViewData["Title"] = "Challenges";
}

<section class="backend-page">
    <div class="container-fluid">
        <nav aria-label="breadcrumb" class="mb-3">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a asp-page="/Dashboard/Index">Accueil</a></li>
                <li class="breadcrumb-item"><a asp-page="/Admin/Index">Administration</a></li>
                <li class="breadcrumb-item active" aria-current="page">Challenges</li>
            </ol>
        </nav>

        @if (TempData["StatusMessage"] is string statusMessage && !string.IsNullOrWhiteSpace(statusMessage))
        {
            <div class="alert alert-info alert-dismissible fade show" role="alert">
                @statusMessage
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fermer"></button>
            </div>
        }

        <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
            <div>
                <p class="text-muted mb-1">Administration</p>
                <h1 class="h3 mb-0">Challenges</h1>
            </div>
            <div class="d-flex flex-wrap gap-2">
                <droit-visible code="CHALLENGE.CREER">
                    <a asp-controller="Challenges" asp-action="Import" class="btn btn-outline-primary">Importer (.xlsx)</a>
                </droit-visible>
                <droit-visible code="CHALLENGE.CREER">
                    <a asp-controller="Challenges" asp-action="Create" class="btn btn-primary">Créer un Challenge</a>
                </droit-visible>
            </div>
        </div>

        <div class="card border-0 shadow-sm">
            <div class="card-body p-4">
                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <thead>
                            <tr>
                                <th scope="col">Titre</th>
                                <th scope="col">Mode</th>
                                <th scope="col">Étapes</th>
                                <th scope="col">Statut</th>
                                <th scope="col" class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Count == 0)
                            {
                                <tr>
                                    <td colspan="5" class="text-muted text-center py-4">Aucun Challenge créé pour le moment.</td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var challenge in Model)
                                {
                                    <tr>
                                        <td class="fw-semibold">
                                            @challenge.Titre
                                            @if (!string.IsNullOrWhiteSpace(challenge.Code))
                                            {
                                                <code class="d-block text-muted small fw-normal">@challenge.Code</code>
                                            }
                                        </td>
                                        <td><span class="badge text-bg-light">@challenge.Mode</span></td>
                                        <td>@challenge.NombreEtapes</td>
                                        <td>
                                            @if (challenge.Statut == Domain.Entities.StatutChallenge.Publie)
                                            {
                                                <span class="badge text-bg-success">Publié</span>
                                            }
                                            else
                                            {
                                                <span class="badge text-bg-secondary">Brouillon</span>
                                            }
                                        </td>
                                        <td class="text-end">
                                            <a asp-controller="Challenges" asp-action="Details" asp-route-id="@challenge.Id" class="btn btn-sm btn-outline-secondary">Voir</a>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</section>
