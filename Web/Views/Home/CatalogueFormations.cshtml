@model List<Web.Controllers.OffreFormationViewModel>
@{
    ViewData["Title"] = "Catalogue de formations";

    static string LibelleCategorie(Domain.Entities.CategorieOffreFormation c) => c switch
    {
        Domain.Entities.CategorieOffreFormation.Sensibiliser => "Sensibiliser",
        Domain.Entities.CategorieOffreFormation.MonterEnCompetenceCarbone => "Monter en compétence carbone",
        Domain.Entities.CategorieOffreFormation.PiloteTrajectoireSnbc => "Pilote de trajectoire SNBC 3",
        Domain.Entities.CategorieOffreFormation.ManagerEtEmbarquer => "Manager et embarquer",
        Domain.Entities.CategorieOffreFormation.ThematiquesParPosteEmission => "Thématiques par poste d'émission",
        Domain.Entities.CategorieOffreFormation.IaEtTransition => "IA et transition",
        Domain.Entities.CategorieOffreFormation.InspireesDuGraine => "Inspirées du GRAINE Centre-Val de Loire",
        Domain.Entities.CategorieOffreFormation.ParticuliersEtReconversion => "Particuliers et reconversion",
        _ => c.ToString(),
    };

    static string EmojiCategorie(Domain.Entities.CategorieOffreFormation c) => c switch
    {
        Domain.Entities.CategorieOffreFormation.Sensibiliser => "🔍",
        Domain.Entities.CategorieOffreFormation.MonterEnCompetenceCarbone => "🌱",
        Domain.Entities.CategorieOffreFormation.PiloteTrajectoireSnbc => "🧭",
        Domain.Entities.CategorieOffreFormation.ManagerEtEmbarquer => "🤝",
        Domain.Entities.CategorieOffreFormation.ThematiquesParPosteEmission => "⚡",
        Domain.Entities.CategorieOffreFormation.IaEtTransition => "🤖",
        Domain.Entities.CategorieOffreFormation.InspireesDuGraine => "🌳",
        Domain.Entities.CategorieOffreFormation.ParticuliersEtReconversion => "🎯",
        _ => "📘",
    };

    var categories = Model
        .GroupBy(o => o.Categorie)
        .OrderBy(g => (int)g.Key)
        .ToList();
}

<section class="cf-hero-home">
    <div class="container">
        <div class="row">
            <div class="col-xl-9">
                <span class="cf-badge">Catalogue de formations</span>
                <h1 class="cf-h1 mb-3">Toutes nos formations, <span class="cf-accent">en un coup d'œil</span>.</h1>
                <p class="cf-lead" style="max-width:680px;">
                    Chez Challenges Factory, chaque formation peut se suivre en <strong>format Challenge</strong> —
                    notre méthode privilégiée, qui fait agir plutôt que regarder. Le présentiel reste possible pour
                    les formations qui s'y prêtent. Les formations marquées « sur demande » n'existent pas encore :
                    elles sont créées dès qu'une entreprise ou un stagiaire en manifeste le besoin.
                </p>
            </div>
        </div>
    </div>
</section>

<section class="cf-section pt-0">
    <div class="container">
        @if (Model.Count == 0)
        {
            <p class="text-muted">Le catalogue est en cours de construction. Revenez bientôt !</p>
        }

        @foreach (var groupe in categories)
        {
            <div class="mb-5">
                <span class="cf-eyebrow">@EmojiCategorie(groupe.Key) @LibelleCategorie(groupe.Key)</span>
                <div class="row g-3 mt-1">
                    @foreach (var offre in groupe)
                    {
                        <div class="col-12 col-md-6 col-xl-4">
                            <div class="cf-formation-card h-100">
                                <div class="d-flex flex-wrap gap-2 mb-2">
                                    @if (offre.Statut == Domain.Entities.StatutOffreFormation.Disponible)
                                    {
                                        <span class="badge text-bg-success">Disponible</span>
                                    }
                                    else
                                    {
                                        <span class="badge text-bg-light">Sur demande</span>
                                    }
                                    @if (offre.DisponibleEnChallenge)
                                    {
                                        <span class="badge" style="background:var(--cf-orange); color:#fff;">Format Challenge</span>
                                    }
                                    @if (offre.DisponibleEnPresentiel)
                                    {
                                        <span class="badge text-bg-light">Présentiel possible</span>
                                    }
                                </div>
                                <h3 class="cf-formation-title mb-1">@offre.Titre</h3>
                                @if (!string.IsNullOrWhiteSpace(offre.LienAvecOffre))
                                {
                                    <p class="text-muted small mb-2">@offre.LienAvecOffre</p>
                                }
                                <ul class="list-unstyled small mb-3">
                                    <li><strong>Durée :</strong> @offre.Duree</li>
                                    <li><strong>Public :</strong> @offre.Public</li>
                                    @if (!string.IsNullOrWhiteSpace(offre.Financement))
                                    {
                                        <li><strong>Financement :</strong> @offre.Financement</li>
                                    }
                                    <li><strong>Prix :</strong> @offre.Prix</li>
                                </ul>
                                <a href="@offre.UrlAction" class="cf-btn cf-btn-outline mt-auto">@offre.LibelleAction →</a>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }

        <div class="cf-card p-4 mt-4">
            <p class="mb-0">
                Vous ne trouvez pas exactement ce qu'il vous faut, ou vous voulez cadrer une formation sur-mesure ?
                <a asp-controller="Home" asp-action="Contact">Contactez-nous</a> — la plupart de nos formations sont
                conçues à la demande.
            </p>
        </div>
    </div>
</section>

<style>
    .cf-formation-card {
        display: flex;
        flex-direction: column;
        background: #fff;
        border: 1px solid var(--cf-line);
        border-radius: var(--cf-radius-md);
        padding: 18px 20px;
        height: 100%;
    }
    .cf-formation-card .cf-formation-title { font-size: 16px; font-weight: 700; color: var(--cf-dark); }
</style>
