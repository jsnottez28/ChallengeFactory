<!-- parcours mis en avant -->
<section class="cf-section">
    <div class="container">
        <div class="text-center mb-5">
            <span class="cf-eyebrow">Le parcours</span>
            <h2 class="cf-h2 mb-3">Cap Bas Carbone</h2>
            <p class="cf-lead mx-auto" style="max-width:600px;">9 semaines pour passer du bilan carbone à l'action, en équipe.</p>
        </div>
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="cf-card h-100 text-center">
