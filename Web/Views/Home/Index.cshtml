@{
    ViewData["Title"] = "Accueil";

    // Lien de reservation reutilise tel quel depuis Contact.cshtml (meme agenda Google
    // Calendar) - centralise ici pour eviter les divergences entre les boutons de la page.
    const string LienPreDiagnostic = "https://calendar.google.com/calendar/u/0/appointments/schedules/AcZssZ1u9jEGikHh9zntfc83AKshY3SRBsLas_LlZm9v1x2LypnjeaP73YWl4_EDdPWFdEG2aato2wvo";
}

<!-- hero -->
<section class="cf-hero-home">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-xl-8 col-lg-10">
                <span class="cf-badge">Bilan Carbone® + Challenges d'équipe</span>
                <h1 class="cf-h1 mb-4">
                    Mesurez vos émissions.<br>
                    Vos équipes les <span class="cf-accent">réduisent</span>.
                </h1>
                <p class="cf-lead mb-4" style="max-width:620px;">
                    Pour les PME et ETI : Challenges Factory réalise votre <strong>Bilan Carbone®</strong>, puis
                    transforme votre plan de transition en <strong>défis terrain de 9 semaines</strong>. De la
                    mesure à l'action, preuves à l'appui.
                </p>
                <div class="d-flex flex-wrap gap-3 mb-2">
                    <a class="cf-btn cf-btn-primary cf-btn-wrap" href="@LienPreDiagnostic" target="_blank" rel="noopener">
                        📅 Réserver mon pré-diagnostic carbone (30 min)
                    </a>
                    <a class="cf-btn cf-btn-outline" href="#notre-approche">Découvrir la méthode</a>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- /hero -->

<!-- chiffres cles -->
<section class="cf-stats-band">
    <div class="container">
        <div class="cf-stats-grid">
            <div class="cf-stat-item">
                <div class="cf-stat-num">35%</div>
                <div class="cf-stat-label">des PME et ETI françaises avaient évalué leurs émissions carbone en 2023, contre 16 % en 2020</div>
            </div>
            <div class="cf-stat-item">
                <div class="cf-stat-num">500</div>
                <div class="cf-stat-label">salariés : seuil à partir duquel le BEGES est obligatoire pour une ETI (tous les 4 ans, plan de transition inclus)</div>
            </div>
            <div class="cf-stat-item">
                <div class="cf-stat-num">40%</div>
                <div class="cf-stat-label">du Diag Décarbon'Action pris en charge par Bpifrance pour les PME et ETI de moins de 500 salariés</div>
            </div>
        </div>
        <p class="text-center mt-4 mb-0" style="color:rgba(255,255,255,.5);font-size:12px;">
            Source : Bpifrance Le Lab, étude « Décarboner les PME &amp; ETI françaises », avril 2023.
        </p>
    </div>
</section>
<!-- /chiffres cles -->

<!-- le constat -->
<section class="cf-section">
    <div class="container">
        <div class="text-center mb-5">
            <span class="cf-eyebrow">Le constat</span>
            <h2 class="cf-h2 mb-3">Un bilan carbone qui dort dans un tiroir<br>ne réduit rien</h2>
        </div>
        <div class="row g-4">
            <div class="col-md-4">
                <div class="cf-card h-100">
                    <div class="cf-card-icon">📁</div>
                    <h5>Des chiffres que personne ne s'approprie</h5>
                    <p>Le bilan est restitué, puis oublié par les équipes qui font les émissions au quotidien.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="cf-card h-100">
                    <div class="cf-card-icon">🧭</div>
                    <h5>Un plan de transition sans pilote</h5>
                    <p>Les actions sont listées, rarement lancées, encore plus rarement suivies.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="cf-card h-100">
                    <div class="cf-card-icon">📊</div>
                    <h5>Des clients qui demandent des preuves</h5>
                    <p>Donneurs d'ordres, appels d'offres, banques : on vous demande des données et une trajectoire, pas des intentions.</p>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- /le constat -->

<!-- notre approche -->
<section class="cf-section cf-section--grey" id="notre-approche">
    <div class="container">
        <div class="text-center mb-5">
            <span class="cf-eyebrow">Notre approche</span>
            <h2 class="cf-h2 mb-3">De la mesure à l'action, avec vos équipes</h2>
            <p class="cf-lead mx-auto" style="max-width:620px;">Trois étapes pour transformer un constat en trajectoire de décarbonation réellement suivie.</p>
        </div>
        <div class="row g-4">
            <div class="col-md-4">
                <div class="cf-card h-100">
                    <span class="cf-code-tag">01</span>
                    <h5>📏 Mesurer</h5>
                    <p>Bilan Carbone® selon la méthode V9 (cadrage, périmètres, collecte, comptabilisation), avec les facteurs d'émission de la Base Empreinte de l'ADEME.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="cf-card h-100">
                    <span class="cf-code-tag">02</span>
                    <h5>🤝 Mobiliser</h5>
                    <p>La collecte des données devient un défi d'équipe. Plus rapide, et vos équipes sont embarquées dès le départ.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="cf-card h-100">
                    <span class="cf-code-tag">03</span>
                    <h5>⚡ Réduire</h5>
                    <p>Le challenge « Cap Bas Carbone ». Pendant 9 semaines, des équipes par poste d'émission testent des actions, les chiffrent, les font valider par leurs pairs et les présentent à la direction.</p>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- /notre approche -->

<!-- pour qui -->
<section class="cf-section">
    <div class="container">
        <div class="text-center mb-5">
            <span class="cf-eyebrow">Pour qui ?</span>
