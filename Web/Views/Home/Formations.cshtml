@model List<Web.Controllers.FormationViewModel>
@{
    ViewData["Title"] = "Formations";
    ViewData["MetaDescription"] = "Le catalogue des parcours Challenges Factory : Cap Bas Carbone et nos parcours Compétences & IA, en méthode Challenge-Based Learning.";

    var parcoursDecarbonation = Model.Where(c => c.Thematique == Domain.Entities.ThematiqueChallenge.Decarbonation).ToList();
    var parcoursHumain = Model.Where(c => c.Thematique == Domain.Entities.ThematiqueChallenge.HumainEtOrganisation).ToList();
}

<section class="cf-hero-home">
    <div class="container">
        <div class="row">
            <div class="col-xl-9">
                <span class="cf-badge">Nos Challenges</span>
                <h1 class="cf-h1 mb-3">Rejoignez un <span class="cf-accent">Challenge</span>.</h1>
                <p class="cf-lead" style="max-width:640px;">Progressez en faisant, pas en regardant. Deux pistes de parcours : la décarbonation de votre activité, et le savoir-être qui fluidifie les relations pendant la transition.</p>
            </div>
        </div>
    </div>
</section>

<section class="cf-section pt-0">
    <div class="container">
        @if (TempData["StatusMessage"] is string statusMessage && !string.IsNullOrWhiteSpace(statusMessage))
        {
            <div class="alert alert-info alert-dismissible fade show" role="alert">
                @statusMessage
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fermer"></button>
            </div>
        }

        @if (Model.Count == 0)
        {
            <p class="text-muted">Aucun Challenge n'est disponible pour le moment. Revenez bientôt !</p>
        }

        @if (parcoursDecarbonation.Count > 0)
        {
            <div class="mb-5" id="decarbonation">
                <span class="cf-eyebrow">🌱 Décarbonation</span>
                <h2 class="cf-h2 mb-3">Réduire les émissions, en équipe</h2>
                <div class="row g-3">
                    @foreach (var challenge in parcoursDecarbonation)
                    {
                        <partial name="_FormationCard" model="challenge" />
                    }
                </div>
            </div>
        }

        @if (parcoursHumain.Count > 0)
        {
            <div class="@(parcoursDecarbonation.Count > 0 ? "mt-5" : "")" id="humain-organisation">
                <span class="cf-eyebrow cf-eyebrow-indigo">🤝 Humain &amp; Organisation</span>
                <h2 class="cf-h2 mb-3">Mieux vivre les transitions, ensemble</h2>
                <div class="row g-3">
                    @foreach (var challenge in parcoursHumain)
                    {
                        <partial name="_FormationCard" model="challenge" />
                    }
                </div>
            </div>
        }
    </div>
</section>

<style>
    .cf-formation-card {
        display: flex;
        flex-direction: column;
        background: #fff;
        border: 1px solid var(--cf-line);
        border-radius: var(--cf-radius-md);
        padding: 18px 20px;
        height: 100%;
        color: inherit;
        transition: all .2s ease;
    }
    .cf-formation-card:hover { border-color: var(--cf-orange); box-shadow: var(--cf-shadow-md); transform: translateY(-2px); }
    .cf-formation-card--decarbonation { border-left: 4px solid var(--cf-orange); }
    .cf-formation-card--decarbonation:hover { border-color: var(--cf-orange); }
    .cf-formation-card--humain { border-left: 4px solid var(--cf-indigo); }
    .cf-formation-card--humain:hover { border-color: var(--cf-indigo); }
    .cf-formation-title { font-size: 17px; font-weight: 700; color: var(--cf-dark); }
    .cf-formation-cta { font-size: 13px; font-weight: 600; color: var(--cf-orange); }
</style>
