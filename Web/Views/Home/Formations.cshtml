@using Web.Extensions
@model List<Web.Controllers.FormationViewModel>
@{
    ViewData["Title"] = "Formations";
    ViewData["MetaDescription"] = "Le catalogue des parcours Challenges Factory : Cap Bas Carbone et nos parcours Compétences & IA, en méthode Challenge-Based Learning.";

    const string LienPreDiagnostic = "https://calendar.google.com/calendar/u/0/appointments/schedules/AcZssZ1u9jEGikHh9zntfc83AKshY3SRBsLas_LlZm9v1x2LypnjeaP73YWl4_EDdPWFdEG2aato2wvo";

    var parcoursDecarbonation = Model.Where(c => c.Thematique == Domain.Entities.ThematiqueChallenge.Decarbonation).ToList();
    var parcoursHumain = Model.Where(c => c.Thematique == Domain.Entities.ThematiqueChallenge.HumainEtOrganisation).ToList();
    var parcoursManagerEtGraine = parcoursHumain.Where(c => c.SousFamille != Domain.Entities.SousFamilleChallenge.ParticuliersEtReconversion).ToList();
    var parcoursParticuliers = parcoursHumain.Where(c => c.SousFamille == Domain.Entities.SousFamilleChallenge.ParticuliersEtReconversion).ToList();
}

<section class="cf-hero-home">
    <div class="container">
        <div class="row">
            <div class="col-xl-9">
                <span class="cf-badge">Nos Challenges</span>
                <h1 class="cf-h1 mb-3">Rejoignez un <span class="cf-accent">Challenge</span>.</h1>
                <p class="cf-lead" style="max-width:640px;">Progressez en faisant, pas en regardant. Deux pistes de parcours : la décarbonation de votre activité, et le savoir-être qui fluidifie les relations pendant la transition.</p>
            </div>
        </div>
    </div>
</section>

@* "Par où commencer ?" (prompt audit prospection) : un dirigeant de PME face a 47 Challenges
   ne sait pas par ou entrer - ce bloc donne un chemin unique et clair vers le pre-diagnostic,
   avant meme le catalogue filtre. *@
<section class="cf-section pt-0 pb-0">
    <div class="container">
        <div class="cf-formation-demarrage">
            <div class="row align-items-center g-4">
                <div class="col-lg-8">
                    <span class="cf-eyebrow">Par où commencer ?</span>
                    <h2 class="cf-h2 mb-3">Un seul chemin, quatre étapes</h2>
                    <div class="row g-3">
                        <div class="col-6 col-md-3">
                            <div class="cf-process-step">
                                <span class="cf-process-num">1</span>
                                <h6 class="mb-1">🔍 Pré-diagnostic</h6>
                                <p class="text-muted small mb-0">Gratuit, 30 min</p>
                            </div>
                        </div>
                        <div class="col-6 col-md-3">
                            <div class="cf-process-step">
                                <span class="cf-process-num">2</span>
                                <h6 class="mb-1">📊 Bilan Carbone®</h6>
                                <p class="text-muted small mb-0">Vos postes d'émission</p>
                            </div>
                        </div>
                        <div class="col-6 col-md-3">
                            <div class="cf-process-step">
                                <span class="cf-process-num">3</span>
                                <h6 class="mb-1">🎯 Plan d'action</h6>
                                <p class="text-muted small mb-0">Priorités chiffrées</p>
                            </div>
                        </div>
                        <div class="col-6 col-md-3">
                            <div class="cf-process-step">
                                <span class="cf-process-num">4</span>
                                <h6 class="mb-1">⚡ Défi d'équipe</h6>
                                <p class="text-muted small mb-0">Un des Challenges ci-dessous</p>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-lg-4 text-lg-end">
                    <a class="cf-btn cf-btn-primary cf-btn-wrap d-block d-lg-inline-flex mb-2" href="@LienPreDiagnostic" target="_blank" rel="noopener">📅 Cadrer mon Challenge →</a>
                    <p class="text-muted small mb-0">Challenge Cap Bas Carbone à partir de <strong>3 900 € HT</strong> · finançable OPCO · ou <a href="tel:+33699876114">06 99 87 61 14</a></p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- temoignage client (identique a la home, cf. accord 2026-09-11 : rester generique) -->
<section class="cf-section cf-section--grey">
    <div class="container text-center">
        <blockquote class="cf-h3 mb-3" style="max-width:680px;margin:0 auto;">
            « Avant même d'avoir lancé la moindre action, le simple fait de mesurer nous a
            fait avancer. Le travail rendu par Challenges Factory a été à la hauteur de nos
            attentes. »
        </blockquote>
        <p class="text-muted mb-0">Dirigeant — PME du secteur informatique, à propos de son Bilan Carbone®</p>
    </div>
</section>

<section class="cf-section">
    <div class="container">
        @if (TempData["StatusMessage"] is string statusMessage && !string.IsNullOrWhiteSpace(statusMessage))
        {
            <div class="alert alert-info alert-dismissible fade show" role="alert">
                @statusMessage
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fermer"></button>
            </div>
        }

        @if (Model.Count == 0)
        {
            <p class="text-muted">Aucun Challenge n'est disponible pour le moment. Revenez bientôt !</p>
        }
        else
        {
            <div class="row g-2 align-items-end mb-4" id="cf-formations-filtres">
                <div class="col-12 col-md-4">
                    <label for="cf-filtre-thematique" class="form-label small mb-1">Thématique</label>
                    <select id="cf-filtre-thematique" class="form-select form-select-sm">
                        <option value="">Toutes les thématiques</option>
                        <option value="Decarbonation">🌱 Décarbonation</option>
                        <option value="HumainEtOrganisation">🤝 Humain &amp; Organisation</option>
                    </select>
                </div>
                <div class="col-12 col-md-4">
                    <label for="cf-filtre-sousfamille" class="form-label small mb-1">Catégorie</label>
                    <select id="cf-filtre-sousfamille" class="form-select form-select-sm">
                        <option value="">Toutes les catégories</option>
                        @foreach (var valeur in Enum.GetValues<Domain.Entities.SousFamilleChallenge>())
                        {
                            <option value="@valeur">@valeur.Libelle()</option>
                        }
                    </select>
                </div>
                <div class="col-12 col-md-4">
                    <label for="cf-filtre-recherche" class="form-label small mb-1">Rechercher</label>
                    <input type="search" id="cf-filtre-recherche" class="form-control form-control-sm" placeholder="Titre, public visé...">
                </div>
            </div>

            <p id="cf-formations-aucun-resultat" class="text-muted" style="display:none;">Aucune formation ne correspond à ces critères.</p>
        }

        @if (parcoursDecarbonation.Count > 0)
        {
            <div class="mb-5" id="decarbonation" data-cf-section>
                <span class="cf-eyebrow">🌱 Décarbonation</span>
                <h2 class="cf-h2 mb-3">Réduire les émissions, en équipe</h2>
                <div class="row g-3">
                    @foreach (var challenge in parcoursDecarbonation)
                    {
                        <partial name="_FormationCard" model="challenge" />
                    }
                </div>
            </div>
        }

        @if (parcoursManagerEtGraine.Count > 0)
        {
            <div class="@(parcoursDecarbonation.Count > 0 ? "mt-5" : "")" id="humain-organisation" data-cf-section>
                <span class="cf-eyebrow cf-eyebrow-indigo">🤝 Humain &amp; Organisation</span>
                <h2 class="cf-h2 mb-3">Mieux vivre les transitions, ensemble</h2>
                <div class="row g-3">
                    @foreach (var challenge in parcoursManagerEtGraine)
                    {
                        <partial name="_FormationCard" model="challenge" />
                    }
                </div>
            </div>
        }

        @* Cible distincte (particuliers/reconversion, hors B2B) : separee visuellement en fin
           de page plutot que melangee aux Challenges entreprise, cf. prompt audit prospection
           ("cibles melangees"). *@
        @if (parcoursParticuliers.Count > 0)
        {
            <div class="mt-5" id="particuliers" data-cf-section>
                <span class="cf-eyebrow">🌱 Pour les particuliers</span>
                <h2 class="cf-h2 mb-3">Reconversion vers les métiers de la transition</h2>
                <p class="cf-lead mb-4" style="max-width:640px;">Vous êtes salarié, demandeur d'emploi ou étudiant : ces parcours s'adressent à vous à titre individuel, pas à votre entreprise.</p>
                <div class="row g-3">
                    @foreach (var challenge in parcoursParticuliers)
                    {
                        <partial name="_FormationCard" model="challenge" />
                    }
                </div>
            </div>
        }
    </div>
</section>

@if (Model.Count > 0)
{
    <script>
        (function () {
            var selectThematique = document.getElementById('cf-filtre-thematique');
            var selectSousFamille = document.getElementById('cf-filtre-sousfamille');
            var champRecherche = document.getElementById('cf-filtre-recherche');
            var aucunResultat = document.getElementById('cf-formations-aucun-resultat');
            var colonnes = Array.prototype.slice.call(document.querySelectorAll('.cf-formation-col'));
            var sections = Array.prototype.slice.call(document.querySelectorAll('[data-cf-section]'));

            function appliquerFiltres() {
                var thematique = selectThematique.value;
                var sousFamille = selectSousFamille.value;
                var recherche = champRecherche.value.trim().toLowerCase();
                var visibles = 0;

                colonnes.forEach(function (colonne) {
                    var correspond = (!thematique || colonne.dataset.thematique === thematique)
                        && (!sousFamille || colonne.dataset.sousfamille === sousFamille)
                        && (!recherche || colonne.dataset.recherche.indexOf(recherche) !== -1);
                    colonne.style.display = correspond ? '' : 'none';
                    if (correspond) { visibles++; }
                });

                sections.forEach(function (section) {
                    var aUneCarteVisible = Array.prototype.slice.call(section.querySelectorAll('.cf-formation-col'))
                        .some(function (colonne) { return colonne.style.display !== 'none'; });
                    section.style.display = aUneCarteVisible ? '' : 'none';
                });

                aucunResultat.style.display = visibles === 0 ? '' : 'none';
            }

            [selectThematique, selectSousFamille].forEach(function (el) { el.addEventListener('change', appliquerFiltres); });
            champRecherche.addEventListener('input', appliquerFiltres);
        })();
    </script>
}

<style>
    .cf-formation-card {
        display: flex;
        flex-direction: column;
        background: #fff;
        border: 1px solid var(--cf-line);
        border-radius: var(--cf-radius-md);
        padding: 18px 20px;
        height: 100%;
        color: inherit;
        transition: all .2s ease;
    }
    .cf-formation-card:hover { border-color: var(--cf-orange); box-shadow: var(--cf-shadow-md); transform: translateY(-2px); }
    .cf-formation-card--decarbonation { border-left: 4px solid var(--cf-orange); }
    .cf-formation-card--decarbonation:hover { border-color: var(--cf-orange); }
    .cf-formation-card--humain { border-left: 4px solid var(--cf-indigo); }
    .cf-formation-card--humain:hover { border-color: var(--cf-indigo); }
    .cf-formation-title { font-size: 17px; font-weight: 700; color: var(--cf-dark); }
    .cf-formation-cta { font-size: 13px; font-weight: 600; color: var(--cf-orange); }
    .cf-formation-demarrage {
        background: var(--cf-grey-100);
        border-radius: var(--cf-radius-lg);
        padding: 32px;
    }
</style>
