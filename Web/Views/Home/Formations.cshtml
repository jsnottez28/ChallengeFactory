@model List<Web.Controllers.FormationViewModel>
@{
    ViewData["Title"] = "Formations";
}

<section class="cf-hero-home">
    <div class="container">
        <div class="row">
            <div class="col-xl-9">
                <span class="cf-badge">Nos Challenges</span>
                <h1 class="cf-h1 mb-3">Rejoignez un <span class="cf-accent">Challenge</span>.</h1>
                <p class="cf-lead" style="max-width:640px;">Progressez en faisant, pas en regardant. Choisissez un Challenge et rejoignez une session ouverte, ou demandez à en ouvrir une.</p>
            </div>
        </div>
    </div>
</section>

<section class="cf-section pt-0">
    <div class="container">
        @if (TempData["StatusMessage"] is string statusMessage && !string.IsNullOrWhiteSpace(statusMessage))
        {
            <div class="alert alert-info alert-dismissible fade show" role="alert">
                @statusMessage
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fermer"></button>
            </div>
        }

        @if (Model.Count == 0)
        {
            <p class="text-muted">Aucun Challenge n'est disponible pour le moment. Revenez bientôt !</p>
        }
        else
        {
            <div class="row g-4">
                @foreach (var challenge in Model)
                {
                    <div class="col-12 col-md-6 col-xl-4">
                        <div class="cf-card cf-formation-card h-100 d-flex flex-column">
                            <h3 class="cf-h3 mb-1">@challenge.Titre</h3>
                            @if (!string.IsNullOrWhiteSpace(challenge.Slogan))
                            {
                                <p class="text-muted small mb-2">@challenge.Slogan</p>
                            }
                            @if (!string.IsNullOrWhiteSpace(challenge.Description))
                            {
                                var description = challenge.Description.Length > 140 ? challenge.Description[..140] + "…" : challenge.Description;
                                <p class="small mb-2">@description</p>
                            }
                            <p class="small text-muted mb-3"><strong class="text-dark">@challenge.NombreEtapes</strong> étapes</p>

                            @if (challenge.CohortesOuvertes.Count > 0)
                            {
                                <div class="mt-auto d-flex flex-column gap-2">
                                    @foreach (var cohorte in challenge.CohortesOuvertes)
                                    {
                                        <form method="post" asp-controller="Home" asp-action="InscriptionFormation" asp-route-cohorteId="@cohorte.Id">
                                            @Html.AntiForgeryToken()
                                            <div class="d-flex align-items-center justify-content-between gap-2 border rounded p-2">
                                                <span class="small">
                                                    @cohorte.Nom
                                                    @if (cohorte.DateLancement.HasValue)
                                                    {
                                                        <span class="text-muted d-block">Lancement le @cohorte.DateLancement.Value.ToString("dd/MM/yyyy")</span>
                                                    }
                                                </span>
                                                <button type="submit" class="cf-btn cf-btn-primary flex-shrink-0">S'inscrire</button>
                                            </div>
                                        </form>
                                    }
                                </div>
                            }
                            else
                            {
                                <form method="post" asp-controller="Home" asp-action="DemanderEmbarquement" asp-route-challengeId="@challenge.ChallengeId" class="mt-auto">
                                    @Html.AntiForgeryToken()
                                    <p class="text-muted small mb-2">Aucune session ouverte pour ce Challenge pour le moment.</p>
                                    <button type="submit" class="cf-btn cf-btn-outline w-100">Demander un embarquement</button>
                                </form>
                            }
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</section>

<style>
    .cf-formation-card { padding: 24px; }
    .cf-formation-card .cf-h3 { font-size: 20px; }
</style>
