@model List<Web.Controllers.FormationViewModel>
@{
    ViewData["Title"] = "Formations";
}

<section class="cf-hero-home">
    <div class="container">
        <div class="row">
            <div class="col-xl-9">
                <span class="cf-badge">Nos Challenges</span>
                <h1 class="cf-h1 mb-3">Rejoignez un <span class="cf-accent">Challenge</span>.</h1>
                <p class="cf-lead" style="max-width:640px;">Progressez en faisant, pas en regardant. Choisissez un Challenge et rejoignez une session ouverte, ou demandez à en ouvrir une.</p>
            </div>
        </div>
    </div>
</section>

<section class="cf-section pt-0">
    <div class="container">
        @if (TempData["StatusMessage"] is string statusMessage && !string.IsNullOrWhiteSpace(statusMessage))
        {
            <div class="alert alert-info alert-dismissible fade show" role="alert">
                @statusMessage
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fermer"></button>
            </div>
        }

        @if (Model.Count == 0)
        {
            <p class="text-muted">Aucun Challenge n'est disponible pour le moment. Revenez bientôt !</p>
        }
        else
        {
            <div class="row g-3">
                @foreach (var challenge in Model)
                {
                    <div class="col-12 col-md-6 col-xl-4">
                        <a asp-controller="Home" asp-action="Formation" asp-route-challengeId="@challenge.ChallengeId" class="cf-formation-card d-block h-100 text-decoration-none">
                            <h3 class="cf-formation-title mb-1">@challenge.Titre</h3>
                            @if (!string.IsNullOrWhiteSpace(challenge.Slogan))
                            {
                                <p class="text-muted small mb-2">@challenge.Slogan</p>
                            }
                            @if (!string.IsNullOrWhiteSpace(challenge.DescriptionExtrait))
                            {
                                <p class="small mb-2">@challenge.DescriptionExtrait</p>
                            }
                            <div class="d-flex align-items-center justify-content-between mt-auto pt-2">
                                <span class="badge @(challenge.NombreCohortesOuvertes > 0 ? "text-bg-success" : "text-bg-light")">
                                    @(challenge.NombreCohortesOuvertes > 0
                                        ? $"{challenge.NombreCohortesOuvertes} session{(challenge.NombreCohortesOuvertes > 1 ? "s" : "")} en cours"
                                        : "Aucune session ouverte")
                                </span>
                                <span class="cf-formation-cta">Découvrir →</span>
                            </div>
                        </a>
                    </div>
                }
            </div>
        }
    </div>
</section>

<style>
    .cf-formation-card {
        display: flex;
        flex-direction: column;
        background: #fff;
        border: 1px solid var(--cf-line);
        border-radius: var(--cf-radius-md);
        padding: 18px 20px;
        height: 100%;
        color: inherit;
        transition: all .2s ease;
    }
    .cf-formation-card:hover { border-color: var(--cf-orange); box-shadow: var(--cf-shadow-md); transform: translateY(-2px); }
    .cf-formation-title { font-size: 17px; font-weight: 700; color: var(--cf-dark); }
    .cf-formation-cta { font-size: 13px; font-weight: 600; color: var(--cf-orange); }
</style>
