@model List<Application.Common.Interfaces.CohorteResume>
@{
    ViewData["Title"] = "Formations";
}

<section class="py-5">
    <div class="container">
        <div class="mb-5">
            <h1 class="mb-2">Nos sessions ouvertes aux inscriptions</h1>
            <p class="text-muted">Rejoignez une Cohorte et progressez en faisant, pas en regardant.</p>
        </div>

        @if (TempData["StatusMessage"] is string statusMessage && !string.IsNullOrWhiteSpace(statusMessage))
        {
            <div class="alert alert-info alert-dismissible fade show" role="alert">
                @statusMessage
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fermer"></button>
            </div>
        }

        @if (Model.Count == 0)
        {
            <p class="text-muted">Aucune session n'est ouverte aux inscriptions pour le moment. Revenez bientôt !</p>
        }
        else
        {
            <div class="row g-4">
                @foreach (var cohorte in Model)
                {
                    <div class="col-12 col-md-6 col-lg-4">
                        <div class="border rounded p-4 h-100 d-flex flex-column shadow-sm">
                            <h2 class="h5 mb-1">@cohorte.ChallengeTitre</h2>
                            <p class="text-muted mb-2">@cohorte.Nom</p>
                            <p class="mb-1"><strong>@cohorte.NombreEtapes</strong> étapes</p>
                            @if (cohorte.DateLancement.HasValue)
                            {
                                <p class="text-muted small mb-3">Lancement prévu le @cohorte.DateLancement.Value.ToString("dd/MM/yyyy")</p>
                            }
                            <form method="post" asp-controller="Home" asp-action="InscriptionFormation" asp-route-cohorteId="@cohorte.Id" class="mt-auto">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="cf-btn cf-btn-primary w-100">S'inscrire à cette session</button>
                            </form>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</section>
