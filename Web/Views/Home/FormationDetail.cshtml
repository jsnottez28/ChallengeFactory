@using Web.Extensions
@model Web.Controllers.FormationDetailViewModel
@{
    ViewData["Title"] = Model.Titre;
}

<section class="cf-hero-home">
    <div class="container">
        <div class="row">
            <div class="col-xl-9">
                <a asp-controller="Home" asp-action="Formations" class="cf-badge text-decoration-none">← Tous les Challenges</a>
                <div class="mt-3">
                    <span class="cf-track-badge @(Model.Thematique == Domain.Entities.ThematiqueChallenge.Decarbonation ? "cf-track-decarbonation" : "cf-track-humain")">
                        @(Model.Thematique == Domain.Entities.ThematiqueChallenge.Decarbonation ? "🌱 Décarbonation" : "🤝 Humain & Organisation")
                    </span>
                    @if (Model.SousFamille.HasValue)
                    {
                        <span class="badge text-bg-light">@Model.SousFamille.Value.Libelle()</span>
                    }
                    @if (Model.DisponibleEnPresentiel)
                    {
                        <span class="badge text-bg-light">Présentiel possible</span>
                    }
                </div>
                <h1 class="cf-h1 mb-2 mt-3" style="font-size:clamp(34px,4.5vw,52px);">@Model.Titre</h1>
                @if (!string.IsNullOrWhiteSpace(Model.Slogan))
                {
                    <p class="cf-lead cf-formation-slogan @(Model.Thematique == Domain.Entities.ThematiqueChallenge.Decarbonation ? "cf-formation-slogan--decarbonation" : "cf-formation-slogan--humain")" style="max-width:640px;">@Model.Slogan</p>
                }
            </div>
        </div>
    </div>
</section>

<section class="cf-section pt-0">
    <div class="container">
        @if (TempData["StatusMessage"] is string statusMessage && !string.IsNullOrWhiteSpace(statusMessage))
        {
            <div class="alert alert-info alert-dismissible fade show" role="alert">
                @statusMessage
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fermer"></button>
            </div>
        }

        <div class="row g-4">
            <div class="col-12 col-lg-7">
                @if (!string.IsNullOrWhiteSpace(Model.Description))
                {
                    <div class="cf-formation-description mb-4">
                        @Html.Raw(Model.Description)
                    </div>
                }

                @if (Model.Etapes.Count > 0)
                {
                    <h2 class="cf-h3 mb-3">Le programme</h2>
                    <ol class="cf-formation-programme list-unstyled mb-4">
                        @foreach (var etape in Model.Etapes)
                        {
                            <li class="d-flex gap-3 mb-3">
                                <span class="cf-formation-numero flex-shrink-0">@etape.NumeroEtape</span>
                                <div>
                                    <h3 class="h6 mb-1">@etape.TitreEtape</h3>
                                    @if (!string.IsNullOrWhiteSpace(etape.ObjectifPedagogique))
                                    {
                                        <p class="text-muted small mb-0">@etape.ObjectifPedagogique</p>
                                    }
                                </div>
                            </li>
                        }
                    </ol>
                }

                <div class="cf-formation-qualiopi-bloc">
                    <h2 class="cf-h3 mb-3">Évaluation des acquis</h2>
                    <p class="text-muted small mb-0">
                        Pas de QCM : chaque étape se valide par le dépôt d'une <strong>preuve d'action</strong> réalisée sur le terrain
                        (photo, vidéo, témoignage écrit ou capture d'écran), vérifiée par les pairs de la cohorte, un Tuteur Master ou,
                        sur les points sensibles, un Coach Challenges Factory — c'est toujours un humain qui valide, jamais l'IA seule.
                    </p>
                </div>
            </div>

            <div class="col-12 col-lg-5">
                @if (!string.IsNullOrWhiteSpace(Model.Duree) || !string.IsNullOrWhiteSpace(Model.PublicVise) || !string.IsNullOrWhiteSpace(Model.Prix) || !string.IsNullOrWhiteSpace(Model.Financement) || !string.IsNullOrWhiteSpace(Model.Prerequis))
                {
                    <div class="cf-card cf-card-auto mb-4">
                        <h2 class="cf-h3 mb-3">En pratique</h2>
                        <ul class="list-unstyled small mb-0">
                            @if (!string.IsNullOrWhiteSpace(Model.Duree))
                            {
                                <li class="mb-2"><strong>Durée :</strong> @Model.Duree</li>
                            }
                            @if (!string.IsNullOrWhiteSpace(Model.PublicVise))
                            {
                                <li class="mb-2"><strong>Public visé :</strong> @Model.PublicVise</li>
                            }
                            <li class="mb-2"><strong>Prérequis :</strong> @(string.IsNullOrWhiteSpace(Model.Prerequis) ? "Aucun prérequis" : Model.Prerequis)</li>
                            <li class="mb-2">
                                <strong>Modalités pédagogiques :</strong>
                                Challenge-Based Learning à distance, action sur le terrain et accompagnement par cohorte
                                @(Model.DisponibleEnPresentiel ? " (présentiel également possible)" : "").
                            </li>
                            @if (!string.IsNullOrWhiteSpace(Model.Financement))
                            {
                                <li class="mb-2"><strong>Financement :</strong> @Model.Financement</li>
                            }
                            @if (!string.IsNullOrWhiteSpace(Model.Prix))
                            {
                                <li class="mb-2"><strong>Prix :</strong> @Model.Prix</li>
                            }
                            <li class="mb-0">
                                <strong>Accessibilité :</strong>
                                <a asp-controller="Home" asp-action="Accessibilite">conditions d'accès pour les personnes en situation de handicap</a>.
                            </li>
                        </ul>
                    </div>
                }

                <div class="cf-card cf-card-auto">
                    <h2 class="cf-h3 mb-3">Rejoindre ce Challenge</h2>

                    @if (Model.CohortesOuvertes.Count > 0)
                    {
                        <div class="d-flex flex-column gap-2">
                            @foreach (var cohorte in Model.CohortesOuvertes)
                            {
                                <form method="post" asp-controller="Home" asp-action="InscriptionFormation" asp-route-cohorteId="@cohorte.Id">
                                    @Html.AntiForgeryToken()
                                    <div class="d-flex align-items-center justify-content-between gap-2 border rounded p-3">
                                        <span class="small">
                                            @cohorte.Nom
                                            @if (cohorte.DateLancement.HasValue)
                                            {
                                                <span class="text-muted d-block">Lancement le @cohorte.DateLancement.Value.ToString("dd/MM/yyyy")</span>
                                            }
                                        </span>
                                        <button type="submit" class="cf-btn cf-btn-primary flex-shrink-0">S'inscrire</button>
                                    </div>
                                </form>
                            }
                        </div>
                    }
                    else
                    {
                        <form method="post" asp-controller="Home" asp-action="DemanderEmbarquement" asp-route-challengeId="@Model.ChallengeId">
                            @Html.AntiForgeryToken()
                            <p class="text-muted small mb-3">Disponible en intra-entreprise, aux dates qui vous conviennent — ou rejoignez la prochaine session ouverte.</p>
                            <button type="submit" class="cf-btn cf-btn-outline cf-btn-wrap w-100 justify-content-center text-center">Être recontacté pour ce Challenge</button>
                        </form>
                    }
                </div>
            </div>
        </div>
    </div>
</section>

<style>
    /* .cf-btn-wrap (correctif nowrap) est desormais centralise dans
       brand-challenges-factory.css - reutilise directement, plus de duplication ici. */
    .cf-formation-description p { margin-bottom: 14px; }
    .cf-formation-description ul, .cf-formation-description ol { margin-bottom: 14px; padding-left: 20px; }
    .cf-formation-description li { margin-bottom: 6px; }
    .cf-formation-numero {
        width: 32px; height: 32px;
        background: var(--cf-orange-pale);
        color: var(--cf-orange);
        border-radius: 50%;
        display: flex; align-items: center; justify-content: center;
        font-weight: 700; font-size: 14px;
    }
    /* Sous-titre colore sur la piste du Challenge (meme code couleur que le badge
       Decarbonation/Humain au-dessus) : le titre lui-meme reste noir, conformement a la
       charte (hero en noir, orange reserve aux accents) - cf. CLAUDE.md charte graphique. */
    .cf-formation-slogan { font-weight: 600; font-size: 19px; }
    .cf-formation-slogan--decarbonation { color: var(--cf-orange); }
    .cf-formation-slogan--humain { color: var(--cf-indigo); }
    /* .cf-card force height:100% (prevu pour une seule carte par colonne de grille) : sur
       cette page, deux cartes sont empilees verticalement dans la meme colonne, chacune
       essayant alors de prendre 100% de la hauteur de la colonne -> debordement visuel sur
       le contenu suivant (pied de page). .cf-card-auto neutralise la hauteur sans toucher a
       la classe globale, utilisee telle quelle ailleurs sur le site pour de vraies grilles. */
    .cf-card-auto { height: auto; }
    .cf-formation-qualiopi-bloc {
        background: var(--cf-grey-100);
        border-radius: var(--cf-radius-md);
        padding: 24px;
    }
</style>
