@{
    ViewData["Title"] = "Bilan de compétences — Transition écologique";

    const string LienPreDiagnostic = "https://calendar.google.com/calendar/u/0/appointments/schedules/AcZssZ1u9jEGikHh9zntfc83AKshY3SRBsLas_LlZm9v1x2LypnjeaP73YWl4_EDdPWFdEG2aato2wvo";
}

<!-- hero -->
<section class="cf-hero-home">
    <div class="container">
        <div class="row">
            <div class="col-xl-9">
                <span class="cf-badge">Bilan de compétences</span>
                <h1 class="cf-h1 mb-3">Se réorienter vers un métier<br>de la <span class="cf-accent">transition écologique</span>.</h1>
                <p class="cf-lead mb-4" style="max-width:640px;">
                    Un bilan de compétences pour faire le point sur votre parcours et construire un projet
                    professionnel réaliste vers un métier lié à la décarbonation et à la transition écologique.
                </p>
                <a class="cf-btn cf-btn-primary cf-btn-wrap" href="@LienPreDiagnostic" target="_blank" rel="noopener">
                    📅 Échanger sur mon projet (30 min)
                </a>
            </div>
        </div>
    </div>
</section>
<!-- /hero -->

<!-- qu'est-ce que c'est -->
<section class="cf-section">
    <div class="container">
        <div class="row g-5 align-items-start">
            <div class="col-lg-6">
                <span class="cf-eyebrow">Le dispositif</span>
                <h2 class="cf-h2 mb-3">Qu'est-ce qu'un bilan de compétences ?</h2>
                <p class="mb-3">
                    Le bilan de compétences est un dispositif encadré par le Code du travail (article
                    L6313-4). Il permet d'analyser vos compétences professionnelles et personnelles, ainsi
                    que vos aptitudes et motivations, afin de définir un projet professionnel et, le cas
                    échéant, un projet de formation — dans la limite légale de 24 heures d'accompagnement.
                </p>
                <p class="mb-0">
                    Le nôtre combine des séances accompagnées et 8 heures de travail en autonomie guidé
                    entre les rendez-vous. Il se conclut par une feuille de route opérationnelle : vos
                    prochaines étapes, vos leviers d'action et votre cap professionnel vers un métier de la
                    transition écologique.
                </p>
            </div>
            <div class="col-lg-6">
                <div class="cf-card">
                    <h5 class="mb-3">Notre méthode, en 3 phases</h5>
                    <ul class="list-unstyled mb-0">
                        <li class="mb-3"><strong style="color:var(--cf-orange);">1. Anticiper</strong> — identifier les opportunités qui émergent sur le marché de la transition écologique.</li>
                        <li class="mb-3"><strong style="color:var(--cf-orange);">2. Révéler</strong> — objectiver vos compétences et vos soft skills (créativité, leadership, pensée critique...) au regard de ces opportunités.</li>
                        <li><strong style="color:var(--cf-orange);">3. Agir</strong> — construire un plan d'action concret, formalisé dans votre feuille de route.</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- /qu'est-ce que c'est -->

<!-- notre angle -->
<section class="cf-section cf-section--grey">
    <div class="container">
        <div class="text-center mb-5">
            <span class="cf-eyebrow">Notre différence</span>
            <h2 class="cf-h2 mb-3">Un bilan adossé à une vraie expertise terrain</h2>
            <p class="cf-lead mx-auto" style="max-width:640px;">
                La plupart des bilans de compétences reposent sur des tests et des entretiens. Le nôtre
                s'appuie en plus sur notre expérience concrète du terrain de la décarbonation.
            </p>
        </div>
        <div class="row g-4">
            <div class="col-md-4">
                <div class="cf-card h-100">
                    <div class="cf-card-icon">🌍</div>
                    <h5>On connaît les métiers, pas seulement la théorie</h5>
                    <p class="mb-0">Nous réalisons nous-mêmes des Bilans Carbone® et accompagnons des équipes en décarbonation — nous savons concrètement quelles compétences ces métiers demandent.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="cf-card h-100">
                    <div class="cf-card-icon">🎯</div>
                    <h5>Un projet réaliste, pas un vœu pieux</h5>
                    <p class="mb-0">Le plan d'action final tient compte de la réalité du marché de l'emploi de la transition écologique, pas seulement de vos envies.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="cf-card h-100">
                    <div class="cf-card-icon">🤝</div>
                    <h5>La même exigence de preuve</h5>
                    <p class="mb-0">Comme dans nos Challenges, nous privilégions les preuves concrètes (mises en situation, contacts terrain) aux seuls tests de personnalité.</p>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- /notre angle -->

<!-- pour qui -->
<section class="cf-section">
    <div class="container">
        <div class="text-center mb-5">
            <span class="cf-eyebrow">Pour qui ?</span>
            <h2 class="cf-h2">Vous vous reconnaissez dans l'une de ces situations ?</h2>
        </div>
        <div class="row g-4">
            <div class="col-md-4">
                <div class="cf-card h-100">
                    <p class="mb-0">Vous êtes salarié·e et souhaitez donner du sens à votre carrière en rejoignant un métier de la transition écologique.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="cf-card h-100">
                    <p class="mb-0">Votre entreprise engage sa décarbonation et vous vous demandez si un métier interne dédié à ce sujet pourrait vous correspondre.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="cf-card h-100">
                    <p class="mb-0">Vous êtes en recherche d'emploi ou en reconversion et voulez cibler un secteur porteur, sans savoir par où commencer.</p>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- /pour qui -->

<!-- financement -->
<section class="cf-section cf-section--grey">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-8 text-center">
                <span class="cf-eyebrow">Financement</span>
                <h2 class="cf-h2 mb-3">100 % finançable par votre CPF</h2>
                <p class="mb-2">
                    Notre accompagnement est intégralement pris en charge par votre CPF (Compte Personnel de
                    Formation), que vous mobilisez directement — sans avance de frais à demander à votre
                    employeur. Une participation forfaitaire de 100 € reste à votre charge, fixée par l'État
                    pour toute mobilisation du CPF.
                </p>
                <p class="mb-2">
                    Il peut aussi être pris en charge sur fonds propres, par votre employeur (OPCO, plan de
                    développement des compétences), ou par France Travail si vous êtes en recherche d'emploi.
                </p>
                <p class="text-muted small mb-0">
                    [À CONFIRMER] Tarif de notre accompagnement — à préciser avant mise en ligne définitive.
                </p>
            </div>
        </div>
    </div>
</section>
<!-- /financement -->

<!-- cta final -->
<section class="cf-section">
    <div class="container">
        <div class="cf-cta-band">
            <h2 class="cf-h2 mb-3" style="color:#fff;">Prêt à faire le point sur votre parcours ?</h2>
            <p class="mb-4" style="color:rgba(255,255,255,.65);">En 30 minutes, parlons de votre situation et de la meilleure façon d'avancer.</p>
            <a class="cf-btn cf-btn-primary cf-btn-wrap" href="@LienPreDiagnostic" target="_blank" rel="noopener">
                📅 Échanger sur mon projet (30 min)
            </a>
        </div>
    </div>
</section>
<!-- /cta final -->
