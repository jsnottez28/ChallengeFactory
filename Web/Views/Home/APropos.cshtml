@{
    ViewData["Title"] = "À propos";
}

<section class="cf-hero-home">
    <div class="container">
        <div class="row">
            <div class="col-xl-9">
                <span class="cf-badge">Depuis 2018</span>
                <h1 class="cf-h1 mb-3">L'équipe qui réinvente <span class="cf-accent">la formation</span>.</h1>
                <p class="cf-lead" style="max-width:640px;">
                    Une alliance rare de 4 experts seniors maîtrisant 100 % de la chaîne de valeur — pédagogie,
                    tech, psychologie et qualité.
                </p>
            </div>
        </div>
    </div>
</section>

<section class="cf-section">
    <div class="container">
        <div class="row g-5 align-items-start">
            <div class="col-lg-7">
                <span class="cf-eyebrow">Notre histoire</span>
                <h2 class="cf-h2 mb-4">De la lassitude des diaporamas à la révolution CBL</h2>
                <p class="mb-3">
                    L'histoire commence en 2018, directement sur le terrain. En animant des formations, nous
                    observons une lassitude généralisée : les stagiaires ne tolèrent plus de longues sessions
                    passées passivement devant des diapositives. Le verdict est sans appel — le modèle descendant
                    et scolaire est devenu contre-productif.
                </p>
                <p class="mb-3">
                    En 2019, nous initions une réflexion technique approfondie sur un moteur de règles orienté
                    coaching et analysons les catalogues des acteurs majeurs. La conclusion est claire : une
                    standardisation excessive masquant une absence totale d'innovation pédagogique.
                </p>
                <p class="mb-0">
                    De ces constats naît la conviction fondatrice : <em>« on n'apprend jamais mieux qu'en
                    résolvant ensemble un problème réel. »</em> Challenges Factory est construit sur cette vérité.
                </p>
            </div>
            <div class="col-lg-5">
                <div class="cf-card">
                    <h5 class="mb-3">Notre chronologie</h5>
                    <ul class="list-unstyled mb-0">
                        <li class="mb-3"><strong class="text-nowrap" style="color:var(--cf-orange);">2018</strong> — Premiers constats terrain. La formation classique montre ses limites.</li>
                        <li class="mb-3"><strong style="color:var(--cf-orange);">2019</strong> — Recherche &amp; développement de la méthode. Architecture des Cartes Apprenantes.</li>
                        <li class="mb-3"><strong style="color:var(--cf-orange);">2022–2024</strong> — Validation terrain : cas Sigebene (ancrage mémoriel), cas Novéocarte (dynamique de groupe).</li>
                        <li><strong style="color:var(--cf-orange);">2026</strong> — Lancement commercial officiel. Certification Qualiopi. Plateforme SaaS.</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="cf-stats-band">
    <div class="container">
        <p class="text-center mb-4" style="color:rgba(255,255,255,.6);letter-spacing:.15em;text-transform:uppercase;font-size:13px;">🏭 7 ans de terrain</p>
        <div class="cf-stats-grid" style="grid-template-columns:repeat(4,1fr);">
            <div class="cf-stat-item">
                <div class="cf-stat-num">2018</div>
                <div class="cf-stat-label">année de fondation</div>
            </div>
            <div class="cf-stat-item">
                <div class="cf-stat-num">4</div>
                <div class="cf-stat-label">experts fondateurs complémentaires</div>
            </div>
            <div class="cf-stat-item">
                <div class="cf-stat-num">17</div>
                <div class="cf-stat-label">ans d'expérience pédagogique terrain</div>
            </div>
            <div class="cf-stat-item">
                <div class="cf-stat-num">100%</div>
                <div class="cf-stat-label">chaîne de valeur maîtrisée en interne</div>
            </div>
        </div>
    </div>
</section>

