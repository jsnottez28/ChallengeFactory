@model List<Domain.Entities.Ressource>
@{
    ViewData["Title"] = "Ressources";
}

<section class="backend-page">
    <div class="container-fluid">
        <nav aria-label="breadcrumb" class="mb-3">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a asp-page="/Dashboard/Index">Accueil</a></li>
                <li class="breadcrumb-item"><a asp-page="/Admin/Index">Administration</a></li>
                <li class="breadcrumb-item active" aria-current="page">Ressources</li>
            </ol>
        </nav>

        @if (TempData["StatusMessage"] is string statusMessage && !string.IsNullOrWhiteSpace(statusMessage))
        {
            <div class="alert alert-info alert-dismissible fade show" role="alert">
                @statusMessage
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fermer"></button>
            </div>
        }

        <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
            <div>
                <p class="text-muted mb-1">Administration</p>
                <h1 class="h3 mb-0">Ressources</h1>
            </div>
            <droit-visible code="RESSOURCE.CREER">
                <a asp-controller="Ressources" asp-action="Create" class="btn btn-primary">Ajouter une ressource</a>
            </droit-visible>
        </div>

        <div class="card border-0 shadow-sm">
            <div class="card-body p-4">
                <h2 class="h5 mb-3">Fonctions applicatives</h2>
                <p class="text-muted mb-4">Une ressource represente une fonction applicative (ex: Formation, Commande) sur laquelle des droits peuvent etre definis.</p>

                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <thead>
                            <tr>
                                <th scope="col">Code</th>
                                <th scope="col">Libelle</th>
                                <th scope="col">Description</th>
                                <th scope="col" class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Count == 0)
                            {
                                <tr>
                                    <td colspan="4" class="text-muted text-center py-4">Aucune ressource enregistree pour le moment.</td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var ressource in Model)
                                {
                                    <tr>
                                        <td><code>@ressource.Code</code></td>
                                        <td class="fw-semibold">@ressource.Libelle</td>
                                        <td class="text-muted">@(ressource.Description ?? "-")</td>
                                        <td class="text-end">
                                            <div class="d-inline-flex gap-2">
                                                <droit-visible code="RESSOURCE.MODIFIER">
                                                    <a asp-controller="Ressources" asp-action="Edit" asp-route-id="@ressource.Id" class="btn btn-sm btn-outline-secondary">Modifier</a>
                                                </droit-visible>
                                                <droit-visible code="RESSOURCE.SUPPRIMER">
                                                    <form method="post" asp-controller="Ressources" asp-action="Delete" asp-route-id="@ressource.Id" onsubmit="return confirm('Supprimer cette ressource ?');">
                                                        <button type="submit" class="btn btn-sm btn-outline-danger">Supprimer</button>
                                                    </form>
                                                </droit-visible>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</section>
