@using Domain.Entities
@using Web.Extensions
@model List<DocumentLegal>
@{
    var type = (TypeDocumentLegal)ViewBag.Type;
    ViewData["Title"] = $"Historique - {type.Libelle()}";
}

<section class="backend-page">
    <div class="container-fluid">
        <nav aria-label="breadcrumb" class="mb-3">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a asp-page="/Dashboard/Index">Accueil</a></li>
                <li class="breadcrumb-item"><a asp-page="/Admin/Index">Administration</a></li>
                <li class="breadcrumb-item"><a asp-controller="DocumentsLegaux" asp-action="Index">Documents légaux</a></li>
                <li class="breadcrumb-item active" aria-current="page">@type.Libelle()</li>
            </ol>
        </nav>

        <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
            <div>
                <p class="text-muted mb-1">Administration</p>
                <h1 class="h3 mb-0">Historique — @type.Libelle()</h1>
            </div>
            <droit-visible code="DOCUMENTLEGAL.CREER">
                <a asp-controller="DocumentsLegaux" asp-action="Create" asp-route-type="@type" class="btn btn-primary">Publier une nouvelle version</a>
            </droit-visible>
        </div>

        <div class="card border-0 shadow-sm">
            <div class="card-body p-4">
                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <thead>
                            <tr>
                                <th scope="col">Version</th>
                                <th scope="col">Date d'effet</th>
                                <th scope="col">Statut</th>
                                <th scope="col">Créée le</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Count == 0)
                            {
                                <tr>
                                    <td colspan="4" class="text-muted text-center py-4">Aucune version enregistrée pour le moment.</td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var document in Model)
                                {
                                    <tr>
                                        <td><code>@document.Version</code></td>
                                        <td>@document.DateEffective.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                                        <td>
                                            @if (document.EstPublie)
                                            {
                                                <span class="badge text-bg-success">Publiée</span>
                                            }
                                            else
                                            {
                                                <span class="badge text-bg-light">Archivée</span>
                                            }
                                        </td>
                                        <td class="text-muted">@document.CreeLe.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</section>
