@model Web.Controllers.TypesActionController.TypeActionFormModel
@{
    var estModification = Model.Id.HasValue;
    ViewData["Title"] = estModification ? "Modifier un type d'action" : "Ajouter un type d'action";
}

<section class="backend-page">
    <div class="container-fluid">
        <nav aria-label="breadcrumb" class="mb-3">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a asp-page="/Dashboard/Index">Accueil</a></li>
                <li class="breadcrumb-item"><a asp-page="/Admin/Index">Administration</a></li>
                <li class="breadcrumb-item"><a asp-controller="TypesAction" asp-action="Index">Types d'action</a></li>
                <li class="breadcrumb-item active" aria-current="page">@ViewData["Title"]</li>
            </ol>
        </nav>

        <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
            <div>
                <p class="text-muted mb-1">Administration</p>
                <h1 class="h3 mb-0">@ViewData["Title"]</h1>
            </div>
            <a asp-controller="TypesAction" asp-action="Index" class="btn btn-outline-secondary">Retour aux types d'action</a>
        </div>

        <form method="post" asp-controller="TypesAction" asp-action="@(estModification ? "Edit" : "Create")" asp-route-id="@Model.Id">
            @Html.AntiForgeryToken()
            <div class="card border-0 shadow-sm">
                <div class="card-body p-4">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="row g-3">
                        <div class="col-12 col-md-6">
                            <label asp-for="Code" class="form-label"></label>
                            <input asp-for="Code" class="form-control" autocomplete="off" placeholder="VALIDER">
                            <span asp-validation-for="Code" class="text-danger"></span>
                        </div>

                        <div class="col-12 col-md-6">
                            <label asp-for="Libelle" class="form-label"></label>
                            <input asp-for="Libelle" class="form-control" autocomplete="off" placeholder="Valider">
                            <span asp-validation-for="Libelle" class="text-danger"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="Description" class="form-label"></label>
                            <textarea asp-for="Description" class="form-control" rows="2"></textarea>
                            <span asp-validation-for="Description" class="text-danger"></span>
                        </div>
                    </div>
                </div>
                <div class="card-footer bg-white border-top p-4">
                    <div class="d-flex flex-wrap justify-content-end gap-2">
                        <a asp-controller="TypesAction" asp-action="Index" class="btn btn-outline-secondary">Annuler</a>
                        <button type="submit" class="btn btn-primary">@(estModification ? "Enregistrer" : "Creer le type d'action")</button>
                    </div>
                </div>
            </div>
        </form>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
