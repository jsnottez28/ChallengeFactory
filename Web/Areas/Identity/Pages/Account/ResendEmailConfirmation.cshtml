@page
@model ResendEmailConfirmationModel
@{
    ViewData["Title"] = "Renvoyer la confirmation par email";
}

<section class="auth-page pt-110 pb-80">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-6">
                <div class="card border-0 shadow-sm p-4">
                    <div class="mb-4">
                        <h2 class="td-section-title">Renvoyer la confirmation</h2>
                        <p class="text-muted">Indiquez votre email pour recevoir un nouveau lien de confirmation.</p>
                    </div>
                    <form method="post">
                        <div asp-validation-summary="All" class="text-danger mb-3" role="alert"></div>
                        <div class="form-floating mb-3">
                            <input asp-for="Input.Email" class="form-control" aria-required="true" placeholder="name@example.com" />
                            <label asp-for="Input.Email">Email</label>
                            <span asp-validation-for="Input.Email" class="text-danger"></span>
                        </div>
                        <button type="submit" class="cf-btn cf-btn-primary w-100 justify-content-center">Renvoyer</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
