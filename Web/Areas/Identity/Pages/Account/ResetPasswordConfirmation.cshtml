@page
@model ResetPasswordConfirmationModel
@{
    ViewData["Title"] = "Mot de passe réinitialisé";
}

<section class="auth-page pt-110 pb-80">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-6">
                <div class="card border-0 shadow-sm p-4 text-center">
                    <div class="mb-4">
                        <h2 class="td-section-title">Mot de passe réinitialisé</h2>
                        <p class="text-muted">Votre mot de passe a bien été mis à jour.</p>
                    </div>
                    <div class="mt-2">
                        <a asp-page="./Login" class="cf-btn cf-btn-primary w-100 justify-content-center">Me connecter</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
