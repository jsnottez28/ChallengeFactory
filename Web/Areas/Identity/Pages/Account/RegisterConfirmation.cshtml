@page
@model RegisterConfirmationModel
@{
    Layout = "/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Inscription confirmée";
}

<section class="auth-page pt-80 pb-80">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-6">
                <div class="card border-0 shadow-sm p-4 text-center">
                    <div class="mb-4">
                        <h2 class="td-section-title">Inscription confirmée</h2>
                        <p class="text-muted">Un email de confirmation a été envoyé à :</p>
                    </div>
                    <p><strong>@Model.Email</strong></p>
                    <p>Veuillez cliquer sur le lien dans l'email pour activer votre compte.</p>
                    <div class="mt-4">
                        <a asp-page="./Login" class="btn btn-primary btn-lg w-100">Retour à la connexion</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>