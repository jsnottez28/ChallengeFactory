@page
@model ConfirmEmailChangeModel
@{
    ViewData["Title"] = "Confirmation du changement d'email";
}

<section class="auth-page pt-110 pb-80">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-6">
                <div class="card border-0 shadow-sm p-4 text-center">
                    <h2 class="td-section-title mb-3">Confirmation du changement d'email</h2>
                    <partial name="_StatusMessage" model="Model.StatusMessage" />
                    <div class="mt-3">
                        <a asp-page="./Login" class="cf-btn cf-btn-primary w-100 justify-content-center">Me connecter</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
