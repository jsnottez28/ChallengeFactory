@page
@model ForgotPasswordConfirmation
@{
    Layout = "/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Mot de passe oublié — confirmation";
}

<section class="auth-page pt-110 pb-80">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-6">
                <div class="card border-0 shadow-sm p-4 text-center">
                    <div class="mb-4">
                        <h2 class="td-section-title">Mot de passe oublié</h2>
                        <p class="text-muted">Un email de réinitialisation a été envoyé si votre adresse figure dans la base.</p>
                    </div>
                    <div class="alert alert-info" role="alert">
                        Vérifiez votre boîte mail pour suivre les instructions de réinitialisation.
                    </div>
                    <div class="mt-4">
                        <a asp-page="./Login" class="btn btn-primary btn-lg w-100">Retour à la connexion</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
