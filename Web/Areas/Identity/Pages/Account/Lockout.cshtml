@page
@model LockoutModel
@{
    ViewData["Title"] = "Compte verrouillé";
}

<section class="py-5">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-12 col-md-8 col-lg-6 text-center">
                <i class="fa-solid fa-lock display-4 text-danger d-block mb-3"></i>
                <h1 class="h3 mb-3">Compte temporairement verrouillé</h1>
                <p class="text-muted mb-4">Trop de tentatives de connexion ont échoué. Merci de réessayer dans quelques minutes.</p>
                <a asp-page="./Login" class="btn btn-primary">Retour à la connexion</a>
            </div>
        </div>
    </div>
</section>
