@page
@model IndexModel
@{
    Layout = "/Views/Shared/_LayoutBackend.cshtml";
    ViewData["Title"] = "Profil";
    ViewData["ActivePage"] = ManageNavPages.Index;
    var statutBadgeClass = Model.Statut == Domain.Entities.StatutUtilisateur.Actif
        ? "bg-success text-white"
        : Model.Statut == Domain.Entities.StatutUtilisateur.Modere
            ? "bg-warning text-dark"
            : "bg-secondary text-white";
}

<section class="backend-page">
    <div class="container-fluid">
        <nav aria-label="breadcrumb" class="mb-3">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a asp-area="" asp-page="/Dashboard/Index">Accueil</a></li>
                <li class="breadcrumb-item"><a asp-area="" asp-page="/Dashboard/Preferences">Préférences</a></li>
                <li class="breadcrumb-item active" aria-current="page">Profil</li>
            </ol>
        </nav>

        <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
            <div>
                <p class="text-muted mb-1">Compte utilisateur</p>
                <h1 class="h3 mb-0">Profil</h1>
            </div>
        </div>

        <partial name="_StatusMessage" for="StatusMessage" />

        <div class="row g-4 align-items-start">
            <div class="col-12 col-lg-8">
                <form id="profile-form" method="post" class="card border-0 shadow-sm">
                    <div class="card-header bg-white border-bottom p-4">
                        <div class="d-flex flex-wrap align-items-start justify-content-between gap-3">
                            <div>
                                <h2 class="h5 mb-1">Informations du profil</h2>
                                <p class="text-muted mb-0">Mettre à jour les informations principales du compte utilisateur.</p>
                            </div>
                            <span class="badge @statutBadgeClass">@Model.Statut</span>
                        </div>
                    </div>
                    <div class="card-body p-4">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>

                        <div class="row g-3">
                            <div class="col-12">
                                <label asp-for="Username" class="form-label">Nom utilisateur</label>
                                <input asp-for="Username" class="form-control" disabled />
                            </div>
                            <div class="col-12 col-md-6">
                                <label asp-for="Email" class="form-label">Email</label>
                                <input asp-for="Email" class="form-control" disabled />
                            </div>
                            <div class="col-12 col-md-6">
                                <label asp-for="Input.Telephone" class="form-label"></label>
                                <input asp-for="Input.Telephone" class="form-control" autocomplete="tel" placeholder="Téléphone" />
                                <span asp-validation-for="Input.Telephone" class="text-danger small"></span>
                            </div>

                            <div class="col-12">
                                <div class="row g-3">
                                    <div class="col-12 col-md-2">
                                        <label asp-for="Input.CiviliteId" class="form-label"></label>
                                        <select asp-for="Input.CiviliteId" asp-items="Model.Civilites" class="form-select">
                                            <option value="">Non renseignée</option>
                                        </select>
                                        <span asp-validation-for="Input.CiviliteId" class="text-danger small"></span>
                                    </div>

                                    <div class="col-12 col-md-5">
                                        <label asp-for="Input.Prenom" class="form-label"></label>
                                        <input asp-for="Input.Prenom" class="form-control" autocomplete="given-name" placeholder="Prénom" />
                                        <span asp-validation-for="Input.Prenom" class="text-danger small"></span>
                                    </div>

                                    <div class="col-12 col-md-5">
                                        <label asp-for="Input.Nom" class="form-label"></label>
                                        <input asp-for="Input.Nom" class="form-control" autocomplete="family-name" placeholder="Nom" />
                                        <span asp-validation-for="Input.Nom" class="text-danger small"></span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="card-footer bg-white border-top p-4">
                        <div class="d-flex flex-wrap justify-content-end gap-2">
                            <a asp-area="" asp-page="/Dashboard/Preferences" class="btn btn-outline-secondary">Annuler</a>
                            <button id="update-profile-button" type="submit" class="btn btn-primary">Enregistrer le profil</button>
                        </div>
                    </div>
                </form>
            </div>

            <div class="col-12 col-lg-4">
                <div class="card border-0 shadow-sm backend-side-card">
                    <div class="card-header bg-white border-bottom p-4">
                        <h2 class="h5 mb-0">Actions de sécurité</h2>
                    </div>
                    <div class="card-body p-4">
                        <p class="text-muted mb-3">Navigation Identity existante pour le compte utilisateur.</p>
                        <div class="list-group list-group-flush">
                            <a asp-page="./Index" class="list-group-item list-group-item-action px-0">
                                <span class="fw-semibold d-block">Profile</span>
                                <span class="text-muted small">/Identity/Account/Manage</span>
                            </a>
                            <a asp-page="./Email" class="list-group-item list-group-item-action px-0">
                                <span class="fw-semibold d-block">Email</span>
                                <span class="text-muted small">/Identity/Account/Manage/Email</span>
                            </a>
                            <a asp-page="./ChangePassword" class="list-group-item list-group-item-action px-0">
                                <span class="fw-semibold d-block">Password</span>
                                <span class="text-muted small">/Identity/Account/Manage/ChangePassword</span>
                            </a>
                            <a asp-page="./PersonalData" class="list-group-item list-group-item-action px-0">
                                <span class="fw-semibold d-block">Personal data</span>
                                <span class="text-muted small">/Identity/Account/Manage/PersonalData</span>
                            </a>
                            <a asp-page="./TwoFactorAuthentication" class="list-group-item list-group-item-action px-0">
                                <span class="fw-semibold d-block">MFA</span>
                                <span class="text-muted small">/Identity/Account/Manage/TwoFactorAuthentication</span>
                            </a>
                        </div>
                    </div>
                    <div class="card-footer bg-white border-top p-4">
                        <div class="text-muted small mb-3">
                            Compte créé le @Model.CreeLe.ToLocalTime().ToString("dd/MM/yyyy")
                        </div>
                        <a asp-area="" asp-page="/Dashboard/Preferences" class="btn btn-outline-secondary w-100">Retour aux préférences</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
