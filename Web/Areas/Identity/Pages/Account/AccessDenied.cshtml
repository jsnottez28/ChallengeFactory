@page
@model AccessDeniedModel
@{
    ViewData["Title"] = "Acces refuse";
}

<section class="py-5">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-12 col-md-8 col-lg-6 text-center">
                <i class="fa-solid fa-lock display-4 text-danger d-block mb-3"></i>
                <h1 class="h3 mb-3">Acces refuse</h1>
                <p class="text-muted mb-4">Vous n'avez pas les droits necessaires pour acceder a cette page. Si vous pensez qu'il s'agit d'une erreur, contactez un administrateur.</p>
                <a asp-page="/Dashboard/Index" class="btn btn-primary">Retour a mon espace</a>
            </div>
        </div>
    </div>
</section>
