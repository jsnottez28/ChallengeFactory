@page
@{
    ViewData["Title"] = "Préférences";
}

<section class="backend-page">
    <div class="container-fluid">
        <nav aria-label="breadcrumb" class="mb-3">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a asp-page="/Dashboard/Index">Accueil</a></li>
                <li class="breadcrumb-item active" aria-current="page">Préférences</li>
            </ol>
        </nav>

        <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
            <div>
                <p class="text-muted mb-1">Mon espace</p>
                <h1 class="h3 mb-0">Préférences</h1>
            </div>
            <button type="button" class="btn btn-primary">Enregistrer</button>
        </div>

        <div class="row g-4 align-items-start">
            <div class="col-12 col-lg-8">
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-white border-bottom p-4">
                        <h2 class="h5 mb-1">Préférences utilisateur</h2>
                        <p class="text-muted mb-0">Cette page accueillera les réglages personnels du compte.</p>
                    </div>
                    <div class="card-body p-4">
                        <div class="vstack gap-3">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" role="switch" id="prefEmailNotifications" checked>
                                <label class="form-check-label" for="prefEmailNotifications">Recevoir les notifications par email</label>
                            </div>
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" role="switch" id="prefSmsNotifications">
                                <label class="form-check-label" for="prefSmsNotifications">Recevoir les notifications par SMS</label>
                            </div>
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" role="switch" id="prefDashboardAlerts" checked>
                                <label class="form-check-label" for="prefDashboardAlerts">Afficher les alertes dans mon espace</label>
                            </div>
                            <div>
                                <label for="prefLanguage" class="form-label">Langue préférée</label>
                                <select id="prefLanguage" class="form-select">
                                    <option value="fr" selected>Français</option>
                                    <option value="en">Anglais</option>
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="card-footer bg-white border-top p-4">
                        <div class="d-flex flex-wrap justify-content-end gap-2">
                            <a asp-page="/Dashboard/Index" class="btn btn-outline-secondary">Annuler</a>
                            <button type="button" class="btn btn-primary">Enregistrer</button>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-12 col-lg-4">
                <div class="card border-0 shadow-sm backend-side-card">
                    <div class="card-header bg-white border-bottom p-4">
                        <h2 class="h5 mb-0">Compte et sécurité</h2>
                    </div>
                    <div class="card-body p-4">
                        <p class="text-muted mb-0">Retrouver ici les actions sensibles liées au compte utilisateur.</p>
                    </div>
                    <div class="card-footer bg-white border-top p-4">
                        <div class="d-grid gap-2">
                            <a asp-area="Identity" asp-page="/Account/Manage/Index" class="btn btn-outline-secondary">Voir le profil</a>
                            <a asp-area="Identity" asp-page="/Account/Manage/ChangePassword" class="btn btn-outline-secondary">Modifier le mot de passe</a>
                            <a asp-area="Identity" asp-page="/Account/Manage/TwoFactorAuthentication" class="btn btn-outline-secondary">Activer le MFA</a>
                            <a asp-area="Identity" asp-page="/Account/Manage/DeletePersonalData" class="btn btn-outline-danger">Supprimer le compte</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
