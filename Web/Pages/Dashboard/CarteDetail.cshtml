@page "{id:int}"
@model Web.Pages.Dashboard.CarteDetailModel
@using Domain.Entities
@{
    ViewData["Title"] = Model.Carte?.TitreTheorie ?? "Carte de compétences";
}

<section class="backend-page">
    <div class="container-fluid">
        <nav aria-label="breadcrumb" class="mb-3">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a asp-page="/Dashboard/Index">Accueil</a></li>
                <li class="breadcrumb-item"><a asp-page="/Dashboard/Cartes">Mes cartes de compétences</a></li>
                <li class="breadcrumb-item active" aria-current="page">@Model.Carte?.Code</li>
            </ol>
        </nav>

        <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
            <div>
                <p class="text-muted mb-1">Mon espace</p>
                <h1 class="h3 mb-0">@Model.Carte?.TitreTheorie</h1>
            </div>
            <a asp-page="/Dashboard/Cartes" class="btn btn-outline-secondary">Retour à mes cartes</a>
        </div>

        <div class="row g-4">
            <div class="col-12 col-lg-6">
                <partial name="_CarteFlipCard" model="Model.Carte" />
            </div>
            <div class="col-12 col-lg-6">
                <div class="card border-0 shadow-sm backend-side-card">
                    <div class="card-header bg-white border-bottom p-4">
                        <h2 class="h5 mb-0">Comment explorer cette carte</h2>
                    </div>
                    <div class="card-body p-4">
                        <p class="text-muted mb-0">Cliquez sur la carte (ou appuyez sur Entrée si elle est sélectionnée au clavier) pour la retourner et passer de la face Théorie à la face Défi terrain.</p>
                    </div>
                </div>

                @if (Model.Carte is not null && Model.Carte.Ressources.Count > 0)
                {
                    <div class="card border-0 shadow-sm backend-side-card mt-4">
                        <div class="card-header bg-white border-bottom p-4">
                            <h2 class="h5 mb-0">Pour aller plus loin</h2>
                        </div>
                        <div class="card-body p-4">
                            <ul class="list-unstyled mb-0">
                                @foreach (var ressource in Model.Carte.Ressources)
                                {
                                    <li class="mb-3">
                                        @if (ressource.Type == TypeRessourceCarte.LienWeb)
                                        {
                                            <a href="@ressource.Url" target="_blank" rel="noopener">🔗 @ressource.Titre</a>
                                        }
                                        else if (ressource.Type == TypeRessourceCarte.FichierPdf)
                                        {
                                            <a href="~/uploads/cartes-ressources/@ressource.NomFichier" target="_blank" rel="noopener">📄 @ressource.Titre</a>
                                        }
                                        else
                                        {
                                            <div>
                                                <span>📚 @ressource.Titre</span>
                                                <span class="text-muted small d-block">@ressource.ReferenceTexte</span>
                                            </div>
                                        }
                                    </li>
                                }
                            </ul>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script src="~/js/carte-flip.js"></script>
}
