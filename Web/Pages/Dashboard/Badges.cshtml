@page
@{
    ViewData["Title"] = "Mes badges";
}

<section class="backend-page">
    <div class="container-fluid">
        <nav aria-label="breadcrumb" class="mb-3">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a asp-page="/Dashboard/Index">Accueil</a></li>
                <li class="breadcrumb-item active" aria-current="page">Mes badges</li>
            </ol>
        </nav>

        <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
            <div>
                <p class="text-muted mb-1">Mon espace</p>
                <h1 class="h3 mb-0">Mes badges</h1>
            </div>
        </div>

        <div class="row g-4 align-items-start">
            <div class="col-12 col-lg-8">
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-white border-bottom p-4">
                        <h2 class="h5 mb-1">Badges utilisateur</h2>
                        <p class="text-muted mb-0">Cette page accueillera les badges obtenus ou disponibles pour l'utilisateur.</p>
                    </div>
                    <div class="card-body p-4">
                        <div class="row g-3">
                            <div class="col-12 col-md-6">
                                <div class="border rounded p-3 h-100">
                                    <span class="badge text-bg-light mb-2">À venir</span>
                                    <h3 class="h6 mb-1">Badge participant</h3>
                                    <p class="text-muted mb-0">Template d'affichage pour un badge utilisateur.</p>
                                </div>
                            </div>
                            <div class="col-12 col-md-6">
                                <div class="border rounded p-3 h-100">
                                    <span class="badge text-bg-light mb-2">À venir</span>
                                    <h3 class="h6 mb-1">Badge organisateur</h3>
                                    <p class="text-muted mb-0">Template d'affichage pour un badge utilisateur.</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-12 col-lg-4">
                <div class="card border-0 shadow-sm backend-side-card">
                    <div class="card-header bg-white border-bottom p-4">
                        <h2 class="h5 mb-0">Aide</h2>
                    </div>
                    <div class="card-body p-4">
                        <p class="text-muted mb-0">Les badges pourront être calculés selon les participations, rôles ou actions réalisées par l'utilisateur.</p>
                    </div>
                    <div class="card-footer bg-white border-top p-4">
                        <div class="d-grid gap-2">
                            <a asp-page="/Dashboard/Index" class="btn btn-outline-secondary">Retour au tableau de bord</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
