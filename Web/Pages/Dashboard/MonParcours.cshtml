@page
@model Web.Pages.Dashboard.MonParcoursModel
@using Domain.Entities
@{
    ViewData["Title"] = "Mon parcours en cours";
}

<section class="backend-page">
    <div class="container-fluid">
        <nav aria-label="breadcrumb" class="mb-3">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a asp-page="/Dashboard/Index">Accueil</a></li>
                <li class="breadcrumb-item active" aria-current="page">Mon parcours en cours</li>
            </ol>
        </nav>

        <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
            <div>
                <p class="text-muted mb-1">Mon espace</p>
                <h1 class="h3 mb-0">Mon parcours en cours</h1>
            </div>
        </div>

        @if (Model.Parcours.Count == 0)
        {
            <div class="card border-0 shadow-sm">
                <div class="card-body p-4">
                    <p class="text-muted mb-0">Vous n'êtes membre d'aucun Challenge actif pour le moment.</p>
                </div>
            </div>
        }
        else
        {
            @foreach (var parcours in Model.Parcours)
            {
                var contexte = Model.Contextes.GetValueOrDefault(parcours.ChallengeEtapeId);
                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-header bg-white border-bottom p-4 d-flex flex-wrap align-items-center justify-content-between gap-3">
                        <div>
                            <p class="text-muted mb-1">@parcours.ChallengeTitre</p>
                            <h2 class="h5 mb-0">Étape @parcours.NumeroEtape — @parcours.TitreEtape</h2>
                        </div>
                        <div class="d-flex flex-wrap gap-2">
                            <a asp-page="/Dashboard/MaPreuve" asp-route-cohorteId="@parcours.CohorteId" asp-route-challengeEtapeId="@parcours.ChallengeEtapeId" class="btn btn-sm btn-primary">Ma preuve</a>
                            <a asp-page="/Dashboard/PreuvesAValider" asp-route-cohorteId="@parcours.CohorteId" class="btn btn-sm btn-outline-primary">Preuves à valider</a>
                            <a asp-page="/Dashboard/Forum" asp-route-cohorteId="@parcours.CohorteId" class="btn btn-sm btn-outline-secondary">Forum</a>
                        </div>
                    </div>
                    <div class="card-body p-4">
                        <div class="row g-4">
                            <div class="col-12 col-lg-8">
                                @if (!string.IsNullOrWhiteSpace(parcours.DefiIndividuel))
                                {
                                    <div class="mb-4">
                                        <h3 class="h6 text-uppercase text-muted">Défi individuel</h3>
                                        <p class="mb-0">@parcours.DefiIndividuel</p>
                                    </div>
                                }

                                @if (parcours.Cartes.Count == 0)
                                {
                                    <p class="text-muted mb-0">Aucune carte rattachée à cette étape.</p>
                                }
                                else
                                {
                                    <div class="carte-flip-grid">
                                        @foreach (var carte in parcours.Cartes)
                                        {
                                            <partial name="_CarteFlipCard" model="carte" />
                                        }
                                    </div>
                                }
                            </div>

                            <div class="col-12 col-lg-4">
                                @if (contexte?.ProchaineVisio is not null)
                                {
                                    <div class="border rounded p-3 mb-3 border-primary">
                                        <h3 class="h6 mb-2">Prochaine visio</h3>
                                        <p class="mb-1 fw-semibold">Étape @contexte.ProchaineVisio.NumeroEtape — @contexte.ProchaineVisio.TitreEtape</p>
                                        <p class="text-muted small mb-2">@contexte.ProchaineVisio.DateHeure.ToLocalTime().ToString("dddd dd MMMM yyyy à HH:mm")</p>
                                        <p class="small mb-2" style="white-space: pre-line;">@contexte.ProchaineVisio.Descriptif</p>
                                        <a href="@contexte.ProchaineVisio.LienConnexion" target="_blank" rel="noopener" class="btn btn-sm btn-primary w-100">Rejoindre la visio</a>
                                    </div>
                                }

                                <div class="border rounded p-3 mb-3">
                                    <h3 class="h6 mb-2">Ma preuve pour cette étape</h3>
                                    @if (contexte?.MaPreuve is null)
                                    {
                                        <p class="text-muted small mb-2">Vous n'avez pas encore déposé de preuve pour ce défi.</p>
                                        <a asp-page="/Dashboard/MaPreuve" asp-route-cohorteId="@parcours.CohorteId" asp-route-challengeEtapeId="@parcours.ChallengeEtapeId" class="btn btn-sm btn-primary w-100">Déposer ma preuve</a>
                                    }
                                    else
                                    {
                                        var statutLabel = contexte.MaPreuve.Statut switch
                                        {
                                            StatutPreuve.Soumise => ("Soumise, en attente d'avis", "text-bg-secondary"),
                                            StatutPreuve.ValideeParLesPairs => ("Validée par les pairs", "text-bg-success"),
                                            StatutPreuve.ValideeDefinitivement => ("Validée définitivement", "text-bg-success"),
                                            _ => ("Non validée à la clôture", "text-bg-danger"),
                                        };
                                        <span class="badge @statutLabel.Item2 mb-2">@statutLabel.Item1</span>
                                        @if (contexte.MaPreuve.Statut == StatutPreuve.Soumise && contexte.MaPreuve.Retours.Exists(r => r.Decision == "À revoir"))
                                        {
                                            <p class="text-muted small mb-2">Un pair vous propose de revoir votre preuve.</p>
                                        }
                                        <a asp-page="/Dashboard/MaPreuve" asp-route-cohorteId="@parcours.CohorteId" asp-route-challengeEtapeId="@parcours.ChallengeEtapeId" class="btn btn-sm btn-outline-primary w-100 mt-1">Voir le suivi de ma preuve</a>
                                    }
                                </div>

                                <div class="border rounded p-3 mb-3">
                                    <h3 class="h6 mb-2">Dernier message du forum</h3>
                                    @if (contexte?.DernierMessageForum is null)
                                    {
                                        <p class="text-muted small mb-2">Aucun message pour le moment.</p>
                                    }
                                    else
                                    {
                                        <p class="small mb-1"><strong>@contexte.DernierMessageForum.AuteurNomComplet</strong></p>
                                        <p class="text-muted small mb-2">@(contexte.DernierMessageForum.Contenu.Length > 140 ? contexte.DernierMessageForum.Contenu[..140] + "…" : contexte.DernierMessageForum.Contenu)</p>
                                    }
                                    <a asp-page="/Dashboard/Forum" asp-route-cohorteId="@parcours.CohorteId" asp-route-challengeEtapeId="@parcours.ChallengeEtapeId" class="btn btn-sm btn-outline-secondary w-100">Voir le forum</a>
                                </div>

                                <div class="border rounded p-3">
                                    <h3 class="h6 mb-2">Preuves de pairs à valider</h3>
                                    <p class="mb-2"><span class="badge text-bg-warning">@(contexte?.NombrePreuvesAValider ?? 0)</span> en attente de votre avis</p>
                                    <a asp-page="/Dashboard/PreuvesAValider" asp-route-cohorteId="@parcours.CohorteId" class="btn btn-sm btn-outline-primary w-100">Valider des preuves</a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</section>

@section Scripts {
    <script src="~/js/carte-flip.js"></script>
}
