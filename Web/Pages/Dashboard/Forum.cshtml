@page
@model Web.Pages.Dashboard.ForumModel
@{
    ViewData["Title"] = "Forum de l'étape";
    ViewData["CohorteId"] = Model.CohorteId;
    ViewData["ChallengeEtapeId"] = Model.ChallengeEtapeId ?? 0;
    ViewData["EstEtapeCourante"] = Model.EtapeAffichee?.EstEtapeCourante ?? false;
}

<section class="backend-page">
    <div class="container-fluid">
        <nav aria-label="breadcrumb" class="mb-3">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a asp-page="/Dashboard/Index">Accueil</a></li>
                <li class="breadcrumb-item"><a asp-page="/Dashboard/MonParcours">Mon parcours en cours</a></li>
                <li class="breadcrumb-item active" aria-current="page">Forum</li>
            </ol>
        </nav>

        @if (Model.StatusMessage is not null)
        {
            <div class="alert alert-info alert-dismissible fade show" role="alert">
                @Model.StatusMessage
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fermer"></button>
            </div>
        }

        <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
            <div>
                <p class="text-muted mb-1">Mon espace</p>
                <h1 class="h3 mb-0">Forum — @(Model.EtapeAffichee?.TitreEtape ?? "Aucune étape")</h1>
            </div>
            @if (Model.Etapes.Count > 1)
            {
                <form method="get" class="d-flex align-items-center gap-2">
                    <input type="hidden" name="CohorteId" value="@Model.CohorteId">
                    <label class="form-label mb-0 text-muted small">Étape :</label>
                    <select name="ChallengeEtapeId" class="form-select form-select-sm" onchange="this.form.submit()">
                        @foreach (var etape in Model.Etapes)
                        {
                            <option value="@etape.ChallengeEtapeId" selected="@(etape.ChallengeEtapeId == Model.ChallengeEtapeId)">
                                Étape @etape.NumeroEtape — @etape.TitreEtape @(etape.EstEtapeCourante ? "(en cours)" : "")
                            </option>
                        }
                    </select>
                </form>
            }
        </div>

        @if (Model.EtapeAffichee is null)
        {
            <div class="card border-0 shadow-sm">
                <div class="card-body p-4">
                    <p class="text-muted mb-0">Aucun forum disponible pour le moment.</p>
                </div>
            </div>
        }
        else
        {
            @if (!Model.EtapeAffichee.EstEtapeCourante)
            {
                <p class="text-muted small">Étape déjà clôturée : forum en lecture seule (historique).</p>
            }

            <div class="mb-4">
                @if (Model.Messages.Count == 0)
                {
                    <p class="text-muted mb-0">Aucun message pour le moment.</p>
                }
                else
                {
                    @foreach (var message in Model.Messages)
                    {
                        <partial name="_ForumMessage" model="message" view-data="ViewData" />
                    }
                }
            </div>

            @if (Model.EtapeAffichee.EstEtapeCourante)
            {
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-white border-bottom p-4">
                        <h2 class="h5 mb-0">Nouveau message</h2>
                    </div>
                    <div class="card-body p-4">
                        <form method="post" asp-page-handler="Poster" asp-route-cohorteId="@Model.CohorteId" asp-route-challengeEtapeId="@Model.ChallengeEtapeId">
                            @Html.AntiForgeryToken()
                            <textarea name="Contenu" class="form-control mb-2" rows="3" required></textarea>
                            <button type="submit" class="btn btn-primary">Publier</button>
                        </form>
                    </div>
                </div>
            }
        }
    </div>
</section>
