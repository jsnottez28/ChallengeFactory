@page
@{
    ViewData["Title"] = "Tableau de bord";
}

<section class="backend-page">
    <div class="container-fluid">
        <nav aria-label="breadcrumb" class="mb-3">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a asp-page="/Dashboard/Index">Accueil</a></li>
                <li class="breadcrumb-item active" aria-current="page">Tableau de bord</li>
            </ol>
        </nav>

        <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
            <div>
                <p class="text-muted mb-1">Mon espace</p>
                <h1 class="h3 mb-0">Bienvenue @(User.Identity?.Name ?? "utilisateur")</h1>
            </div>
            <a asp-page="/Dashboard/Index" class="btn btn-primary">Voir le tableau de bord</a>
        </div>

        <div class="row g-4 align-items-start">
            <div class="col-12 col-lg-8">
                <div class="card border-0 shadow-sm">
                    <div class="card-body p-4">
                        <h2 class="h5 mb-4">Synthèse de mon espace</h2>

                        <div class="row g-3">
                            <div class="col-12 col-md-6">
                                <a asp-area="Identity" asp-page="/Account/Manage/Index" class="d-block h-100 text-decoration-none border rounded p-3">
                                    <span class="fw-semibold text-dark d-block mb-1">Mes informations</span>
                                    <span class="text-muted small">Consulter et mettre à jour le profil.</span>
                                </a>
                            </div>
                            <div class="col-12 col-md-6">
                                <a asp-page="/Dashboard/Inscriptions" class="d-block h-100 text-decoration-none border rounded p-3">
                                    <span class="fw-semibold text-dark d-block mb-1">Mes réservations</span>
                                    <span class="text-muted small">Suivre les inscriptions et réservations.</span>
                                </a>
                            </div>
                            <div class="col-12 col-md-6">
                                <a href="#" class="d-block h-100 text-decoration-none border rounded p-3">
                                    <span class="fw-semibold text-dark d-block mb-1">Mes tickets</span>
                                    <span class="text-muted small">Retrouver les demandes de support.</span>
                                </a>
                            </div>
                            <div class="col-12 col-md-6">
                                <a asp-page="/Dashboard/Preferences" class="d-block h-100 text-decoration-none border rounded p-3">
                                    <span class="fw-semibold text-dark d-block mb-1">Mes préférences</span>
                                    <span class="text-muted small">Adapter les réglages de l'espace.</span>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-12 col-lg-4">
                <div class="card border-0 shadow-sm backend-side-card">
                    <div class="card-body p-4">
                        <h2 class="h5 mb-3">À retenir</h2>
                        <p class="text-muted mb-3">Cette colonne peut accueillir les alertes, raccourcis, notifications ou informations utiles à l'utilisateur.</p>
                        <div class="list-group list-group-flush">
                            <a asp-area="Identity" asp-page="/Account/Manage/Index" class="list-group-item list-group-item-action px-0">Compléter mon profil</a>
                            <a href="#" class="list-group-item list-group-item-action px-0">Voir mes notifications</a>
                            <a href="#" class="list-group-item list-group-item-action px-0">Contacter le support</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
