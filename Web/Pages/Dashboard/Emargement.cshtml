@page
@model Web.Pages.Dashboard.EmargementModel
@{
    ViewData["Title"] = "Émargement";
}

<section class="backend-page">
    <div class="container-fluid">
        <nav aria-label="breadcrumb" class="mb-3">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a asp-page="/Dashboard/Index">Accueil</a></li>
                <li class="breadcrumb-item active" aria-current="page">Émargement</li>
            </ol>
        </nav>

        @if (Model.StatusMessage is not null)
        {
            <div class="alert @(Model.DernierEnvoiReussi ? "alert-success" : "alert-danger") alert-dismissible fade show" role="alert">
                @Model.StatusMessage
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fermer"></button>
            </div>
        }

        <div class="mb-4">
            <p class="text-muted mb-1">
                Émargement de la séance
                @if (Model.Info?.DateSeance is not null)
                {
                    <text>du @Model.Info.DateSeance.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</text>
                }
            </p>
            <h1 class="h3 mb-0">@(Model.Info?.ChallengeTitre ?? "Émargement")</h1>
        </div>

        <div class="card border-0 shadow-sm" style="max-width: 640px;">
            <div class="card-body p-4">
                @if (Model.Info is null)
                {
                    <p class="text-muted mb-0">Aucun émargement à signer pour le moment.</p>
                }
                else if (Model.RienASigner)
                {
                    <p class="mb-0">Merci, tous vos émargements pour l'étape @Model.Info.NumeroEtape sont à jour.</p>
                }
                else
                {
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <form method="post">
                        <input type="hidden" asp-for="CohorteId" />

                        <div class="mb-4">
                            <label class="form-label fw-semibold">Je certifie avoir participé à la séance et acquis les cartes suivantes :</label>
                            @foreach (var carte in Model.Info.Cartes)
                            {
                                <div class="form-check mb-1">
                                    @if (carte.Signe)
                                    {
                                        <input class="form-check-input" type="checkbox" checked disabled>
                                        <label class="form-check-label text-muted">
                                            @carte.CarteTitre
                                            <span class="badge text-bg-success ms-1">Déjà signé</span>
                                        </label>
                                    }
                                    else
                                    {
                                        <input class="form-check-input" type="checkbox" name="EmargementIdsConfirmes" value="@carte.EmargementId" id="carte-@carte.EmargementId">
                                        <label class="form-check-label" for="carte-@carte.EmargementId">@carte.CarteTitre</label>
                                    }
                                </div>
                            }
                            <span id="carte-erreur" class="text-danger small d-none">Merci de cocher au moins une carte à certifier.</span>
                        </div>

                        <div class="row g-3 mb-4">
                            <div class="col-6">
                                <label asp-for="HeuresPresence" class="form-label">Heures de présence</label>
                                <input asp-for="HeuresPresence" type="number" step="0.25" min="0" class="form-control" required>
                                <span asp-validation-for="HeuresPresence" class="text-danger small"></span>
                            </div>
                            <div class="col-6">
                                <label asp-for="HeuresTravailPersonnel" class="form-label">Travail personnel effectué (heures)</label>
                                <input asp-for="HeuresTravailPersonnel" type="number" step="0.25" min="0" class="form-control" required>
                                <span asp-validation-for="HeuresTravailPersonnel" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-semibold">Votre signature</label>
                            <canvas id="signature-pad" width="560" height="180" class="border rounded d-block" style="width:100%;max-width:560px;height:180px;touch-action:none;background:#fff;"></canvas>
                            <button type="button" id="signature-effacer" class="btn btn-sm btn-outline-secondary mt-2">Effacer</button>
                            <input type="hidden" asp-for="SignatureDataUrl" id="signature-data" />
                            <span asp-validation-for="SignatureDataUrl" class="text-danger small d-block mt-1"></span>
                        </div>

                        <button type="submit" class="btn btn-primary">Signer mon émargement</button>
                    </form>
                }
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        (function () {
            var canvas = document.getElementById('signature-pad');
            if (!canvas) {
                return;
            }

            var ctx = canvas.getContext('2d');
            var input = document.getElementById('signature-data');
            var form = canvas.closest('form');
            var dessin = false;
            var aDessine = false;

            ctx.lineWidth = 2;
            ctx.lineCap = 'round';
            ctx.strokeStyle = '#0f0f0f';

            function position(e) {
                var rect = canvas.getBoundingClientRect();
                var scaleX = canvas.width / rect.width;
                var scaleY = canvas.height / rect.height;
                var point = e.touches ? e.touches[0] : e;
                return { x: (point.clientX - rect.left) * scaleX, y: (point.clientY - rect.top) * scaleY };
            }

            function debuter(e) {
                dessin = true;
                aDessine = true;
                var p = position(e);
                ctx.beginPath();
                ctx.moveTo(p.x, p.y);
                e.preventDefault();
            }

            function tracer(e) {
                if (!dessin) {
                    return;
                }
                var p = position(e);
                ctx.lineTo(p.x, p.y);
                ctx.stroke();
                e.preventDefault();
            }

            function arreter() {
                dessin = false;
            }

            canvas.addEventListener('mousedown', debuter);
            canvas.addEventListener('mousemove', tracer);
            window.addEventListener('mouseup', arreter);
            canvas.addEventListener('touchstart', debuter, { passive: false });
            canvas.addEventListener('touchmove', tracer, { passive: false });
            canvas.addEventListener('touchend', arreter);

            var effacerBtn = document.getElementById('signature-effacer');
            if (effacerBtn) {
                effacerBtn.addEventListener('click', function () {
                    ctx.clearRect(0, 0, canvas.width, canvas.height);
                    aDessine = false;
                    input.value = '';
                });
            }

            if (form) {
                form.addEventListener('submit', function (e) {
                    var carteErreur = document.getElementById('carte-erreur');
                    var auMoinsUneCarteCochee = form.querySelectorAll('input[name="EmargementIdsConfirmes"]:checked').length > 0;

                    if (!auMoinsUneCarteCochee) {
                        e.preventDefault();
                        if (carteErreur) {
                            carteErreur.classList.remove('d-none');
                        }
                        return;
                    }

                    if (carteErreur) {
                        carteErreur.classList.add('d-none');
                    }

                    if (aDessine) {
                        input.value = canvas.toDataURL('image/png');
                    }
                });
            }
        })();
    </script>
    <partial name="_ValidationScriptsPartial" />
}
