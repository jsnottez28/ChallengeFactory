@page
@model Web.Pages.Dashboard.TestPositionnementModel
@using Domain.Entities
@{
    var estAmont = Model.Type == TypeTestPositionnement.Amont;
    ViewData["Title"] = estAmont ? "Test de connaissances (amont)" : "Test de connaissances (aval)";
}

<section class="backend-page">
    <div class="container-fluid">
        <nav aria-label="breadcrumb" class="mb-3">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a asp-page="/Dashboard/Index">Accueil</a></li>
                <li class="breadcrumb-item active" aria-current="page">Test de connaissances</li>
            </ol>
        </nav>

        @if (Model.StatusMessage is not null)
        {
            <div class="alert @(Model.DernierEnvoiReussi ? "alert-success" : "alert-danger") alert-dismissible fade show" role="alert">
                @Model.StatusMessage
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fermer"></button>
            </div>
        }

        <div class="mb-4">
            <p class="text-muted mb-1">@(estAmont ? "Point de départ — avant de démarrer" : "Point d'arrivée — fin de parcours")</p>
            <h1 class="h3 mb-0">@(Model.Info?.ChallengeTitre ?? "Test de connaissances")</h1>
            <p class="text-muted mb-0">Pas de bonne ou de mauvaise réponse : indiquez simplement votre niveau actuel sur chaque objectif, de 0 (aucune connaissance) à 10 (maîtrise complète).</p>
        </div>

        <div class="card border-0 shadow-sm" style="max-width: 720px;">
            <div class="card-body p-4">
                @if (Model.Info is null)
                {
                    <p class="text-muted mb-0">Aucun test de connaissances à répondre pour le moment.</p>
                }
                else if (Model.DejaRepondu)
                {
                    <p class="mb-0">Merci, vous avez déjà répondu à ce test pour ce Challenge.</p>
                }
                else
                {
                    <form method="post">
                        <input type="hidden" asp-for="CohorteId" />
                        <input type="hidden" asp-for="Type" />

                        @foreach (var etape in Model.Info.Etapes)
                        {
                            <div class="mb-4">
                                <label class="form-label fw-semibold">Étape @etape.NumeroEtape — @etape.Libelle</label>
                                <div class="d-flex flex-wrap gap-2">
                                    @for (var note = 0; note <= 10; note++)
                                    {
                                        <div class="form-check form-check-inline m-0">
                                            <input class="btn-check" type="radio" name="Niveaux[@etape.ChallengeEtapeId]" id="niveau-@(etape.ChallengeEtapeId)-@note" value="@note" autocomplete="off" required>
                                            <label class="btn btn-outline-secondary btn-sm" for="niveau-@(etape.ChallengeEtapeId)-@note" style="width:42px;">@note</label>
                                        </div>
                                    }
                                </div>
                            </div>
                        }

                        <button type="submit" class="btn btn-primary">Envoyer mes réponses</button>
                    </form>
                }
            </div>
        </div>
    </div>
</section>
