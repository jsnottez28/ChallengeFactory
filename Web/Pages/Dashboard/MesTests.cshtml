@page
@model Web.Pages.Dashboard.MesTestsModel
@{
    ViewData["Title"] = "Mes tests";
}

<section class="backend-page">
    <div class="container-fluid">
        <nav aria-label="breadcrumb" class="mb-3">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a asp-page="/Dashboard/Index">Accueil</a></li>
                <li class="breadcrumb-item active" aria-current="page">Mes tests</li>
            </ol>
        </nav>

        <div class="mb-4">
            <p class="text-muted mb-1">Mon espace</p>
            <h1 class="h3 mb-0">Mes tests</h1>
            <p class="text-muted mb-0">Résultats des tests psychotechniques que vous avez passés.</p>
        </div>

        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-white border-bottom p-4">
                <h2 class="h5 mb-0">Test DISC</h2>
            </div>
            <div class="card-body p-4">
                @if (Model.DiscResultat is null)
                {
                    <p class="text-muted mb-0">Pas encore passé — ce test vous sera proposé au fil de votre parcours.</p>
                }
                else
                {
                    var r = Model.DiscResultat;
                    <p class="text-muted small mb-3">Passé le @r.CompleteLe.ToLocalTime().ToString("dd/MM/yyyy à HH:mm")</p>
                    <p class="mb-2">Profil dominant : <strong>@r.ProfilDominant – @r.ProfilDominantNom</strong></p>
                    <p class="text-muted mb-3">@r.ProfilDominantDescription</p>
                    <div class="d-flex flex-wrap gap-1 mb-3">
                        @foreach (var trait in r.ProfilDominantTraits)
                        {
                            <span class="badge text-bg-light">@trait</span>
                        }
                    </div>
                    <div class="row g-2 text-center" style="max-width: 320px;">
                        <div class="col-3"><strong>D</strong><br><span class="text-muted small">@r.ScoreD/25</span></div>
                        <div class="col-3"><strong>I</strong><br><span class="text-muted small">@r.ScoreI/25</span></div>
                        <div class="col-3"><strong>S</strong><br><span class="text-muted small">@r.ScoreS/25</span></div>
                        <div class="col-3"><strong>C</strong><br><span class="text-muted small">@r.ScoreC/25</span></div>
                    </div>
                }
            </div>
        </div>

        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-white border-bottom p-4">
                <h2 class="h5 mb-0">Test RIASEC</h2>
            </div>
            <div class="card-body p-4">
                @if (Model.RiasecResultat is null)
                {
                    <p class="text-muted mb-0">Pas encore passé — ce test vous sera proposé au fil de votre parcours.</p>
                }
                else
                {
                    var rr = Model.RiasecResultat;
                    <p class="text-muted small mb-3">Passé le @rr.CompleteLe.ToLocalTime().ToString("dd/MM/yyyy à HH:mm")</p>
                    <p class="mb-3">Code Holland : <strong>@rr.CodeHolland</strong></p>
                    <div class="row g-2 text-center mb-3" style="max-width: 420px;">
                        @foreach (var dim in rr.Dimensions)
                        {
                            <div class="col-2"><strong>@dim.Code</strong><br><span class="text-muted small">@dim.Score/10</span></div>
                        }
                    </div>
                    @foreach (var dim in rr.Dimensions.Where(d => rr.CodeHolland.Contains(d.Code)).OrderByDescending(d => d.Score))
                    {
                        <p class="mb-1"><strong>@dim.Code — @dim.Nom</strong><br><span class="text-muted small">@dim.Description</span></p>
                        @if (dim.Metiers.Count > 0)
                        {
                            <p class="text-muted small mb-2">Exemples de métiers : @string.Join(", ", dim.Metiers)</p>
                        }
                    }
                    <p class="mb-2"><span class="badge text-bg-light">Profil @rr.Synthese.TypeProfil</span></p>
                    <p class="text-muted mb-3">@rr.Synthese.Resume</p>
                    <p class="text-muted small mb-0">Cohérence des réponses : @rr.NombrePairesCoherentes/@rr.NombrePairesControle</p>
                }
            </div>
        </div>

        @* D'autres tests psychotechniques s'ajouteront ici, chacun dans sa propre carte -
           cf. MesTestsModel. *@
    </div>
</section>
