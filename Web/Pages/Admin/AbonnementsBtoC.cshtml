@page
@model AbonnementsBtoCModel
@{
    ViewData["Title"] = "Abonnements BtoC";
}

<section class="backend-page">
    <div class="container-fluid">
        <nav aria-label="breadcrumb" class="mb-3">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a asp-page="/Dashboard/Index">Accueil</a></li>
                <li class="breadcrumb-item"><a asp-page="/Admin/Index">Administration</a></li>
                <li class="breadcrumb-item active" aria-current="page">Abonnements BtoC</li>
            </ol>
        </nav>

        @if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @Model.StatusMessage
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fermer"></button>
            </div>
        }

        <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
            <div>
                <p class="text-muted mb-1">Administration</p>
                <h1 class="h3 mb-0">Abonnements BtoC</h1>
                <p class="text-muted mb-0">Le paiement est géré manuellement, hors plateforme. Cet abonnement conditionne l'accès à tous les Challenges BtoC en cours de l'utilisateur, pas seulement au dernier rejoint.</p>
            </div>
        </div>

        <div class="card border-0 shadow-sm">
            <div class="card-body p-4">
                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <thead>
                            <tr>
                                <th scope="col">Utilisateur</th>
                                <th scope="col">Email</th>
                                <th scope="col">Statut</th>
                                <th scope="col" class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Users.Count == 0)
                            {
                                <tr>
                                    <td colspan="4" class="text-muted text-center py-4">Aucun compte BtoC pour le moment.</td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var user in Model.Users)
                                {
                                    <tr class="@(user.Id == Model.UtilisateurId ? "table-primary" : "")">
                                        <td class="fw-semibold">@user.DisplayName</td>
                                        <td>@user.Email</td>
                                        <td>
                                            @switch (user.Statut)
                                            {
                                                case Domain.Entities.StatutUtilisateur.Actif:
                                                    <span class="badge text-bg-success">Actif</span>
                                                    break;
                                                case Domain.Entities.StatutUtilisateur.Modere:
                                                    <span class="badge text-bg-warning">En attente de validation</span>
                                                    break;
                                                default:
                                                    <span class="badge text-bg-secondary">Suspendu</span>
                                                    break;
                                            }
                                        </td>
                                        <td class="text-end">
                                            <div class="d-inline-flex gap-2">
                                                @if (user.Statut != Domain.Entities.StatutUtilisateur.Actif)
                                                {
                                                    <form method="post" asp-page-handler="ValiderPaiement">
                                                        <input type="hidden" name="userId" value="@user.Id">
                                                        <button type="submit" class="btn btn-sm btn-success">Valider le paiement</button>
                                                    </form>
                                                }
                                                @if (user.Statut != Domain.Entities.StatutUtilisateur.Inactif)
                                                {
                                                    <form method="post" asp-page-handler="SuspendreAcces" onsubmit="return confirm('Suspendre l\'accès de cet utilisateur à tous ses Challenges BtoC en cours ?');">
                                                        <input type="hidden" name="userId" value="@user.Id">
                                                        <button type="submit" class="btn btn-sm btn-outline-danger">Suspendre l'accès</button>
                                                    </form>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</section>
