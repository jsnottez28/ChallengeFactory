@page
@model Web.Pages.Admin.TestsPsychotechniquesModel
@{
    ViewData["Title"] = "Tests psychotechniques";
}

<section class="backend-page">
    <div class="container-fluid">
        <nav aria-label="breadcrumb" class="mb-3">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a asp-page="/Dashboard/Index">Accueil</a></li>
                <li class="breadcrumb-item"><a asp-page="/Admin/Index">Administration</a></li>
                <li class="breadcrumb-item active" aria-current="page">Tests psychotechniques</li>
            </ol>
        </nav>

        <div class="mb-4">
            <p class="text-muted mb-1">Administration</p>
            <h1 class="h3 mb-0">Tests psychotechniques</h1>
            <p class="text-muted mb-0">
                Copiez le lien d'accès d'un test pour le coller dans le champ « Défi individuel » d'une étape de Challenge,
                ou envoyez-le manuellement à un stagiaire. Le lien est le même pour tout le monde : la personne doit être
                connectée à la plateforme, son résultat est automatiquement lié à son compte et lui est envoyé par email.
            </p>
        </div>

        <div class="card border-0 shadow-sm">
            <div class="card-body p-4">
                @if (Model.Tests.Count == 0)
                {
                    <p class="text-muted mb-0">Aucun test disponible pour le moment.</p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table align-middle mb-0">
                            <thead>
                                <tr>
                                    <th scope="col">Test</th>
                                    <th scope="col">Lien d'accès</th>
                                    <th scope="col" class="text-end">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var test in Model.Tests)
                                {
                                    <tr>
                                        <td>
                                            <strong>@test.Nom</strong>
                                            <div class="text-muted small">@test.Description</div>
                                        </td>
                                        <td><code class="lien-acces">@test.LienAcces</code></td>
                                        <td class="text-end">
                                            <button type="button" class="btn btn-sm btn-outline-secondary btn-copier-lien" data-lien="@test.LienAcces">Copier le lien</button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        document.querySelectorAll('.btn-copier-lien').forEach(function (btn) {
            btn.addEventListener('click', function () {
                var lien = btn.getAttribute('data-lien');
                navigator.clipboard.writeText(lien).then(function () {
                    var texteInitial = btn.textContent;
                    btn.textContent = 'Copié !';
                    setTimeout(function () { btn.textContent = texteInitial; }, 1500);
                });
            });
        });
    </script>
}
