@page
@model PermissionsModel
@{
    ViewData["Title"] = "Périmètres d'accès";
}

<section class="backend-page">
    <div class="container-fluid">
        <nav aria-label="breadcrumb" class="mb-3">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a asp-page="/Dashboard/Index">Accueil</a></li>
                <li class="breadcrumb-item"><a asp-page="/Admin/Index">Administration</a></li>
                <li class="breadcrumb-item active" aria-current="page">Périmètres d'accès</li>
            </ol>
        </nav>

        @if (TempData["StatusMessage"] is string statusMessage && !string.IsNullOrWhiteSpace(statusMessage))
        {
            <div class="alert alert-info alert-dismissible fade show" role="alert">
                @statusMessage
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fermer"></button>
            </div>
        }

        <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
            <div>
                <p class="text-muted mb-1">Administration</p>
                <h1 class="h3 mb-0">Périmètres d'accès</h1>
            </div>
            <a asp-page="/Admin/Droits" class="btn btn-outline-secondary">Voir les droits</a>
        </div>

        <div class="row g-4 align-items-start">
            <div class="col-12 col-xl-5">
                <div class="card border-0 shadow-sm">
                    <div class="card-body p-4">
                        <h2 class="h5 mb-3">Utilisateurs</h2>

                        @if (Model.Users.Count == 0)
                        {
                            <div class="border rounded p-4 text-center">
                                <h3 class="h6 mb-2">Aucun utilisateur</h3>
                                <p class="text-muted mb-0">Ajoutez un utilisateur avant de définir ses périmètres d'accès.</p>
                            </div>
                        }
                        else
                        {
                            <div class="table-responsive">
                                <table class="table align-middle mb-0">
                                    <thead>
                                        <tr>
                                            <th scope="col">Utilisateur</th>
                                            <th scope="col">Rôles</th>
                                            <th scope="col" class="text-center">Scopes</th>
                                            <th scope="col" class="text-end">Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var user in Model.Users)
                                        {
                                            var isSelected = Model.SelectedUser?.Id == user.Id;
                                            <tr class="@(isSelected ? "table-light" : string.Empty)">
                                                <td>
                                                    <span class="fw-semibold d-block">@user.DisplayName</span>
                                                    <span class="text-muted small">@user.Email</span>
                                                </td>
                                                <td>
                                                    @if (user.Roles.Count == 0)
                                                    {
                                                        <span class="text-muted">Aucun rôle</span>
                                                    }
                                                    else
                                                    {
                                                        <span>@string.Join(", ", user.Roles)</span>
                                                    }
                                                </td>
                                                <td class="text-center">
                                                    <span class="badge bg-secondary">@user.ActiveScopeCount</span>
                                                </td>
                                                <td class="text-end">
                                                    <a asp-page="/Admin/Permissions" asp-route-userId="@user.Id" class="btn btn-sm @(isSelected ? "btn-primary" : "btn-outline-secondary")">Gérer</a>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <div class="col-12 col-xl-7">
                @if (Model.SelectedUser is null)
                {
                    <div class="card border-0 shadow-sm">
                        <div class="card-body p-4 text-center">
                            <h2 class="h5 mb-2">Aucun utilisateur sélectionné</h2>
                            <p class="text-muted mb-0">Sélectionnez un utilisateur pour gérer ses périmètres.</p>
                        </div>
                    </div>
                }
                else
                {
                    <form method="post" asp-page-handler="SaveScopes">
                        <input type="hidden" asp-for="Input.UserId" />

                        <div class="card border-0 shadow-sm mb-4">
                            <div class="card-body p-4">
                                <div class="d-flex flex-wrap align-items-start justify-content-between gap-3">
                                    <div>
                                        <h2 class="h5 mb-1">@Model.SelectedUser.DisplayName</h2>
                                        <p class="text-muted mb-0">@Model.SelectedUser.Email</p>
                                    </div>
                                    <button type="submit" class="btn btn-primary">Enregistrer les périmètres</button>
                                </div>

                                <hr class="my-4" />

                                <div class="row g-4">
                                    <div class="col-12 col-lg-5">
                                        <h3 class="h6 mb-3">Rôles</h3>
                                        @if (Model.SelectedUser.Roles.Count == 0)
                                        {
                                            <p class="text-muted mb-0">Aucun rôle associé.</p>
                                        }
                                        else
                                        {
                                            <div class="d-flex flex-wrap gap-2">
                                                @foreach (var role in Model.SelectedUser.Roles)
                                                {
                                                    <span class="badge bg-dark">@role</span>
                                                }
                                            </div>
                                        }
                                    </div>

                                    <div class="col-12 col-lg-7">
                                        <h3 class="h6 mb-3">Droits hérités</h3>
                                        @if (Model.RoleClaims.Count == 0)
                                        {
                                            <p class="text-muted mb-0">Aucun droit hérité des rôles.</p>
                                        }
                                        else
                                        {
                                            <div class="d-flex flex-wrap gap-2">
                                                @foreach (var claim in Model.RoleClaims)
                                                {
                                                    <span class="badge bg-light text-dark border">
                                                        <code>@claim.Type</code> : <code>@claim.Value</code>
                                                    </span>
                                                }
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="card border-0 shadow-sm">
                            <div class="card-body p-4">
                                <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-3">
                                    <div>
                                        <h2 class="h5 mb-1">Organisations autorisées</h2>
                                        <p class="text-muted mb-0">Ces organisations seront enregistrées dans la table <code>Scopes</code>.</p>
                                    </div>
                                </div>

                                @if (Model.Organisations.Count == 0)
                                {
                                    <div class="border rounded p-4 text-center">
                                        <h3 class="h6 mb-2">Aucune organisation</h3>
                                        <p class="text-muted mb-0">Ajoutez des organisations avant de définir les périmètres d'accès.</p>
                                    </div>
                                }
                                else
                                {
                                    <div class="table-responsive">
                                        <table class="table align-middle mb-0">
                                            <thead>
                                                <tr>
                                                    <th scope="col" class="text-center">Accès</th>
                                                    <th scope="col">Organisation</th>
                                                    <th scope="col">Code adhérent</th>
                                                    <th scope="col">Statut</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var organisation in Model.Organisations)
                                                {
                                                    <tr>
                                                        <td class="text-center">
                                                            <input class="form-check-input" type="checkbox" name="Input.SelectedOrganisationIds" value="@organisation.Id" checked="@organisation.IsSelected" />
                                                        </td>
                                                        <td class="fw-semibold">@organisation.RaisonSociale</td>
                                                        <td class="text-muted">@organisation.CodeAdherent</td>
                                                        <td>
                                                            @if (organisation.EstActif)
                                                            {
                                                                <span class="badge bg-success">Actif</span>
                                                            }
                                                            else
                                                            {
                                                                <span class="badge bg-secondary">Inactif</span>
                                                            }
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                }
                            </div>
                        </div>
                    </form>
                }
            </div>
        </div>
    </div>
</section>
