@page
@model RoleEditModel
@{
    ViewData["Title"] = "Modifier un rôle";
}

<section class="backend-page">
    <div class="container-fluid">
        <nav aria-label="breadcrumb" class="mb-3">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a asp-page="/Dashboard/Index">Accueil</a></li>
                <li class="breadcrumb-item"><a asp-page="/Admin/Index">Administration</a></li>
                <li class="breadcrumb-item"><a asp-page="/Admin/Roles">Rôles</a></li>
                <li class="breadcrumb-item active" aria-current="page">Modifier un rôle</li>
            </ol>
        </nav>

        <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
            <div>
                <p class="text-muted mb-1">Administration</p>
                <h1 class="h3 mb-0">Modifier un rôle</h1>
            </div>
            <a asp-page="/Admin/Roles" class="btn btn-outline-secondary">Retour aux rôles</a>
        </div>

        <form method="post">
            <input asp-for="Input.Id" type="hidden">

            <div class="row g-4 align-items-start">
                <div class="col-12 col-lg-8">
                    <div class="card border-0 shadow-sm">
                        <div class="card-header bg-white border-bottom p-4">
                            <h2 class="h5 mb-1">Informations du rôle</h2>
                            <p class="text-muted mb-0">La modification met à jour la table <code>AspNetRoles</code>.</p>
                        </div>
                        <div class="card-body p-4">
                            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                            <div class="row g-3">
                                <div class="col-12">
                                    <label asp-for="Input.Name" class="form-label"></label>
                                    <input asp-for="Input.Name" class="form-control" autocomplete="off">
                                    <span asp-validation-for="Input.Name" class="text-danger"></span>
                                </div>

                                <div class="col-12 col-md-6">
                                    <label asp-for="Input.NormalizedName" class="form-label"></label>
                                    <input asp-for="Input.NormalizedName" class="form-control" disabled>
                                </div>

                                <div class="col-12 col-md-6">
                                    <label asp-for="Input.ConcurrencyStamp" class="form-label"></label>
                                    <input asp-for="Input.ConcurrencyStamp" class="form-control" disabled>
                                </div>
                            </div>
                        </div>
                        <div class="card-footer bg-white border-top p-4">
                            <div class="d-flex flex-wrap justify-content-end gap-2">
                                <a asp-page="/Admin/Roles" class="btn btn-outline-secondary">Annuler</a>
                                <button type="submit" class="btn btn-primary">Enregistrer</button>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-12 col-lg-4">
                    <div class="card border-0 shadow-sm backend-side-card">
                        <div class="card-header bg-white border-bottom p-4">
                            <h2 class="h5 mb-0">Droits et périmètres</h2>
                        </div>
                        <div class="card-body p-4">
                            <p class="text-muted mb-0">Les droits du rôle sont gérés dans Droits. Les périmètres sont gérés par utilisateur.</p>
                        </div>
                        <div class="card-footer bg-white border-top p-4">
                            <div class="d-grid gap-2">
                                <a asp-page="/Admin/Droits" class="btn btn-outline-secondary">Voir les droits</a>
                                <a asp-page="/Admin/Permissions" class="btn btn-outline-secondary">Gérer les périmètres</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </form>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
