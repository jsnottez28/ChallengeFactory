@page
@using Domain.Entities
@using Web.Services
@model Web.Pages.EspaceClient.IndexModel
@{
    ViewData["Title"] = "Mon espace client";
}

<section class="backend-page">
    <div class="container-fluid">
        @if (TempData["StatusMessage"] is string statusMessage && !string.IsNullOrWhiteSpace(statusMessage))
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @statusMessage
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fermer"></button>
            </div>
        }
        @if (TempData["ErreurDepotTableur"] is string erreurDepot && !string.IsNullOrWhiteSpace(erreurDepot))
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                @erreurDepot
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fermer"></button>
            </div>
        }

        <div class="mb-4">
            <p class="text-muted mb-1">Espace client Bilan Carbone®</p>
            <h1 class="h3 mb-0">@(Model.Dossier?.RaisonSociale ?? "Mon espace client")</h1>
        </div>

        @if (Model.Dossier is null)
        {
            <div class="card border-0 shadow-sm" style="max-width: 720px;">
                <div class="card-body p-4">
                    <p class="mb-0">Votre espace est en cours de préparation. Votre consultant vous enverra prochainement le questionnaire de préparation de votre Bilan Carbone®.</p>
                </div>
            </div>
        }
        else
        {
            <div class="card border-0 shadow-sm mb-4" style="max-width: 920px;">
                <div class="card-body p-4">
                    <h2 class="h6 mb-2">Comment ça marche, en 4 étapes</h2>
                    <ol class="mb-0 ps-3 small">
                        <li class="mb-1"><strong>Répondez au questionnaire</strong> (étape 1 ci-dessous) : il détermine précisément quelles données vous concernent.</li>
                        <li class="mb-1"><strong>Téléchargez votre tableur de collecte</strong> (étape 2) : un onglet par poste d'émission, avec un petit guide et un exemple sur chaque onglet.</li>
                        <li class="mb-1"><strong>Remplissez-le</strong> : pour chaque ligne de la check-list ci-dessous, récupérez la pièce justificative indiquée, reportez la valeur dans le tableur (colonnes Valeur/Source), passez son Statut à « Reçu », puis cochez-la ici pour suivre votre avancement.</li>
                        <li class="mb-0"><strong>Déposez le fichier mis à jour</strong> régulièrement (pas besoin d'avoir fini) : votre avancement estimé et votre consultant se mettent à jour automatiquement.</li>
                    </ol>
                </div>
            </div>

            <div class="row g-4">
                <div class="col-12 col-lg-4">
                    <div class="card border-0 shadow-sm h-100">
                        <div class="card-body p-4">
                            <p class="text-muted small mb-1">Étape 1</p>
                            <h2 class="h5">Questionnaire de préparation</h2>
                            @switch (Model.Dossier.StatutQuestionnaire)
                            {
                                case null:
                                    <p class="text-muted mb-0">Votre consultant vous l'enverra prochainement.</p>
                                    break;
                                case StatutQuestionnaireCollecte.Soumis:
                                    <p class="mb-0"><span class="badge bg-success">Envoyé le @Model.Dossier.QuestionnaireSoumisLe?.ToLocalTime().ToString("dd/MM/yyyy")</span></p>
                                    break;
                                default:
                                    <p class="mb-3">Une vingtaine de questions pour identifier les postes d'émissions qui vous concernent (5 à 10 minutes).</p>
                                    <a class="btn btn-primary" asp-page="/EspaceClient/Questionnaire">@(Model.Dossier.StatutQuestionnaire == StatutQuestionnaireCollecte.EnCours ? "Reprendre le questionnaire" : "Remplir le questionnaire")</a>
                                    break;
                            }
                        </div>
                    </div>
                </div>
                <div class="col-12 col-lg-4">
                    <div class="card border-0 shadow-sm h-100">
                        <div class="card-body p-4">
                            <p class="text-muted small mb-1">Étape 2</p>
                            <h2 class="h5">Collecte des données</h2>
                            <p class="mb-2">@(Model.Checklist.Count > 0 ? $"{Model.Checklist.Count} données à rassembler — voir la liste ci-dessous." : "La liste des documents à rassembler s'affichera ici après l'envoi du questionnaire.")</p>
                            @if (Model.Dossier.TableurDeposeAvancementPourcent is int avancement)
                            {
                                <div class="progress mb-1" style="height: 8px;" role="progressbar" aria-valuenow="@avancement" aria-valuemin="0" aria-valuemax="100">
                                    <div class="progress-bar bg-success" style="width: @(avancement)%;"></div>
                                </div>
                                <p class="text-muted small mb-2">
                                    Avancement estimé (d'après votre fichier) : <strong>@avancement %</strong>
                                    @if (Model.Dossier.TableurDeposeLe is DateTime deposeLe)
                                    {
                                        <text> (dernier dépôt le @deposeLe.ToLocalTime().ToString("dd/MM/yyyy"))</text>
                                    }
                                </p>
                            }
                            <a class="btn btn-outline-success btn-sm" asp-page="/EspaceClient/Index" asp-page-handler="Tableur">
                                ⬇️ @(Model.Dossier.TableurDeposeLe is not null ? "Reprendre mon tableur là où je l'ai laissé (.xlsx)" : "Télécharger mon tableur de collecte (.xlsx)")
                            </a>
                            @if (Model.Dossier.TableurDeposeLe is not null)
                            {
                                <p class="text-muted small mt-1 mb-0">Ce téléchargement reprend votre dernier fichier déposé, avec vos saisies déjà faites.</p>
                            }
                        </div>
                    </div>
                </div>
                <div class="col-12 col-lg-4">
                    <div class="card border-0 shadow-sm h-100">
                        <div class="card-body p-4">
                            <p class="text-muted small mb-1">Étape 3</p>
                            <h2 class="h5">Plan d'action de décarbonation</h2>
                            <p class="text-muted mb-0">Disponible après la réalisation de votre Bilan Carbone®.</p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card border-0 shadow-sm mt-4" style="max-width: 720px;">
                <div class="card-header bg-white border-bottom p-4">
                    <h2 class="h5 mb-1">Déposer mon tableur rempli</h2>
                    <p class="text-muted small mb-0">Une fois vos données saisies dans le tableur téléchargé ci-dessus, déposez-le ici pour mettre à jour votre avancement et le transmettre à votre consultant. Vous pouvez déposer plusieurs fois : seul le dernier fichier est conservé.</p>
                </div>
                <div class="card-body p-4">
                    <form method="post" asp-page-handler="DeposerTableur" enctype="multipart/form-data">
                        @Html.AntiForgeryToken()
                        <div class="mb-3">
                            <label for="fichier" class="form-label">Fichier (.xlsx)</label>
                            <input type="file" class="form-control" id="fichier" name="fichier" accept=".xlsx" required>
                        </div>
                        <div class="form-check mb-3">
                            <input type="checkbox" class="form-check-input" id="collecteTerminee" name="collecteTerminee" value="true">
                            <label class="form-check-label" for="collecteTerminee">J'ai terminé la collecte de toutes les données</label>
                        </div>
                        <button type="submit" class="btn btn-primary">Déposer ce fichier</button>
                    </form>
                </div>
            </div>

            @if (Model.Checklist.Count > 0)
            {
                <div class="card border-0 shadow-sm mt-4">
                    <div class="card-header bg-white border-bottom p-4">
                        <h2 class="h5 mb-1">Documents et données à rassembler — votre guide étape par étape</h2>
                        <p class="text-muted small mb-2">Pour chaque ligne : récupérez la pièce justificative indiquée auprès du référent mentionné, reportez la valeur dans le tableur téléchargé plus haut (colonnes Valeur, Unité, Source), puis cochez-la ici une fois faite. Les valeurs « Déjà connu » viennent de votre pré-diagnostic : il suffira de les confirmer dans le tableur.</p>
                        <details>
                            <summary class="small text-success" style="cursor: pointer;">📖 À quoi sert chaque colonne du tableur ?</summary>
                            <dl class="small mt-2 mb-0 row">
                                @foreach (var colonne in QuestionnaireCollecteCatalogue.ColonnesTableur)
                                {
                                    <dt class="col-sm-3 text-success">@colonne.Nom</dt>
                                    <dd class="col-sm-9">@colonne.Explication</dd>
                                }
                            </dl>
                        </details>
                    </div>
                    <div class="card-body p-4">
                        <form method="post" asp-page-handler="CocherElements">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-outline-success btn-sm mb-3">💾 Enregistrer mes cases cochées</button>
                            @foreach (var groupe in Model.Checklist.GroupBy(e => e.Poste))
                            {
                                var onglet = TableurCollecteGenerator.NomOnglet(groupe.Key);
                                <h3 class="h6 mt-3 text-success">@QuestionnaireCollecteCatalogue.LibellePoste(groupe.Key) <span class="badge bg-success-subtle text-success-emphasis fw-normal">Onglet « @onglet » du tableur</span></h3>
                                var note = QuestionnaireCollecteCatalogue.NotePedagogique(groupe.Key);
                                @if (!string.IsNullOrWhiteSpace(note))
                                {
                                    <p class="text-muted small fst-italic mb-2">💡 @note</p>
                                }
                                <ul class="list-unstyled mb-0">
                                    @{ var ligneExcel = 3; }
                                    @foreach (var element in groupe)
                                    {
                                        ligneExcel++;
                                        var idCase = $"coche-{element.Cle.GetHashCode()}";
                                        <li class="border-bottom py-2">
                                            <div class="d-flex flex-wrap justify-content-between gap-2 align-items-start">
                                                <div class="form-check">
                                                    <input type="checkbox" class="form-check-input" id="@idCase" name="elementsCoches" value="@element.Cle" checked="@element.EstCoche">
                                                    <label class="form-check-label @(element.EstCoche ? "text-decoration-line-through text-muted" : "")" for="@idCase">
                                                        @element.Donnee
                                                        @if (element.Valeur.HasValue)
                                                        {
                                                            <span class="badge bg-success-subtle text-success-emphasis ms-1">Déjà connu : @element.Valeur.Value.ToString("N2") @element.Unite</span>
                                                        }
                                                    </label>
                                                </div>
                                                <span class="text-muted small text-nowrap">📍 Onglet « @onglet », ligne @ligneExcel</span>
                                            </div>
                                            <div class="small text-muted ps-4">📄 @element.PieceJustificative · <span class="fst-italic">Référent : @element.Referent</span></div>
                                        </li>
                                    }
                                </ul>
                            }
                            <button type="submit" class="btn btn-outline-success mt-3">💾 Enregistrer mes cases cochées</button>
                        </form>
                    </div>
                </div>
            }
        }
    </div>
</section>
