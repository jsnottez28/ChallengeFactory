@page
@using Domain.Entities
@using Web.Services
@model Web.Pages.EspaceClient.IndexModel
@{
    ViewData["Title"] = "Mon espace client";
}

<section class="backend-page">
    <div class="container-fluid">
        @if (TempData["StatusMessage"] is string statusMessage && !string.IsNullOrWhiteSpace(statusMessage))
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @statusMessage
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fermer"></button>
            </div>
        }
        @if (TempData["ErreurDepotTableur"] is string erreurDepot && !string.IsNullOrWhiteSpace(erreurDepot))
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                @erreurDepot
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fermer"></button>
            </div>
        }

        <div class="mb-4">
            <p class="text-muted mb-1">Espace client Bilan Carbone®</p>
            <h1 class="h3 mb-0">@(Model.Dossier?.RaisonSociale ?? "Mon espace client")</h1>
        </div>

        @if (Model.Dossier is null)
        {
            <div class="card border-0 shadow-sm" style="max-width: 720px;">
                <div class="card-body p-4">
                    <p class="mb-0">Votre espace est en cours de préparation. Votre consultant vous enverra prochainement le questionnaire de préparation de votre Bilan Carbone®.</p>
                </div>
            </div>
        }
        else
        {
            <div class="card border-0 shadow-sm mb-4" style="max-width: 920px;">
                <div class="card-body p-4">
                    <h2 class="h6 mb-2">Comment ça marche, en 3 étapes</h2>
                    <ol class="mb-0 ps-3 small">
                        <li class="mb-1"><strong>Répondez au questionnaire</strong> (étape 1 ci-dessous) : il détermine précisément quelles données vous concernent.</li>
                        <li class="mb-1"><strong>Renseignez vos données</strong> (étape 2) directement en ligne, poste par poste : pour chaque ligne, récupérez la pièce justificative indiquée, saisissez la valeur et passez le statut à « Reçu ». Vous pouvez enregistrer à tout moment, revenir plus tard, et inviter un collègue à compléter certains postes.</li>
                        <li class="mb-0"><strong>Votre consultant suit votre avancement</strong> en continu : pas besoin d'avoir fini pour qu'il voie ce qui est déjà saisi.</li>
                    </ol>
                </div>
            </div>

            <div class="row g-4">
                <div class="col-12 col-lg-4">
                    <div class="card border-0 shadow-sm h-100">
                        <div class="card-body p-4">
                            <p class="text-muted small mb-1">Étape 1</p>
                            <h2 class="h5">Questionnaire de préparation</h2>
                            @switch (Model.Dossier.StatutQuestionnaire)
                            {
                                case null:
                                    <p class="text-muted mb-0">Votre consultant vous l'enverra prochainement.</p>
                                    break;
                                case StatutQuestionnaireCollecte.Soumis:
                                    <p class="mb-0"><span class="badge bg-success">Envoyé le @Model.Dossier.QuestionnaireSoumisLe?.ToLocalTime().ToString("dd/MM/yyyy")</span></p>
                                    break;
                                default:
                                    <p class="mb-3">Une vingtaine de questions pour identifier les postes d'émissions qui vous concernent (5 à 10 minutes).</p>
                                    <a class="btn btn-primary" asp-page="/EspaceClient/Questionnaire">@(Model.Dossier.StatutQuestionnaire == StatutQuestionnaireCollecte.EnCours ? "Reprendre le questionnaire" : "Remplir le questionnaire")</a>
                                    break;
                            }
                        </div>
                    </div>
                </div>
                <div class="col-12 col-lg-4">
                    <div class="card border-0 shadow-sm h-100">
                        <div class="card-body p-4">
                            <p class="text-muted small mb-1">Étape 2</p>
                            <h2 class="h5">Renseigner mes données</h2>
                            <p class="mb-2">@(Model.Checklist.Count > 0 ? $"{Model.Checklist.Count} données à renseigner." : "La liste s'affichera ici après l'envoi du questionnaire.")</p>
                            @if (Model.Dossier.TableurDeposeAvancementPourcent is int avancement)
                            {
                                <div class="progress mb-1" style="height: 8px;" role="progressbar" aria-valuenow="@avancement" aria-valuemin="0" aria-valuemax="100">
                                    <div class="progress-bar bg-success" style="width: @(avancement)%;"></div>
                                </div>
                                <p class="text-muted small mb-2">Avancement : <strong>@avancement %</strong></p>
                            }
                            @if (Model.Checklist.Count > 0)
                            {
                                <a class="btn btn-primary btn-sm" href="#formulaireCollecte">Renseigner mes données</a>
                            }
                        </div>
                    </div>
                </div>
                <div class="col-12 col-lg-4">
                    <div class="card border-0 shadow-sm h-100">
                        <div class="card-body p-4">
                            <p class="text-muted small mb-1">Étape 3</p>
                            <h2 class="h5">Plan d'action de décarbonation</h2>
                            <p class="text-muted mb-0">Disponible après la réalisation de votre Bilan Carbone®.</p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card border-0 shadow-sm mt-4" style="max-width: 720px;">
                <div class="card-header bg-white border-bottom p-4">
                    <h2 class="h5 mb-1">Collaborateurs</h2>
                    <p class="text-muted small mb-0">Invitez un ou plusieurs collègues (RH, facilities, comptabilité...) à renseigner eux-mêmes certaines données de ce dossier. Accès complet : chaque collaborateur voit et complète toute la liste, comme vous.</p>
                </div>
                <div class="card-body p-4">
                    @if (Model.Dossier.Collaborateurs.Count > 0)
                    {
                        <ul class="list-unstyled mb-3">
                            @foreach (var collaborateur in Model.Dossier.Collaborateurs)
                            {
                                <li class="d-flex justify-content-between align-items-center border-bottom py-2">
                                    <span>@(collaborateur.Prenom ?? collaborateur.Email) <span class="text-muted small">(@collaborateur.Email)</span></span>
                                    <form method="post" asp-page-handler="RetirerCollaborateur" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="utilisateurId" value="@collaborateur.UtilisateurId" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger">Retirer</button>
                                    </form>
                                </li>
                            }
                        </ul>
                    }
                    <form method="post" asp-page-handler="InviterCollaborateur" class="d-flex gap-2">
                        @Html.AntiForgeryToken()
                        <input type="email" name="email" class="form-control" placeholder="email@collegue.fr" required />
                        <button type="submit" class="btn btn-outline-primary text-nowrap">Inviter</button>
                    </form>
                </div>
            </div>

            @if (Model.Checklist.Count > 0)
            {
                <div class="card border-0 shadow-sm mt-4" id="formulaireCollecte">
                    <div class="card-header bg-white border-bottom p-4">
                        <h2 class="h5 mb-1">Mes données à renseigner</h2>
                        <p class="text-muted small mb-0">Pour chaque ligne : récupérez la pièce justificative indiquée auprès du référent mentionné, puis renseignez la valeur et son statut. Les valeurs « Déjà connu » viennent de votre pré-diagnostic.</p>
                    </div>
                    <div class="card-body p-4">
                        @{
                            var modeleFormulaire = new Web.Models.ChecklistCollecteFormulaireViewModel
                            {
                                Checklist = Model.Checklist,
                                LignesLibres = Model.Dossier.LignesLibres,
                                FormActionLigne = Url.Page("/EspaceClient/Index", "EnregistrerValeurs")!,
                                FormActionLigneLibre = Url.Page("/EspaceClient/Index", "EnregistrerLigneLibre")!,
                                FormActionSupprimerLigneLibre = Url.Page("/EspaceClient/Index", "SupprimerLigneLibre")!,
                            };
                        }
                        <partial name="_ChecklistCollecteFormulaire" model="modeleFormulaire" />
                    </div>
                </div>
            }

            <details class="mt-4">
                <summary class="text-muted" style="cursor: pointer;">📊 Mode avancé : utiliser le tableur Excel à la place</summary>
                <div class="card border-0 shadow-sm mt-3" style="max-width: 720px;">
                    <div class="card-header bg-white border-bottom p-4">
                        <h2 class="h5 mb-1">Télécharger / déposer le tableur</h2>
                        <p class="text-muted small mb-0">Un onglet par poste d'émission. Vos saisies dans le formulaire ci-dessus sont déjà dans le tableur téléchargé ; à l'inverse, un tableur déposé ici met à jour le formulaire. Les deux restent synchronisés.</p>
                    </div>
                    <div class="card-body p-4">
                        <a class="btn btn-outline-success btn-sm mb-3" asp-page="/EspaceClient/Index" asp-page-handler="Tableur">
                            ⬇️ @(Model.Dossier.TableurDeposeLe is not null ? "Reprendre mon tableur là où je l'ai laissé (.xlsx)" : "Télécharger mon tableur de collecte (.xlsx)")
                        </a>
                        <form method="post" asp-page-handler="DeposerTableur" enctype="multipart/form-data">
                            @Html.AntiForgeryToken()
                            <div class="mb-3">
                                <label for="fichier" class="form-label">Déposer le fichier rempli (.xlsx)</label>
                                <input type="file" class="form-control" id="fichier" name="fichier" accept=".xlsx" required>
                            </div>
                            <div class="form-check mb-3">
                                <input type="checkbox" class="form-check-input" id="collecteTerminee" name="collecteTerminee" value="true">
                                <label class="form-check-label" for="collecteTerminee">J'ai terminé la collecte de toutes les données</label>
                            </div>
                            <button type="submit" class="btn btn-primary">Déposer ce fichier</button>
                        </form>
                    </div>
                </div>
            </details>
        }
    </div>
</section>
